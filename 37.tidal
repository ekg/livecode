-- polyriddim · toms + stabs fight the grid
-- modulation notes:
--   * d12 is a steady 7-pulse over 16: the contour comes from the note ladder
--     "0 0 2 2 4 7 12" — transpose the whole line with e.g. |+ note (-5)
--   * gain "0.7 0.4 ..." accents the first of every 7 — move the 0.7 to shift it;
--     keep 7 values so the accent stays in phase with the pulse
--   * stabs: juno is bright; # lpf 1200 warms it
--   * to open the whole mix up: raise d4's lpf from 1800 toward 3000 slowly

d12 $ swingBy (1/12) 2 $ struct "t(7,16)" $ s "808lt 808mt 808ht 808mt" # note "0 0 2 2 4 7 12" # gain "0.7 0.4 0.4 0.4 0.4 0.5 0.4" # room 0.3 # cut 12

d13 $ swingBy (1/12) 2 $ struct "t(5,16)" $ s "juno" # note "<c4 g3 e4 a3>" # gain 0.5 # lpf 1200 # delay 0.5 # delaytime (3/8) # delayfeedback 0.65 # pan 0.7 # cut 13

-- foundation chords breathe open every 16 cycles (lpf 1300 -> 2600 -> back)
d4 $ let dCh = note "d2 f3 a3 c4 e4" in cat [s "superpiano" # dCh, s "superpiano" # note "g2 b2 d3 f3", s "superpiano" # note "c2 e3 g3 b3 d4", s "superpiano" # note "a1 c3 e3 g3"] # gain 0.5 # lpf (slow 16 $ range 1300 2600 saw) # room 0.55 # size 0.9 # delay 0.3 # delaytime (1/3) # delayfeedback 0.6 # cut 4

-- d12 silence
-- d13 silence
