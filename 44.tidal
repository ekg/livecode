-- jungle piano house · 122bpm · deep clean rebuild of 41-43
-- the brief: lush jazzy chords, smooth clear bass, ONE parseable melody,
-- a jungle break under the house floor. no flying pianos.
-- layers:
--   HOUSE   d1 4/4 kick, d4 offbeat 808oh, d5 clap 2&4
--   FUNK    d2 snare + d3 hats — the human velocity curve, dry
--   JUNGLE  d11 chopped breaks165 (hpf 150 keeps the low end for the kick+sub)
--   BASS    d6 moog, ONE hit per bar, long, lpf 500 — smooth sub, not growly
--   JAZZ    d7 lush voicings — Dmaj9 / G9 / Am9 / Dmaj9 (7ths+9ths, no plain triads)
--           d8 one hoover stab per cycle, long delay tail
--   LINE    d10 Affirmation head bars 1-4, octave down, half rate — the rising
--           A-B-C#-D-E-F# line, unhurried
-- what was REMOVED from 41-43: the cpluck harmonium ostinato (the flying piano),
-- the rev-ing hoover chaos, the 16th-note offbeat moog growl.
-- modulation notes:
--   * d11 is the jungle engine: chop 16 slices the break across the cycle.
--     sometimesBy 0.15 rev = reverse edits; every 3 stut = rolls. raise gain for jungle.
--   * d7 voicings: each note string is one chord; add a 13th (e.g. 69) for more color
--   * d6: legato-length hits — change the roots with the chords (D G A D -> d1 g1 a1 d1)
--   * space: chords room 0.75/size 0.95 + delay (5/8) 0.7; melody room 0.7; drums DRY
do
  hush
  setcps (122/60/8)
  d1 $ s "bd*8" # gain 0.85 # lpf 900
  d2 $ s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ sn sn sn sn sn ~ ~ ~ ~ sn ~ ~ sn ~ sn ~ sn sn ~ ~ sn" # gain "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 0.34 0.36 0.61 0.57 0.56 ~ ~ ~ ~ 0.59 ~ ~ 0.57 ~ 0.47 ~ 0.40 0.60 ~ ~ 0.60"
  d3 $ s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ hh ~ ~ hh hh hh hh hh hh hh hh hh hh hh hh hh hh hh" # gain "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 0.66 ~ ~ 0.44 0.61 0.42 0.53 0.52 0.56 0.63 0.55 0.53 0.55 0.50 0.55 0.51 0.61 0.64" # hpf 1200
  d4 $ s "~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~" # gain 0.55 # hpf 400
  d5 $ sometimesBy 0.3 (# speed 1.5) $ s "~ ~ ~ ~ cp ~ ~ ~ ~ ~ ~ ~ cp ~ ~ ~ ~ ~ ~ ~ cp ~ ~ ~ ~ ~ ~ ~ cp ~ ~ ~" # gain 0.7
  d6 $ s "moog" # note "d1 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ g1 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~" # gain 0.8 # lpf 500 # room 0.1 # cut 6
  d7 $ fast 2 $ cat [s "superpiano" # note "50 54 57 61 64", s "superpiano" # note "43 47 50 54 57", s "superpiano" # note "45 48 52 55 59", s "superpiano" # note "50 54 57 61 64"] # gain 0.5 # lpf 1600 # room 0.75 # size 0.95 # delay 0.4 # delaytime (5/8) # delayfeedback 0.7 # cut 7
  d8 $ s "~ ~ hoover ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~" # note "d2" # gain 0.4 # lpf 1600 # room 0.6 # size 0.9 # delay 0.5 # delaytime (1/2) # delayfeedback 0.7 # cut 8
  d10 $ swingBy (1/12) 2 $ slow 8 $ n "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 45 47 49 50 52 52 54 ~ 54 ~ 52 57 ~ 57 ~ 59 ~ 54 55 ~ ~ 52 54 ~ 54 ~ 52 57 ~ 57 59 55 57 54 55 52 54 52 ~ ~ 52 52 ~ 50 ~ 50 ~ ~ ~ ~ 42 45 47" # s "superpiano" # gain 0.55 # lpf 2000 # room 0.7 # size 0.95 # delay 0.35 # delaytime (1/4) # delayfeedback 0.45 # cut 10
  d11 $ every 3 (stut 4 0.6 (1/16)) $ sometimesBy 0.15 rev $ loopAt 2 $ chop 16 $ s "breaks165" # gain 0.6 # hpf 150
  -- d1 silence
  -- d2 silence
  -- d3 silence
  -- d4 silence
  -- d5 silence
  -- d6 silence
  -- d7 silence
  -- d8 silence
  -- d10 silence
  -- d11 silence
