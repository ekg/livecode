-- lo-fi hip-hop · dusty swing groove, Dm7-G7-Cmaj7-Am7
do
  hush
  setcps (74/60/4)
  let dCh = note "d2 f3 a3 c4 e4"
      gCh = note "g2 b2 d3 f3"
      cCh = note "c2 e3 g3 b3 d4"
      aCh = note "a1 c3 e3 g3"
  d1 $ swingBy (1/12) 2 $ s "bd ~ ~ bd*2 ~ ~ bd ~"
  d2 $ swingBy (1/12) 2 $ s "~ ~ sn ~ ~ ~ sn ~" # gain 0.85
  d3 $ swingBy (1/10) 2 $ degradeBy 0.15 $ s "hat*8" # gain "[0.7 0.45]*4"
  d4 $ swingBy (1/12) 2 $ cat [s "superpiano" # note "d2 ~ ~ f3 [a3 c4] ~ ~ e4 ~ ~ ~ ~ [g4 a4] ~ ~ ~", s "superpiano" # note "g2 ~ ~ b2 [d3 f3] ~ ~ b3 ~ ~ ~ ~ [d4 f4] ~ ~ ~", s "superpiano" # note "c2 ~ ~ e3 [g3 b3] ~ ~ d4 ~ ~ ~ ~ [g4 b4] ~ ~ ~", s "superpiano" # note "a1 ~ ~ c3 [e3 g3] ~ ~ b3 ~ ~ ~ ~ [e4 g4] ~ ~ ~"] |+ note (slow 8 $ range 0 0.045 sine) # gain 0.55 # lpf 1800 # room 0.5 # size 0.9 # delay 0.3 # delaytime (1/3) # delayfeedback 0.6 # cut 4
  d5 $ cat [s "superpiano" # note "d1 ~ d1 ~ ~ c1 g0 ~", s "superpiano" # note "g0 ~ ~ g0 ~ f0 ~ d0", s "superpiano" # note "c1 ~ ~ g0 ~ e0 ~ ~", s "superpiano" # note "a0 ~ a0 ~ ~ g0 e0 ~"] # gain 0.85 # lpf 260 # room 0.2 # cut 5
  d6 $ s "cr*6" # gain 0.07 # hpf 4000 # pan 0.6
  d7 $ swingBy (1/12) 2 $ cat [s "superpiano" # note "e5 . ~ . a5 ~ e5 . ~ . ~ . d5 a4 . .", s "superpiano" # note "d5 . ~ . g5 ~ f5 . ~ . ~ . d5 ~ . .", s "superpiano" # note "e5 . ~ . g5 ~ c5 . ~ . ~ . e4 ~ . .", s "superpiano" # note "c5 . ~ . e5 ~ g4 . ~ . a4 . c5 ~ . ."] # gain 0.4 # lpf 2200 # room 0.6 # delay 0.35 # delaytime (1/3) # delayfeedback 0.5 # cut 7
  d8 $ swingBy (1/12) 2 $ cat [s "cpluck" # note "a5 . d6 ~ c6 . a5 . ~ . f5 . a5 ~ . .", s "cpluck" # note "b5 . g5 ~ d6 . b5 . ~ . g5 . d6 ~ . .", s "cpluck" # note "g5 . e6 ~ d6 . c6 . ~ . g5 . e5 ~ . .", s "cpluck" # note "a5 . e6 ~ c6 . a5 . ~ . g5 . a5 ~ . ."] # gain 0.55 # lpf 3200 # room 0.5 # size 0.8 # delay 0.25 # delaytime (1/6) # delayfeedback 0.5 # cut 8
  -- d1 silence
  -- d2 silence
  -- d3 silence
  -- d4 silence
  -- d5 silence
  -- d6 silence
  -- d7 silence
  -- d8 silence
