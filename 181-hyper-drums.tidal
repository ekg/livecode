-- 181 — HYPER DRUMS. 160 BPM, drums only: no bass, no chords, no melody. A completely separate
-- track from 179/180 — its own tempo, its own file, nothing shared but the sample library.
--
-- STOCK TIDAL: orbits -> hardware through the minimal master (hpf -> gain -> soft knee ->
-- limiter); orbit FX are SuperCollider's own dirt_delay -> dirt_reverb -> dirt_monitor, so every
-- FX here is a Tidal orbit param. ~masterVol.value(n) is the volume.
--
-- THE IDEA: hyper means two things at once — FAST, and POLYRHYTHMIC TO THE POINT OF FRENZY. So
-- every lane takes a different prime figure off the 16th grid (4, 5, 7, 9, 11, 12, 13, 15) and
-- the break loops each keep a DIFFERENT rotating slice order, so the same bar is never the same
-- bar twice. Then the hyper devices go on top: fast 2 / fast 4 draws, chop, striate, stutWith
-- flurries, and crush/shape/blast as occasional draws rather than as textures.
--
-- RATE: `loopAt 1` on every break (one bar of audio per bar of track = its true rate); `loopAt 2`
-- would halve them and dilute the metre, which is exactly wrong at this tempo. `speed` matches a
-- break to 160 BPM where it was recorded slower (108.5/160 = 0.68, 115/160 = 0.72).
--
-- TRAPS (learned the hard way today, both still live in this material):
--   * multi-parameter transforms must be compositions of SINGLE-# sections
--     (`let blast = (# room 0.92) . (# size 1) . (# dry 0.08)`) — `(# a # b)` cannot parse and a
--     transform that fails to parse does NOTHING, silently.
--   * transforms go BEFORE the `#` parameter chain, never inside it: `degradeBy 0.1 $ ... # gain x`
--     is right, `# degradeBy 0.1` is a type error.
setcps (160/60/4)

let blast = (# room 0.92) . (# size 1) . (# dry 0.08)
let wash = (# room 0.95) . (# size 1) . (# dry 0.06)
let dubThrow = (# delay 0.65) . (# delayfeedback 0.72) . (# delaytime (3/16)) . (# lock 1)
let hyper = (# crush 12) . (# shape 0.4) . (# hpf 400)
-- NB: a mini-notation string used as a NUMBER needs the annotation, or the type is ambiguous and
-- the file does not compile (this tripped the validator when the file was written):
let dmxSlots = "<0 1 2 4 5 12 14 20>" :: Pattern Note
let tomSlots = "<6 7 8 7 8 6 8>" :: Pattern Note

-- KICK: an eight-bar cycle of different prime figures, doubling sometimes, crushed rarely.
d1 $ sometimesBy 0.3 (fast 2) $ sometimesBy 0.15 hyper $ struct "<t(4,4) t(4,4) t(7,16,3) t(4,4) t(9,16,5) t(4,4) t(5,8) t(13,16,7)>" $ s "rolandtr909:0" # gain (slow 8 $ range 0.6 0.72 sine) # velocity (slow 7 $ range 0.7 1 perlin) # shape 0.3 # hpf 55 # lpf 4200 # release 0.08

-- SNARE/CLAP: three machines on three grids at once — 8ths, 16ths and a 12-grid (3:4).
d2 $ sometimesBy 0.3 (stutWith 3 0.03125 (|* gain 0.6)) $ stack [struct "t(3,8,2)" $ s "rolandtr909:4" # gain 0.3, struct "t(5,16,4)" $ s "linn9000:4" # gain 0.2 # pan 0.42, struct "t(5,12,3)" $ s "casiorz1:4" # gain 0.18 # pan 0.6] # hpf 420 # lpf 7500 # release 0.05 # room 0.3 # dry 0.8

-- HATS: a 13-grid at this tempo is a swarm; fast 4 draws make it break up.
d3 $ degradeBy 0.08 $ sometimesBy 0.35 (fast 2) $ sometimesBy 0.25 (fast 4) $ sometimesBy 0.2 hyper $ struct "t(13,16,3)" $ s "emusp12:2" # gain (slow 5 $ range 0.14 0.22 sine) # hpf 6500 # lpf 13000 # pan (slow 9 $ range 0.36 0.64 sine) # release 0.02

-- SHAKER: a %16 cell, so 16 hits against 16 slots land differently every bar.
d4 $ degradeBy 0.15 $ sometimesBy 0.3 (fast 2) $ s "{sh808}%16" # gain (slow 6 $ range 0.1 0.17 sine) # hpf 6000 # lpf 13000 # pan perlin # release 0.02 # dry 0.9

-- AMEN: slice 16, a long rotating order, striated on a third of the passes, doubled sometimes.
d5 $ sometimesBy 0.3 (striate 4) $ sometimesBy 0.25 (fast 2) $ sometimesBy 0.15 (chop 8) $ slice 16 "<0 4 9 2 13 6 11 1 8 14 3 10 5 15 7 12>" $ loopAt 1 $ s "amencutup" # gain 0.5 # hpf 80 # lpf 10000 # pan 0.48 # release 0.04 # room 0.18 # dry 0.8

-- FUNKY 6 A: recorded at 108.5, matched to 160 with speed 0.68, chunk-reversed.
d6 $ sometimesBy 0.3 (chunk 8 rev) $ sometimesBy 0.3 (fast 2) $ slice 8 "<0 3 6 1 5 2 7 4>" $ loopAt 1 $ s "p94brkA" # speed 0.68 # gain 0.5 # hpf 90 # lpf 10500 # pan 0.54 # release 0.04 # room 0.2 # dry 0.8

-- FUNKY 3 A: recorded at 115, matched with speed 0.72, sliced on a 12.
d7 $ sometimesBy 0.25 (striate 2) $ sometimesBy 0.25 (fast 2) $ slice 12 "<0 5 9 2 7 11 3 8 1 10 4 6>" $ loopAt 1 $ s "p94brkB" # speed 0.72 # gain 0.48 # hpf 90 # lpf 10500 # pan 0.46 # release 0.04 # room 0.2 # dry 0.8

-- 300 BREAKS: slice 16 with a different rotating order again, chunk-reversed.
d8 $ sometimesBy 0.3 (chunk 6 rev) $ sometimesBy 0.3 (fast 2) $ slice 16 "<0 8 3 12 5 15 1 10 6 14 2 11 7 13 4 9>" $ loopAt 1 $ s "p93drumB" # speed 0.75 # gain 0.46 # hpf 110 # lpf 10000 # pan 0.52 # release 0.04 # room 0.2 # dry 0.8

-- THE MASHUP: amen and Funky 6 interleaved STEP BY STEP, so one bar is two recordings cut together.
d9 $ sometimesBy 0.3 (striate 2) $ sometimesBy 0.2 (fast 2) $ slice 8 "<0 2 5 7 1 4 6 3>" $ s "{amencutup p94brkA}%16" # speed 0.75 # gain 0.48 # hpf 100 # lpf 11000 # pan perlin # release 0.03 # dry 0.85

-- JUNGLE one-shots on a %12 cell: the hand percussion of the machine age.
d10 $ degradeBy 0.1 $ sometimesBy 0.3 (fast 2) $ sometimesBy 0.25 (stutWith 3 0.015625 (|* gain 0.6)) $ s "{jungle}%12" # gain (slow 7 $ range 0.3 0.42 sine) # hpf 300 # lpf 12000 # pan perlin # release 0.03 # dry 0.85

-- DMX MACHINE KIT: its own slots in one stable order (cj's the point — the loop is in the breaks).
d11 $ sometimesBy 0.25 (fast 2) $ sometimesBy 0.2 (fast 4) $ struct "t(11,16,4)" $ s "oberheimdmx" # n dmxSlots # gain (slow 8 $ range 0.3 0.4 sine) # hpf 120 # lpf 9500 # pan 0.5 # release 0.05 # room 0.2 # dry 0.85

-- TOMS: three machines' tom slots (6/7/8 per ~/drummachines/MAP.md), pitched by speed ratios.
d12 $ sometimesBy 0.3 (stutWith 2 0.0625 (|* gain 0.6)) $ every 5 (rotR (1/16)) $ struct "t(7,16,5)" $ s "<casiorz1 bossdr220 korgddm110>" # n tomSlots # speed "<1 1.19 1.5 1.12 0.89 1.33 0.75>" # gain (slow 9 $ range 0.26 0.36 sine) # hpf 200 # lpf 6500 # pan (slow 13 $ range 0.35 0.65 sine) # release 0.1 # room 0.2 # dry 0.8

-- THE DOOR: a 13-grid roll that only speaks in the 8th bar of every 8, with a reverb blast.
d13 $ mask "<f f f f f f f t>" $ sometimesBy 0.4 (stutWith 4 0.015625 (|* gain 0.6)) $ sometimesBy 0.3 blast $ s "[ebongos|jamblock|t808H](13,16,5)" # gain 0.4 # hpf 600 # lpf 10000 # pan perlin # release 0.04 # room 0.4 # dry 0.6
