-- 154: F MINOR — THE GRUNGED TWIN OF 153 (switchable).
-- @scene {"title":"F MINOR — THE GRUNGED TWIN OF 153 (switchable)","cps":0.6,"quantize":4}
-- Quantize 4: align four-bar harmonic / density cell; no transport IO.
-- Chosen section: actual single executable checkpoint, not historical header aspirations.
-- Inert m* dropped; silence lanes omitted. Notes/rhythm/gain and existing sends preserved.
-- Orbit-global competing writers removed; all lanes repeat their owner values identically.
-- Orbit 0: d1,d2,d3,d7,d12; kick/drum sidechain detector; dry sends; global owner d1.
-- Orbit 1: d4,d10; bass/sub (dry except approved 145 tail); global owner d4.
-- Orbit 2: d5,d13; keys/stabs/vibes: dub delay; global owner d5.
-- Orbit 3: d6,d11; lead/wet snare/strings: reverb; global owner d6.
-- Orbit 4: d8,d9,d14; percussion/texture: tape; global owner d8.
-- Orbit 5: unused; send accents: isolated delay; reset clock.
let swing = (# nudge (fast 8 $ "0 1" * (slow 16 $ range 0 0.05 sine)))
let crush = pF "crush"
let coarse = pF "coarse"
let grunge = (# crush (slow 8 $ range 3 14 saw)) . (# coarse (slow 4 $ range 2 9 sine)) . (sometimesBy 0.35 (# shape (range 0.25 0.7 sine)))
let moist = (sometimesBy 0.5 (# crush (slow 16 $ range 8 14 sine))) . (# shape (slow 8 $ range 0 0.3 sine))
d1 $ grunge $ swing $ euclid "<4 4 4 5>" 8 $ s "k808S" # gain 0.78 # shape 0.5 # hpf 55 # lpf 7000 # release 0.08 # verbSend 0 # ddSend 0 # orbit 0 # delayfeedback 0
d2 $ grunge $ swing $ s "c808(2,4,1)" # gain 0.6 # hpf 320 # lpf 9000 # release 0.09 # verbSend 0 # ddSend 0 # orbit 0 # delayfeedback 0
d3 $ moist $ swing $ s "h808O(4,8,1)" # gain (slow 4 $ range 0.28 0.48 sine) # hpf 1800 # lpf 11000 # pan 0.58 # verbSend 0 # ddSend 0 # orbit 0 # delayfeedback 0
d4 $ moist $ swing $ struct "t(5,16,1)" $ note "<f2 f2 ab2 c3 eb3 c3 ab2 f2>" # s "dubsynth" # waveMix 0.18 # cutoff 420 # fenv 2.2 # drive 0.35 # sustain 0.16 # release 0.14 # lpf 1800 # gain 0.46 # verbSend 0 # ddSend 0 # orbit 1 # delayfeedback 0
d5 $ swing $ slow 4 $ note "<[f3,ab3,c4] [db3,f3,ab3] [eb3,g3,bb3] [c3,eb3,g3]>" # s "hoRhodes" # gain 0.52 # cutoff 3000 # attack 0.06 # release 2.0 # lpf (range 1100 3000 $ slow 16 sine) # verbSend 0.25 # room 0.55 # ddSend 0 # orbit 2 # size 0.6 # delayfeedback 0.25 # delaytime 0.1875 # lock 1
d6 $ swing $ euclidOff 7 16 3 $ note "<ab4 c5 eb5 f5 eb5 c5 ab4 f4>" # s "mars_synths_DX100_Sine" # n 0 # gain 0.44 # hpf 400 # lpf 6000 # verbSend 0.25 # room 0.5 # ddSend 0.25 # orbit 3 # size 0.55 # lock 1 # delaytime (3/16) # delayfeedback 0.3
d7 $ grunge $ swing $ ply 2 $ s "<h808C(15,16) h808C(11,16,3) h808P(13,16)>" # gain "<0.26 0.2>" # hpf 2200 # lpf 9500 # pan 0.6 # verbSend 0 # ddSend 0 # orbit 0 # delayfeedback 0
d8 $ grunge $ swing $ s "sh808(7,16,3)" # gain 0.26 # hpf 3000 # lpf 12000 # pan 0.42 # verbSend 0 # ddSend 0 # orbit 4 # tape 0.16 # tapeWow 0.12 # tapeHiss 0 # delayfeedback 0
d9 $ grunge $ swing $ s "cb808(5,16,2)" # gain 0.2 # hpf 700 # lpf 9000 # pan 0.34 # release 0.2 # verbSend 0 # ddSend 0 # orbit 4 # tape 0.16 # tapeWow 0.12 # tapeHiss 0 # delayfeedback 0
d10 $ swing $ s "dubsub(4,8,1)" # note (slow 4 $ "<f1 db1 ab1 eb1>") # drive 0.6 # pitchEnv 0.5 # legato 1.6 # sustain 0.28 # release 0.25 # amp 0.85 # gain 0.46 # hpf 26 # lpf 210 # verbSend 0 # ddSend 0 # orbit 1 # delayfeedback 0
d11 $ moist $ swing $ euclidOff 5 16 2 $ note "<f4 ab4 c5 eb5 c5 ab4 f4 c5>" # s "cp4" # gain 0.46 # hpf 300 # lpf 5000 # pan 0.55 # verbSend 0.2 # room 0.45 # ddSend 0.15 # orbit 3 # size 0.55 # lock 1 # delaytime (3/16) # delayfeedback 0.3
d12 $ grunge $ swing $ iter 4 $ s "t808M(5,16,3)" # gain 0.36 # hpf 120 # lpf 4500 # pan 0.45 # release 0.25 # verbSend 0 # ddSend 0 # orbit 0 # delayfeedback 0
d13 $ moist $ swing $ every 4 (# gain 0) $ note "<[f3,ab3,c4] ~ [db3,f3,ab3] ~ [eb3,g3,bb3] ~>" # s "sweetChords" # gain 0.38 # lpf 3200 # release 0.2 # verbSend 0.2 # room 0.5 # ddSend 0.1 # orbit 2 # size 0.6 # delayfeedback 0.25 # delaytime 0.1875 # lock 1
d14 $ grunge $ swing $ weave 8 (s "sh808(7,16,3)" # gain 0.2) [s "t808H(5,16,2)" # gain 0.24, s "cn808(3,16,1)" # gain 0.26] # pan (slow 8 $ range 0.2 0.8 sine) # hpf 900 # lpf 11000 # verbSend 0 # ddSend 0 # orbit 4 # tape 0.16 # tapeWow 0.12 # tapeHiss 0 # delayfeedback 0
