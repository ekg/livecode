-- title: 191 f minor drive
-- F minor, 132 BPM. Faster and harder than 190.
-- breaks165 pitched down (recorded at 165, played at 132 = speed 0.8 -> fatter)
-- mars 626 kit, one hook, driving bass. gain only (no amp - amp is growly).

setcps (132/240)
-- MIXING STANDARD: master 5

-- BREAK: breaks165, chopped. speed 0.8 = 132/165, so it sits in tempo and drops pitch.
d1 $ degradeBy 0.05 $ swingBy 0.05 4 $ sometimesBy 0.15 (fast 1.5) $ slice 16 "<0 4 9 2 13 6 11 1 8 14 3 10 5 15 7 12>" $ loopAt 1 $ s "<breaks165:0 breaks165:1 breaks165:2>" # speed 0.8 # orbit 0 # gain 1.1 # hpf 40 # lpf 15000 # dry 0.92 # room 0.1

-- SECOND BREAK: amencutup, half speed, chunk-reversed.
d2 $ degradeBy 0.08 $ every 5 (chunk 8 rev) $ slice 8 "<0 3 6 1 5 2 7 4>" $ loopAt 2 $ s "amencutup" # speed 0.7 # orbit 0 # gain 0.6 # hpf 50 # lpf 12000 # pan 0.58 # dry 0.92 # room 0.1

-- KICK: four on the floor. The anchor.
d4 $ swingBy 0.09 4 $ s "<mars_kits_626_Clean_1:1(4,16,0) mars_kits_626_Clean_1:1(5,16,2) mars_kits_626_Clean_1:1(3,16,1) mars_kits_626_Clean_1:1(7,16,3)>" # orbit 7 # gain "<1.2 1.2 1.2 1.2 1.2 1.2 1.2 1.2 1.2 1.2 1.2 1.2 1.2 0.1 1.3 1.2>" # crush "<16 16 16 16 16 16 16 16 16 16 16 16 14 8 6 16>" # hpf 35 # lpf 7000 # dry 1

-- HATS: cloud - 7 and 11 in 16, plus a fast 13.
d5 $ degradeBy 0.06 $ swingBy 0.1 4 $ sometimesBy 0.2 (stutWith 3 0.03125 (|* speed 0.9)) $ every 5 (rotR (1/8)) $ every 3 (fast 2) $ stack [s "hh(7,16,2)" # gain 0.72, s "mars_kits_626_Clean_1:3(11,16,3)" # gain 0.42] # orbit 7 # hpf 4000 # lpf 14000 # pan (slow 13 $ range 0.2 0.8 sine) # dry 0.95 # room 0.1

d9 $ degradeBy 0.1 $ swingBy 0.05 4 $ s "hh(13,16,5)" # orbit 7 # gain 0.3 # hpf 7000 # lpf 13000 # pan (slow 11 $ range 0.3 0.7 sine) # crush (slow 23 $ range 16 12 saw) # dry 0.95

-- CLAP: backbeat, cycling samples so it never settles.
d6 $ degradeBy 0.1 $ swingBy 0.11 4 $ sometimesBy 0.2 (ply 2) $ sometimesBy 0.12 (|* speed (-1)) $ s "<rolandtr909:4 mars_kits_626_Clean_1:4 rolandtr909:5 realclaps>" # orbit 7 # gain 0.95 # hpf 350 # lpf 7500 # pan (slow 13 $ range 0.3 0.7 sine) # dry 0.95 # release 0.12

-- BASS: driving, gain only, no fenv (fenv = the growl).
d7 $ sometimesBy 0.15 (|+ note 12) $ sometimesBy 0.1 (|* gain 0.5) $ note "<f1 ~ f2 ~ c2 ~ f2 ~> <db2 ~ db2 ~ ab1 ~ db2 ~> <ab1 ~ ab2 ~ eb2 ~ ab2 ~> <c2 ~ c2 ~ g1 ~ c2 ~>" # s "dubsub" # orbit 1 # gain 1.1 # drive 0.0 # waveMix 0.0 # subMix 0.3 # cutoff 700 # fenv 0.0 # hpf 40 # dry 0.95

-- CHORDS: Fm / Db / Ab / Cm.
d8 $ slow 2 $ note "<[f3,ab3,c4,eb4] [db3,f3,ab3,c4] [ab3,c4,eb4,g4] [c3,eb3,g3,bb3]>" # s "hoRhodes" # orbit 2 # gain 1.0 # attack 0.4 # release 2.0 # sustain 0.6 # cutoff 6000 # hpf 100 # room 0.5 # size 0.9 # dry 0.7

-- HOOK: one shape per chord, memorable, sits above the chords.
d13 $ slow 2 $ degradeBy 0.06 $ sometimesBy 0.15 (ply 2) $ sometimesBy 0.2 (iter 3) $ sometimesBy 0.12 (|+ note 12) $ every 5 (striate 2) $ every 7 (rev) $ euclidOff 11 16 3 $ note (arp "<updown up down updown>" (slow 2 "<[f3,ab3,c4,eb4,f4] [db3,f3,ab3,c4,eb4] [ab2,c3,eb3,g3,c4] [c3,eb3,g3,bb3,d4]>")) # s "blip" # orbit 3 # gain 0.8 # hpf 400 # lpf 9000 # attack 0.005 # release 0.22 # sustain 0.35 # pan (slow 13 $ range 0.35 0.65 sine) # room 0.55 # size 0.9 # dry 0.65 # delay 0.25 # delaytime (3/16) # delayfeedback 0.4 # lock 1

-- PERC: machine hits, odd grid, evolving.
d10 $ degradeBy 0.15 $ every 5 (rotR (1/8)) $ s "<korgddm110:2 emusp12:2 linndrum:3>" # orbit 6 # gain 0.35 # hpf 1200 # lpf 9000 # pan (slow 15 $ range 0.25 0.75 sine) # dry 0.92 # room 0.15

-- BIG PAD: superhammond, 5-note voicings, slow attack, glued over everything.
d14 $ slow 8 $ sometimesBy 0.1 (|+ note 12) $ note "<[f3,ab3,c4,eb4,f4] [db3,f3,ab3,c4,eb4] [ab2,c3,eb3,g3,c4] [c3,eb3,g3,bb3,d4]>" # s "superhammond" # orbit 2 # gain 1.0 # attack 1.4 # release 6 # sustain 0.85 # cutoff (slow 21 $ rangex 1200 2600 saw) # hpf 100 # lpf 6000 # pan (slow 17 $ range 0.42 0.58 sine) # room 0.85 # size 0.96 # dry 0.28

-- TECH HOUSE LAYER -------------------------------------------------------
-- steady kick, offbeat open hat, rolling sub bass, sliced 300-breaks loop.
d15 $ s "rolandtr909:0(4,16,0)" # orbit 8 # gain 1.15 # hpf 40 # lpf 6000 # release 0.09 # dry 1

d16 $ s "ho(4,8,2)" # orbit 8 # gain 0.42 # hpf 5000 # lpf 13000 # release 0.05 # dry 0.95 # room 0.1

d17 $ sometimesBy 0.15 (|+ note 12) $ note "<f1 f1 f1 f2 f1 f1 c2 f1> <db1 db1 db1 db2 db1 db1 ab1 db1> <ab1 ab1 ab1 ab2 ab1 ab1 eb2 ab1> <c2 c2 c2 c3 c2 c2 g1 c2>" # s "dubsub" # orbit 8 # gain 0.9 # drive 0.0 # waveMix 0.0 # subMix 0.3 # cutoff 900 # fenv 0.0 # sustain 0.3 # release 0.09 # legato 0.85 # hpf 45 # dry 0.95

-- THE BREAK, SLICED: 16 addresses into 4 different loops. The permutation picks
-- which slice plays when; the gain pattern gives each hit its own weight; rotR and
-- reversals keep it from settling. This is the "loop as playable instrument".
d18 $ sometimesBy 0.2 (|* speed (-1)) $ every 5 (striate 4) $ slice 16 "<0 4 9 2 13 6 11 1 8 14 3 10 5 15 7 12>" $ loopAt 1 $ s "<pbrk300:9 pbrk300:10 pbrk300:11 pbrk300:12>" # speed 0.94 # orbit 9 # gain "<0.5 0.32 0.46 0.28 0.52 0.3 0.44 0.26>" # hpf 100 # lpf 9000 # pan (slow 11 $ range 0.4 0.6 sine) # dry 0.9 # room 0.12

-- VOICE: voxdl = 55 dancehall vocal shouts (rewind/champion/shout/brrr), from
-- ~/samples/te-ep-paks-4-strudel/ep-40-riddim-sounds/VOX_FX, symlinked as a bank.
-- Two drops per 8 cycles, random sample each time.
d12 $ mask "<f f f t>" $ every 4 (rotR (1/8)) $ n "<0 ~ 5 2 ~ 11 ~ 7 14 ~ 3 ~ 9 ~ 12 5>" # s "voxdl" # orbit 12 # gain 0.8 # hpf 250 # lpf 9000 # pan (slow 19 $ range 0.3 0.7 sine) # room 0.45 # size 0.9 # delay 0.3 # delaytime (3/16) # delayfeedback 0.4 # lock 1 # dry 0.6

-- second voice stream, offset a 32nd, so bursts are layered not doubled
d9 $ mask "<f f f t>" $ off 0.0625 (every 3 (rotR 0.25)) $ n "<5 ~ 11 ~ 2 ~ 9 2> <12 ~ 3 ~ 7 ~ 0 5>" # s "voxdl" # orbit 12 # gain 0.55 # hpf 400 # lpf 7000 # pan (slow 23 $ range 0.55 0.35 sine) # room 0.55 # size 0.92 # delay 0.35 # delaytime (3/16) # delayfeedback 0.45 # lock 1 # dry 0.55
