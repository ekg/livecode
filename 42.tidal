-- weird house v2 · 122bpm · same ensemble, now driven by an 8-BAR melodic line
-- (41.tidal had a 2-bar ostinato; this is the long arc: Music for a Found Harmonium,
--  bars 1-8, which evolves 66/67 -> 64/61 -> 72/65 -> 60/62 before resolving)
-- structure:
--   cycle = 2 bars (setcps 122/60/8 = 0.254)
--   drums loop every cycle: 4-on-floor kick, funk snare+hats (human velocity), offbeat
--     808oh, clap 2&4 — all DRY (verb lives on melodic content only)
--   the line is `slow 4`, so 8 bars of melody unfold over 4 cycles while the kit loops
--   chords are a 4-bar D-G-A-D loop, so the line's second half is reharmonised
-- modulation notes:
--   * slow 4 is the whole trick: the melody's phrase length vs the loop length. slow 8
--     spreads it over 8 cycles (32 bars of music = very slow arc), slow 2 tightens it.
--   * gain the line up (0.6 -> 0.8) when it should lead; drop to 0.45 to make it haze
--   * d1 bd*8 = four kicks per bar. bd*4 is half-time and reads as ~60bpm.
--   * swaps: d9 melody source is tunepile: tools/midi_to_tidal.py <abc> --bars 8
do
  hush
  setcps (122/60/8)
  d1 $ s "bd*8" # gain 0.85 # lpf 900
  d2 $ s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ sn sn sn sn sn ~ ~ ~ ~ sn ~ ~ sn ~ sn ~ sn sn ~ ~ sn" # gain "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 0.34 0.36 0.61 0.57 0.56 ~ ~ ~ ~ 0.59 ~ ~ 0.57 ~ 0.47 ~ 0.40 0.60 ~ ~ 0.60"
  d3 $ s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ hh ~ ~ hh hh hh hh hh hh hh hh hh hh hh hh hh hh hh" # gain "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 0.66 ~ ~ 0.44 0.61 0.42 0.53 0.52 0.56 0.63 0.55 0.53 0.55 0.50 0.55 0.51 0.61 0.64" # hpf 1200
  d4 $ s "~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~" # gain 0.55 # hpf 400
  d5 $ sometimesBy 0.3 (# speed 1.5) $ s "~ ~ ~ ~ cp ~ ~ ~ ~ ~ ~ ~ cp ~ ~ ~ ~ ~ ~ ~ cp ~ ~ ~ ~ ~ ~ ~ cp ~ ~ ~" # gain 0.7
  d6 $ s "moog" # note "~ ~ d1 ~ ~ ~ d1 ~ ~ ~ d1 ~ ~ ~ d1 ~ ~ ~ g0 ~ ~ ~ g0 ~ ~ ~ g0 ~ ~ ~ g0 ~" # gain 0.85 # lpf 260 # room 0.2 # cut 6
  d7 $ fast 2 $ cat [s "superpiano" # note "38 50 54 57 61 64", s "superpiano" # note "43 55 59 62 66 69", s "superpiano" # note "45 57 61 64 67 71", s "superpiano" # note "38 50 54 57 61 64"] # gain 0.55 # lpf 1400 # room 0.6 # size 0.9 # cut 7
  d8 $ sometimesBy 0.4 rev $ struct "t(3,16)" $ s "hoover" # note "<d3 a2>" # gain 0.45 # lpf 1800 # room 0.6 # size 0.85 # delay 0.45 # delaytime (1/3) # delayfeedback 0.6 # cut 8
  d9 $ slow 4 $ n "66 ~ 62 ~ 67 ~ 62 ~ 66 ~ 62 ~ 62 ~ 62 ~ 66 ~ 62 ~ 67 ~ 62 ~ 66 ~ 62 ~ 62 ~ 62 ~ 66 ~ 62 ~ 67 ~ 62 ~ 66 ~ 62 ~ 62 ~ 62 ~ 64 ~ 62 ~ 61 ~ 62 ~ 66 ~ 62 ~ 62 ~ 62 ~ 64 ~ 62 ~ 61 ~ 62 ~ 64 ~ 62 ~ 61 ~ 62 ~ 66 ~ 62 ~ 60 ~ 62 ~ 66 ~ 62 ~ 60 ~ 62 ~ 67 ~ 62 ~ 64 ~ 62 ~ 61 ~ 62 ~ 67 ~ 62 ~ 66 ~ 62 ~ 62 ~ 62 ~ 62 ~ ~ ~ ~ ~ ~ ~" # s "cpluck" # gain 0.6 # room 0.6 # size 0.85 # delay 0.35 # delaytime (1/4) # delayfeedback 0.45 # cut 9
  -- d1 silence
  -- d2 silence
  -- d3 silence
  -- d4 silence
  -- d5 silence
  -- d6 silence
  -- d7 silence
  -- d8 silence
  -- d9 silence
