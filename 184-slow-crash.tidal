-- 184 — SLOW CRASH. 84 BPM, A minor. Stock Tidal end to end (orbit delay/room/size/dry only;
-- no custom stack in the path). Levels: ~masterVol.value(n).
--
-- A/B/C MIX FORM — three melodies, three four-bar windows, on one 12-bar cycle, with the drums
-- and loops running underneath all of it:
--     A  bars 1-4   Blue Monday bass riff, an octave down on dubsynth
--     B  bars 5-8   Blue Monday guitar on supermandolin, an octave up, crunchy
--     C  bars 9-12  the "da Day Dawn" air on hoRhodes, singing with vibrato
-- So the form breathes THROUGH its melodies instead of layering them; "mixing through" is moving
-- between windows, not juggling levels. (A fourth melody was here and is gone: It's My Life's hook
-- is off the map deliberately — see the KEY note.)
--
-- PATTERN: the A section's notes come from the source (0 0 0 7 | 0 0 3 7 style interval writing on
-- the guitar), the C section from ABC. All of it is in A NATURAL MINOR and nothing implies another
-- collection.
--
-- KEY — this is the reason a fourth melody was deleted. A guitar-pro transcription is NOT reliably
-- in one key: the It's My Life file fits F minor at only ~78%, because it contains d3, g3 and b4
-- (D/G/B natural) as it moves between minor and major. Transposing those +4 lands them on F# and
-- D#, and F# against A minor's F natural is an audible clash — "emphatically not quite in key".
-- The safe sources for consonant material are the ABC airs and the corpus chord progressions,
-- which are single-collection by construction; for guitar-pro material, check the OUTLIERS before
-- choosing a transposition, not just the best-fit scale.
--
-- THE BREAKS are the 300-breaks pack (~/samples/300 breaks, 202 files / ~101 tracks), aliased at
-- runtime as pbrk01..pbrk08 — they are not a SuperDirt bank, they were loaded by name. They are
-- FULL TRACKS (19-50 s), which makes the loop rate a different question from one-bar loops:
--     loopAt 1 on a full track = 30 s into 2.9 s = a subsonic smear (inaudible, not "quiet")
--     loopAt 4 = roughly a third-speed drag — the rate that was chosen here
--     chop n re-times too, because slices are forced to fill their slots: bigger n = faster
-- So: chop/striate for one-bar material, loopAt for long material, and expect a long loop to
-- pitch down. Both lanes are SEWN (`{pbrk01 pbrk02 pbrk03 pbrk04}%16`) so four tracks alternate
-- inside each stretched loop, and both are DRY — reverb on chopped breaks lays each slice's tail
-- over the next one, which is what makes chopped material mushy instead of punchy.
--
-- CRUNCH on the lead is Tidal-style MODULATION, not a fixed setting: shape sweeping on slow 13,
-- crush sweeping 4-12 on slow 17, vowel formants on a draw, res on slow 11 and detune on slow 19,
-- plus chop 4 and stutWith draws. The line stays recognisable between deformations because every
-- one of those is a `sometimesBy`, not a state.
setcps (84/240)

d1 $ mask "<t t t t f f f f f f f f>" $ slow 4 $ sometimesBy 0.2 (fast 2) $ (|+ note (-12)) $ note "f3 ~ f4 f4 f3 ~ f4 f4 c3 ~ c4 c4 c3 ~ c4 c4 d3 ~ d4 d4 d3 ~ d4 d4 d3 ~ d4 d4 d3 ~ d4 d4 g3 ~ g4 g4 g3 ~ g4 g4 c3 ~ c4 c4 c3 ~ c4 c4 d3 ~ d4 d4 d3 ~ d4 d4 d3 ~ d4 d4 d3 ~ d4 d4" # s "dubsynth" # gain (slow 11 $ range 0.5 0.62 sine) # amp 0.8 # waveMix 0.16 # subMix 0.4 # cutoff (slow 13 $ rangex 380 900 saw) # fenv 1.8 # drive (slow 15 $ range 0.15 0.4 saw) # sustain 0.3 # release 0.4 # legato 1.2 # hpf 34 # dry 1

d2 $ mask "<f f f f t t t t f f f f>" $ slow 4 $ sometimesBy 0.3 (chop 4) $ sometimesBy 0.3 (# shape (slow 13 $ range 0.15 0.5 saw)) $ sometimesBy 0.25 (# crush (slow 17 $ range 4 12 saw)) $ sometimesBy 0.2 (# vowel "<a e o u>") $ sometimesBy 0.2 (stutWith 3 0.0625 (|* gain 0.6)) $ (|+ note 12) $ note "f4 ~ f4 ~ f4 ~ g4 ~ c4 ~ c4 ~ c4 ~ d4 ~ d4 ~ ~ ~ d4 ~ d4 ~ ~ ~ d4 ~ d4 ~ ~ ~ f4 ~ f4 ~ f4 ~ g4 ~ c4 ~ c4 ~ c4 ~ d4 ~ d4 ~ ~ ~ d4 ~ d4 ~ ~ ~ d4 ~ d4 ~ ~ ~" # s "supermandolin" # gain (slow 7 $ range 0.4 0.5 sine) # hpf 600 # lpf (slow 17 $ rangex 2000 6500 saw) # res (slow 11 $ range 0.2 0.7 saw) # detune (slow 19 $ range 0.005 0.03 saw) # release 0.35 # sustain 0.15 # pan (slow 9 $ range 0.38 0.62 sine) # room 0.5 # size 0.8 # dry 0.5 # delay 0.4 # delaytime (3/16) # delayfeedback 0.5 # lock 1

d3 $ mask "<f f f f f f f f t t t t>" $ slow 4 $ degradeBy 0.08 $ sometimesBy 0.2 (|+ note 12) $ sometimesBy 0.15 (off 0.125 (|+ note 7)) $ sometimesBy 0.15 (# crush 6) $ note "b4 c5 b4 c5 b4 a4 a4 g4 d5 a4 d5 b4 e5 a4 d5 b4 c5 d5 b4 ~ a4 ~ d4 e4 b4 a4 d5 c5 e5 ~ a4 ~ e5 ~ b4 ~ a4 ~ e5 ~ e5 ~ a4 ~ e5 ~ b4 a4 a4 ~ d4 e4 b4 a4 d5 c5 e5 ~" # s "hoRhodes" # gain (slow 9 $ range 0.36 0.48 sine) # amp 0.5 # cutoff (slow 21 $ rangex 1000 3800 saw) # waveMix 0.16 # attack 0.05 # sustain 0.45 # release 1.4 # legato 1.3 # vib 0.12 # vibRate 5.2 # hpf 300 # pan (slow 7 $ range 0.42 0.58 sine) # room 0.75 # size 0.95 # dry 0.35 # delay 0.4 # delaytime (3/8) # delayfeedback 0.52 # lock 1

-- half-time floor: kick on 1 and 3, snare on 3, sparse shaker. Slow music needs a slow pulse.
d5 $ struct "t f t f" $ s "superkick" # gain 0.66 # shape (slow 11 $ range 0.2 0.4 saw) # release 0.5 # hpf 48

d6 $ struct "~ ~ t ~" $ s "sossnare" # gain 0.42 # hpf 300 # lpf 7000 # release 0.3 # room 0.4 # size 0.7 # dry 0.7

d7 $ sometimesBy 0.2 (fast 2) $ every 5 (rotR (1/16)) $ struct "t(6,16,3)" $ s "superhat" # gain (slow 9 $ range 0.12 0.2 sine) # res (slow 7 $ range 0.3 0.7 saw) # lpf (slow 5 $ rangex 5000 12000 saw) # release 0.06 # pan 0.6 # dry 0.9

-- THE BREAKS — 300-breaks, sewn four-at-a-time, loopAt 4 (a deliberate drag), dry.
d8 $ sometimesBy 0.2 (striate 4) $ loopAt 4 $ s "{pbrk01 pbrk02 pbrk03 pbrk04}%16" # gain (slow 7 $ range 0.62 0.74 sine) # hpf 60 # lpf (slow 11 $ rangex 1600 6000 saw) # pan 0.5 # release 0.08 # room 0 # dry 1

d9 $ sometimesBy 0.2 (chunk 4 rev) $ loopAt 4 $ s "{pbrk05 pbrk06 pbrk07 pbrk08}%16" # gain (slow 9 $ range 0.5 0.6 sine) # hpf 70 # lpf 5500 # pan 0.55 # release 0.08 # room 0 # dry 1
