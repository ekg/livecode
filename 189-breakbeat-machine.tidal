-- title: 189 breakbeat machine
-- E minor, 108 BPM. Amapiano-inflected: everything shares ONE 16th grid, and the
-- layers divide it up rather than each running its own cycle. That is what makes
-- it a groove instead of random hits.
--
-- Roles on the grid (x = hit):
--   shaker     xxxxxxxxxxxxxxxx    continuous - the pulse everything is heard against
--   log drum   x..x..x.x..x.xx.    the engine, pitchEnv glide, drive
--   skank      .x.x.x.x.x.x.x.x    fills exactly the log drum's gaps
--   kick       x...x...x...x...    sparse skeleton (alternates to a 5-in-16)
--   perc       x.x..x..x.x..x..    fixed interlock, NOT a free euclid
--   melody     euclidOff 11/16/3  phrasing from the grid, sampled note sequence
--
-- LEVELS: audible percussion/melody lives at 0.35-0.8 here. The 0.10-0.16 gains in
-- 175-180 were for 16-lane mixes; copying them into 10 lanes made a wall of quiet.

setcps (108/240)

-- THE SPINE: breaks125 sliced, gain-patterned, reversed in 4-chunk blocks on 25% of
-- cycles, striate 4 every 4th, stutter fill every 16th. lpf 9000 + room 0.06 to keep
-- the slices CLEAR rather than washy; the gain pattern is what gives it grain.
d1 $ sometimesBy 0.25 (chunk 4 (|* speed (-1))) $ every 4 (striate 4) $ whenmod 16 14 (stutWith "<2 3 4 5>" "<0.0625 0.03125 0.015625>" (|* gain 0.7)) $ slice 16 "<0 4 9 2 13 6 11 1 8 14 3 10 5 15 7 12>" $ loopAt 1 $ s "breaks125" # speed 0.864 # orbit 0 # gain "<0.62 0.62 0.62 0.62 0.62 0.62 0.62 0.62 0.62 0.62 0.62 0.62 0.62 0.05 0.72 0.62>" # crush "<16 16 16 16 16 16 16 16 16 16 16 16 14 10 7 4>" # hpf 120 # lpf 9000 # pan 0.5 # dry 0.92 # room 0.06

-- SECOND BREAK: amencutup half speed, masked in over 4 bars.
d2 $ mask "<t t f f t t f f>" $ every 5 (chunk 8 rev) $ slice 8 "<0 3 6 1 5 2 7 4>" $ loopAt 2 $ s "amencutup" # speed 0.76 # orbit 0 # gain 0.28 # hpf 120 # lpf 6000 # pan 0.58 # dry 0.9 # room 0.12

-- TOM in the KICK's slot: t808Lo with the same modulation (4/4 vs 5-in-16, ply, drift)
-- but hpf 120 / lpf 5000 / shape 0.12 - the tom range is gentler than a k808S kick.
-- nudge drifting 0-18ms on a 7-cycle cycle (micro-timing = feel).
d3 $ sometimesBy 0.2 (ply "<2 3 5 4>") $ whenmod 8 6 (sometimesBy 0.5 (ply "<3 2 5 4 6>")) $ s "<t808Lo(4,16,0) t808Lo(5,16,3)>" # orbit 7 # gain "<0.85 0.85 0.85 0.85 0.85 0.85 0.85 0.85 0.85 0.85 0.85 0.85 0.85 0.06 0.95 0.85>" # crush "<16 16 16 16 16 16 16 16 16 16 16 16 14 10 7 4>" # shape 0.12 # hpf 90 # lpf 5000 # pan (slow 9 $ range 0.44 0.56 sine) # release 0.12 # dry 1 # nudge (slow 7 $ range 0.0 0.018 sine)

-- HATS: 11-in-16, dry.
d4 $ sometimesBy 0.25 (# delay 0.9) $ sometimesBy 0.1 (stutWith 3 0.03125 (|* gain 0.6)) $ s "hh(11,16,2)" # orbit 8 # gain 0.5 # hpf 6500 # lpf 12500 # pan (slow 9 $ range 0.35 0.65 sine) # dry 0.75 # room 0.45 # size 0.9 # delay 0.35 # delaytime (3/16) # delayfeedback 0.55 # lock 1 # nudge 0.014

-- WALKING BASS, Amapiano placement: downbeat only on the chord change (bar 1), then
-- offbeat 8ths - the kick carries the one, the bass answers it. nudge 0.02 = a hair
-- behind. SINEY: waveMix 0 is the pure sub oscillator, drive 0 (no grit), cutoff 300 with
-- fenv 1.2 for a soft filter bloom, pitchEnv 0.15 for a hint of glide.
d5 $ euclidOff 13 16 5 $ note "<e2 e2 g2 e2 b1 e2 d2 e2>" # s "dubsub" # orbit 1 # gain 0.4 # amp 0.6 # drive 0.0 # pitchEnv 0.0 # waveMix 0.0 # subMix 0.3 # cutoff 300 # fenv 0.0 # legato 1.0 # sustain 0.4 # release 0.18 # hpf 55 # dry 0.95

-- OFFBEAT CHORD SKANK: every second 16th - occupies the log drum's gaps exactly.
d6 $ sometimesBy 0.12 (|* gain 0.3) $ every 11 (fast 2) $ sometimesBy 0.1 (|+ note 12) $ struct "t(8,16,1)" $ note "<[e4,g4,b4] [e4,g4,b4] [d4,fs4,a4] [d4,fs4,a4]>" # s "hoRhodes" # orbit 3 # gain "<0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.04 0.62 0.5>" # crush "<16 16 16 16 16 16 16 16 16 16 16 16 14 10 7 4>" # amp 0.5 # hpf 400 # lpf 5000 # attack 0.005 # release 0.18 # sustain 0.2 # pan (slow 11 $ range 0.46 0.54 sine) # room 0.5 # size 0.9 # dry 0.7

-- SHARED STRUTS: d5 bass is masked <t t t f f t t t>, d12 melody <f f f t t f f f>,
-- d6 skank <t t t t t t t f>. Same 8-cycle phrase, complementary slots, so the bass
-- leaves and the melody fills the hole. That is the coherency, not shared notes.

-- CHORDS: Em / C / G / D held over 2 bars.
d7 $ slow 2 $ sometimesBy 0.1 (|* gain 0.6) $ every 13 (fast 2) $ sometimesBy 0.08 (|+ note (choose [0,0,7])) $ sometimesBy 0.06 (off 0.125 (|* gain 0.6)) $ note "<[e3,g3,b3,d4] [c3,e3,g3,b3] [g3,b3,d4,fs4] [d3,fs3,a3,c4]>" # s "sweetChords" # orbit 2 # gain 0.5 # amp 0.4 # attack 0.3 # release 2.2 # sustain 0.65 # cutoff 3000 # fmIndex 0.4 # sub 0.2 # width 0.7 # room 0.55 # size 0.9 # dry 0.58

-- THE MELODY: euclidOff 11/16/3 - the same mechanism as the bass, so the line
-- flows instead of going bing-bing-bing. The note sequence is sampled at the grid's
-- points, which is where the phrasing comes from.
d12 $ slow 2 $ sometimesBy 0.1 (|+ note 12) $ sometimesBy 0.15 (off 0.125 (|* gain 0.45)) $ note "<[b4 ~ e5 ~ g5 ~ fs5 e5 d5 ~ b4 ~ ~ ~] [c5 ~ e5 ~ g5 a5 ~ g5 e5 ~ d5 ~ ~ ~] [g4 ~ b4 ~ d5 ~ e5 d5 b4 ~ g4 ~ ~ ~] [fs4 ~ a4 ~ d5 ~ e5 ~ d5 fs5 ~ a5 ~ ~ ~]>" # s "hoRhodes" # orbit 3 # gain "<0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.7 0.6>" # amp 0.55 # hpf 350 # lpf 4500 # cutoff 3800 # attack 0.02 # release 0.7 # sustain "<0.45 0.45 0.45 0.45 0.45 0.45 0.45 0.45 0.45 0.45 0.45 0.45 0.45 0.45 0.1 0.45>" # pan (slow 11 $ range 0.44 0.56 sine) # room "<0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.9 0.6>" # size 0.9 # delay 0.3 # delaytime (3/16) # delayfeedback 0.5 # lock 1

-- SHAKER: continuous 16ths - the glue.
d9 $ sometimesBy 0.08 (fast 2) $ s "sh808(16,16)" # orbit 6 # gain 0.5 # hpf 6000 # lpf 12000 # pan 0.55 # dry 0.95 # room 0.1

-- INTERLOCKING PERCUSSION: 3-in-16 / 4-in-16 alternating, in the same grid.
d10 $ struct "<t(3,16,2) t(4,16,2)>" $ s "<jamblock guira>" # orbit 6 # gain 0.6 # hpf 1500 # lpf 9000 # pan (slow 15 $ range 0.32 0.68 sine) # dry 0.9 # room 0.2

-- TEXTURE loop, way back.
d8 $ sometimesBy 0.3 (# crush 12) $ every 7 (chunk 4 rev) $ slice 8 "<0 3 5 1 6 2 7 4>" $ loopAt 2 $ s "lpmr" # speed 1 # orbit 4 # gain 0.2 # hpf 300 # lpf 9000 # pan 0.6 # dry 0.85 # room 0.2

-- 300 BREAKS: ~/samples/'300 breaks' symlinked as the sample folder pbrk300
-- (SuperDirt names samples by FOLDER; the pbrk01-08 aliases never existed as banks). This is
-- the dynamic layer - chop 8 every 5 cycles tears it open, backwards slices make
-- the entry unpredictable.
d13 $ sometimesBy 0.3 (chunk 8 (|* speed (-1))) $ sometimesBy 0.15 (striate 8) $ every 5 (chop 16) $ slice 16 "<0 4 9 2 13 6 11 1 8 14 3 10 5 15 7 12>" $ loopAt 1 $ s "<pbrk300:0 pbrk300:1 pbrk300:2 pbrk300:3>" # speed "<0.95 1 1.05 1>" # orbit 0 # gain "<0.45 0.3 0.5 0.35>" # hpf 120 # lpf 9000 # pan 0.42 # dry 0.92 # room 0.06
