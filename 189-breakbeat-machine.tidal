-- title: 189 breakbeat machine
-- C minor at 125 BPM. The breaks are the piece: breaks125 at natural speed
-- (speed 1, no pitch smear), amencutup underneath, a texture loop for air.
-- ONE melodic hook - the same rising triad shape on each chord - so there is
-- something to remember. Chords are clean hoRhodes (no fmIndex, no drive).
-- Only two synth voices total: dubsub for bass, superpiano for the hook.

setcps (125/240)

-- THE SPINE: breaks125 sliced into 16, permutation scrambled, striate every 4th
-- cycle, occasional backwards slices. speed 1 = the breaks play at the tempo they
-- were recorded at, which is why this sounds like records rather than smeared.
d1 $ sometimesBy 0.15 (|* speed (-1)) $ every 4 (striate 4) $ slice 16 "<0 4 9 2 13 6 11 1 8 14 3 10 5 15 7 12>" $ loopAt 1 $ s "breaks125" # speed 1 # orbit 0 # gain 0.5 # hpf 90 # lpf 7000 # pan 0.5 # dry 0.85 # room 0.15

-- SECOND BREAK: amencutup at half speed, in and out over 4 bars, reversed every 5th.
d2 $ mask "<t t f f t t f f>" $ every 5 (chunk 8 rev) $ slice 8 "<0 3 6 1 5 2 7 4>" $ loopAt 2 $ s "amencutup" # speed 0.88 # orbit 0 # gain (slow 11 $ range 0.16 0.24 sine) # hpf 120 # lpf 6000 # pan 0.58 # dry 0.9 # room 0.12

-- KIT: 4-on-floor kick and backbeat clap, dry, tight, a hair late.
d3 $ s "[bd(4,16,0), cp(2,16,2)]" # orbit 7 # gain 0.6 # hpf 55 # lpf 6500 # dry 1 # nudge 0.01

-- HATS: 11-in-16 with a slow level LFO.
d4 $ s "hh(11,16,2)" # orbit 7 # gain (slow 6 $ range 0.18 0.28 sine) # hpf 6500 # lpf 12500 # pan (slow 9 $ range 0.42 0.6 sine) # dry 1 # nudge 0.012

-- BASS: dubsub, driving 13-in-16, octave jumps, no drive pile-up.
d5 $ sometimesBy 0.2 (|+ note 12) $ euclidOff 13 16 5 $ note "<c2 c2 eb2 c2 g1 c2 bb1 c2>" # s "dubsub" # orbit 1 # gain (slow 7 $ range 0.52 0.62 sine) # amp 0.8 # drive 0.15 # pitchEnv 0.12 # legato 1.0 # sustain 0.3 # release 0.15 # hpf 45 # dry 0.95

-- THE HOOK: one shape, four chords, rising triad in the same positions. This is
-- the thing to remember - it repeats, it transposes with the harmony, and it
-- never gains a second counter-melody.
d6 $ sometimesBy 0.12 (|+ note 12) $ note "<[c5 eb5 g5 eb5] [bb4 d5 g5 d5] [ab4 c5 eb5 c5] [g4 bb4 d5 bb4]>" # s "superpiano" # orbit 3 # gain (slow 9 $ range 0.34 0.44 sine) # hpf 400 # lpf 7000 # attack 0.005 # release 0.3 # sustain 0.3 # pan (slow 11 $ range 0.45 0.55 sine) # room 0.5 # size 0.9 # dry 0.7 # delay 0.2 # delaytime (3/16) # lock 1

-- CHORDS: clean hoRhodes, no fm/drive - the granular blowy synth is gone.
d7 $ slow 2 $ note "<[c3,eb3,g3,bb3] [ab2,c3,eb3,g3] [eb3,g3,bb3,d4] [bb2,d3,f3,ab3]>" # s "hoRhodes" # orbit 2 # gain (slow 13 $ range 0.3 0.38 sine) # amp 0.4 # attack 0.3 # release 2.0 # sustain 0.6 # cutoff 3200 # room 0.7 # size 0.9 # dry 0.4

-- TEXTURE: a loop, crushed occasionally, way back in the mix.
d8 $ sometimesBy 0.3 (# crush 12) $ every 7 (chunk 4 rev) $ slice 8 "<0 3 5 1 6 2 7 4>" $ loopAt 2 $ s "lpmr" # speed 1 # orbit 4 # gain (slow 17 $ range 0.1 0.16 sine) # hpf 300 # lpf 9000 # pan 0.6 # dry 0.85 # room 0.2
