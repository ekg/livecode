-- deep house jam · 125 bpm · orbits d1-d7
setcps (125/60/4)

-- four on the floor
d1 $ s "bd*4" # gain 1.1

-- offbeat open hats
d2 $ s "~ oh ~ oh ~ oh ~ oh" # gain 0.85 # room 0.2

-- clap on 2 & 4
d3 $ s "~ clak ~ clak" # gain 0.9 # shape 0.3

-- rolling offbeat bass
d4 $ s "~ bass1 ~ bass1 ~ bass1 ~ bass1" # n "0 0 7 3" # legato 1 # gain 0.9 # cut 1

-- lush chord progression: Am9 → Fmaj9 → Cmaj9 → G9, one chord per bar
-- take 2: slow sine gain ramp (32 cycles up, 32 down) + filter opening with it
-- (take 1 alternative: d5 $ n "<a3'min9 f3'maj9 c4'maj9 g3'9>" # s "superpiano" # gain 0.55 # room 0.7 # sz 0.8 # lpf 1500)
d5 $ n "<a3'min9 f3'maj9 c4'maj9 g3'9>" # s "superpiano" # gain (slow 32 $ range 0.55 0.95 $ sine) # room 0.7 # sz 0.8 # lpf (slow 32 $ range 1200 2800 $ sine)

-- hats keep the 16ths ticking
d6 $ s "hh27*8" # n (irand 13) # gain "0.35 0.5"

-- arpeggiated chord shimmer, same progression an octave up
-- take 2: 40-cycle ramp, phase-shifted half period, so it swells while d5 dips
-- (take 1 alternative: d7 $ arp "up" $ s "superpiano" # n "<a4'min9 f4'maj9 c5'maj9 g4'9>" # gain 0.45 # room 0.4 # lpf 2500)
d7 $ arp "up" $ s "superpiano" # n "<a4'min9 f4'maj9 c5'maj9 g4'9>" # gain (slow 40 $ range 0.35 0.8 $ sine) # room 0.4 # lpf (slow 40 $ range 1800 3200 $ sine)
