-- 132: NIGHT WINDOW — lofi deep house / combinatorial DJ mix. 118 BPM.
-- Sources (all SC boot aliases): p80a/p80b Dmaj + p80c Amaj one-bar LPViz
-- synth loops, p70perc & p85drumA percussion loops, humanip vxA/B/D vocal
-- fragments, 808/p70 kit, dubsub, sweetChords. No web sample needed.
-- 3/5/7/11/13-bar gain masks on independent DJ decks; 3*5*7*11*13 =
-- 15015 bars before all mask phases coincide. The transformations have
-- other coprime periods; the kick/clap remains stable as a dance anchor.
-- Vocal is chopped into vowels/feelings, not understandable words.
-- Mix recall: after SC boot, execute sc/house132-master.scd in sclang.
-- The scene itself does not send m* params (that bridge is inert); the SC
-- preset supplies fixed makeup + gentle compression + limiter ceiling.
setcps (118/240)

d1 $ s "k808S*4" # gain "0.8 0.73 0.76 0.74" # hpf 32 # lpf 5800 # pan 0.5 # ddSend 0 # verbSend 0.025

d2 $ s "~ c808 ~ c808" # gain "0.43 0.51" # hpf 650 # lpf 8900 # pan 0.53 # ddSend "0 0.13 0 0" # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.22 # verbSend 0.06

d3 $ s "~ h808C ~ h808C ~ h808C ~ h808C" # gain "0.22 0.17 0.2 0.16" # hpf 2600 # lpf 10500 # pan 0.6 # ddSend 0 # verbSend 0.03

d4 $ every 9 (iter 3) $ s "sh808(7,16)" # gain (perlin * 0.09 + 0.12) # hpf 1900 # lpf 7800 # pan (perlin * 0.3 + 0.38) # ddSend 0 # verbSend 0.04

d5 $ n "<[fs2 ~ ~ cs2 ~ fs2 e2 ~] [d2 ~ ~ a1 ~ d2 cs2 ~] [a1 ~ ~ e2 ~ a1 gs1 ~] [e2 ~ ~ b1 ~ e2 cs2 ~]>" # s "dubsub" # amp 0.38 # drive 0.18 # pitchEnv 0.12 # gain 0.48 # hpf 32 # lpf 2700 # pan 0.5 # ddSend 0 # verbSend 0.03

d6 $ every 11 (rev) $ loopAt 1 $ s "p80a" # gain "<0.3 0.24 0>" # hpf 220 # lpf (slow 17 $ range 2600 6200 sine) # pan 0.36 # cut 6 # ddSend 0.05 # verbSend 0.1

d7 $ every 7 (rev) $ slice 4 "<0 1 2 3> <0 2 1 3>" $ loopAt 1 $ s "p80b" # gain "<0 0.18 0.21 0.14 0.18>" # hpf 510 # lpf (slow 19 $ range 3000 7900 sine) # pan 0.7 # cut 7 # ddSend "0 0 0.18 0" # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.24 # verbSend 0.1

d8 $ every 13 (rev) $ slice 8 "<0 2 4 6 1 3 5 7> <7 5 3 1 6 4 2 0>" $ loopAt 1 $ s "p80c" # gain "<0 0 0.17 0.2 0.16 0.19 0.11>" # hpf 400 # lpf 5400 # pan 0.46 # cut 8 # ddSend 0.04 # verbSend 0.12

d9 $ n "<[fs3,a3,cs4,e4] [d3,fs3,a3,cs4] [a3,cs4,e4,b4] [e3,gs3,b3,fs4]>" # s "sweetChords" # amp 0.38 # fmIndex 0.28 # cutoff (slow 13 $ range 2200 4400 sine) # attack 0.03 # release 0.85 # gain "<0.34 0.28 0 0.3 0.25 0.32 0 0.29 0.26>" # hpf 190 # lpf 7500 # pan 0.52 # ddSend "0 0 0.16 0" # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.23 # verbSend 0.16

d10 $ every 7 (rev) $ slice 8 "<0 2 4 6 1 3 5 7> <2 0 6 4 3 1 7 5>" $ loopAt 1 $ s "<vxA vxB vxD>" # speed "<0.84 1 1.12 0.94>" # gain ("0.37 0 0 0 0.28 0 0 0" * "<1 0 0.6 0 0.8 0 0 0.4 0>") # hpf 420 # lpf 6200 # pan "<0.4 0.62 0.53>" # cut 10 # ddSend "0 0 0 0.24 0 0 0 0" # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.28 # verbSend 0.18

d11 $ every 11 (iter 3) $ loopAt 1 $ s "p70perc" # gain "<0.16 0 0.19 0.14 0 0.17 0 0.16 0 0.14 0>" # hpf 930 # lpf 6800 # pan 0.42 # ddSend 0 # verbSend 0.07

d12 $ every 13 (rev) $ slice 4 "<0 1 2 3> <2 0 3 1>" $ loopAt 1 $ s "p85drumA" # gain "<0 0 0.12 0 0.16 0 0.13 0 0 0.14 0 0.12 0>" # hpf 450 # lpf 5200 # pan 0.6 # ddSend 0 # verbSend 0.05
