-- 104: ARRANGEMENT. 64-bar form in five stages, gated by slow 8 "<...>" (8 stages x 8 bars).
--   bars  0- 7  bass + drums only
--   bars  8-23  sweet chords arrive to contrast the bass
--   bars 24-31  chords DROPPED, back to bass + drums
--   bars 32-63  chords return; perc from 32, strings from 16, arp from 40, bell from 48
-- Sweet chords are sweetChords (sc/chords.scd): project FM/additive voice with a
-- bounded sustain-driven envelope, so it cannot leak. Plays the TFF D/G theme.
-- RESET CYCLES before evaluating so the form starts at bar 0.
-- Parent 103.tidal. Needs sc/samples94.scd, sosBell, sc/chords.scd.

let sd102 = slow 16 $ up "14 ~ ~ ~ 18 ~ ~ ~ 21 ~ ~ 26 ~ ~ ~ ~ 11 ~ 11 ~ 14 13 14 ~ 18 17 18 23 ~ ~ ~ ~ 10 ~ 10 ~ 14 ~ 14 ~ 17 16 17 ~ 22 ~ ~ 21 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 14 ~ ~ ~ 18 ~ ~ ~ 21 ~ ~ 26 ~ ~ ~ ~ 11 ~ 11 ~ 14 13 14 ~ 18 17 18 23 ~ ~ ~ ~ 10 ~ 10 ~ 14 ~ 14 ~ 17 16 17 ~ 22 ~ ~ 21 ~ ~ ~ 21 18 21 ~ ~"

let tffTheme = slow 16 $ n "~ ~ ~ ~ ~ ~ d5 ~ cs4 ~ e4 ~ a4 ~ b3 ~ [e3,a3,d4,g4,b4,e5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ [d4,g4,b4] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ [d4,g4,b4] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ [d4,g4,b4] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"

let air103 = slow 4 $ n "c5 c5 fs4 a3 d3 ~ g4 e4 c4 e4 g4 d4 d4 ~ fs3 d4 d4 d3 a4 fs4 b4 ~ a4 d4 e4 b3 a4 b4 b4 ~ c5 d5 d5 ~ fs5 d5 b4 ~ a4 d4 e4 b3 fs4 d4 g3 b3 fs3 d4 d4 d3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"

let lpvPerc = loopAt 1 $ s "p93perc"

let lpvMel = loopAt 1 $ s "p93arp"

let lpvStr = loopAt 1 $ s "p93str"

setcps (104/240)

d1 $ silence
d2 $ s "p70kick ~ ~ ~ ~ ~ p70kick ~ ~ ~ ~ ~ p70kick ~ ~ ~" # gain "1 0.9 0.95" # hpf 55 # lpf 6000 # pan 0.5 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0
d3 $ s "~ ~ ~ ~ p70snare ~ ~ ~ ~ ~ ~ ~ p70snare ~ ~ ~" # gain "0.85 0.72" # hpf 260 # lpf 12000 # pan 0.45 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0.06
d4 $ s "p70hat*16" # gain "0.5 0.3 0.42 0.3 0.48 0.3 0.42 0.3 0.5 0.3 0.42 0.3 0.48 0.3 0.42 0.34" # hpf 1700 # lpf 18000 # pan 0.62 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0
d5 $ sd102 # s "p76bass" # gain "0.78 0.55 0.68 0.5" # attack 0.003 # hold 0.03 # release 0.15 # hpf 45 # lpf 3000 # pan 0.5 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0
d6 $ lpvMel # gain ("0 0 0 0 0.6 0 0 0 0 0.54 0 0 0 0 0.58 0" * slow 8 "<0 0 0 0 0 0.6 0.85 1>") # attack 0.006 # hold 0.04 # release 0.18 # hpf 250 # lpf 12000 # cut 6 # ddSend 0.1 # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.26 # ddWow 0 # ddCross 1 # verbSend 0.14
d7 $ silence
d8 $ every 21 rev $ chop 4 lpvStr # gain ("0.5 0 0 0.42 0 0 0.48 0 0 0.38 0 0 0 0.44 0 0" * slow 8 "<0 0 0.5 0.8 1 1 1 1>") # attack 0.005 # hold 0.03 # release 0.28 # hpf 420 # lpf 13000 # pan 0.65 # ddSend 0.18 # delaySend 1 # lock 1 # delaytime (5/16) # delayfeedback 0.3 # ddWow 0 # ddCross 1 # verbSend 0.22
d9 $ tffTheme # s "sweetChords" # amp 0.63 # cutoff 5000 # release 1.6 # detune 0.01 # fmIndex 1.2 # drive 1.4 # gain ("0.5 0 0 0 0.42 0 0 0 0.46 0 0 0 0.39 0 0 0.48 0 0 0 0 0.43 0 0 0 0 0 0.41 0 0 0 0" * slow 8 "<0 1 1 0 1 1 1 1>") # pan 0.42 # hpf 240 # lpf 11000 # ddSend 0.14 # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.3 # ddWow 0 # ddCross 1 # verbSend 0.22
d10 $ every 11 (hurry 2) $ struct "t(5,16)" lpvPerc # gain ("0.5 0 0 0 0 0.42 0 0 0 0 0 0.46 0 0 0 0" * slow 8 "<0 0 0 0 1 1 1 1>") # hpf 700 # lpf 16000 # cut 8 # pan "0.3 0.7" # ddSend 0.06 # delaySend 1 # lock 1 # delaytime (7/16) # delayfeedback 0.24 # ddWow 0 # ddCross 1 # verbSend 0.12
d11 $ air103 # s "sosBell" # amp 0.42 # rel 2.4 # gain ("0.42 0 0 0 0.34 0 0 0 0.38 0 0 0 0.3 0 0 0" * slow 8 "<0 0 0 0 0 0 1 1>") # pan 0.7 # hpf 620 # lpf 11000 # ddSend 0.2 # delaySend 1 # lock 1 # delaytime (5/16) # delayfeedback 0.34 # ddWow 0 # ddCross 1 # verbSend 0.3
d12 $ silence
