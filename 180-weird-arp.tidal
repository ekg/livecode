-- 180 — WEIRD ARP + GLOBAL MASK. 118 BPM, B minor / D major. The state as it stands, saved.
--
-- STOCK TIDAL: orbits -> hardware through a minimal master (hpf -> gain -> soft knee ->
-- limiter), orbit FX = SuperCollider's own dirt_delay -> dirt_reverb -> dirt_monitor. Every FX
-- here is a Tidal orbit param (delay/delaytime/delayfeedback/room/size/dry). ~masterVol.value(n).
--
-- WHAT THIS IS
--   * d7  THE RIFF: interval shape 0 0 0 7 | 0 0 3 7 from the root, in B minor = b3 b3 b3 fs4 |
--         b3 b3 d4 fs4. Eight 8ths a bar, hoRhodes, two pitches doing all the work.
--   * d4  THE ARP OFF IT: `arp "<up down updown>"` reading 5-note B-minor voicings, so the
--         arpeggio can never leave the key. NB `arp` spreads a chord's notes ACROSS THE CYCLE,
--         so a 3-note voicing gives ~1.5 notes a bar (a drip); with 5-note voicings and `fast 2`
--         it runs ~10 events per cycle. miLead with engine "<3 6 11 5>" so the TIMBRE morphs.
--   * d16 TOM MELODY: five drum-machine kits rotated (`casiorz1 bossdr220 emusp12 linndrum
--         korgddm110`), their tom slots 6/7/8 (lt/mt/ht per ~/drummachines/MAP.md), pitched by
--         speed ratios <1 1.19 1.5 1.12 0.89 1.33 0.75> on an E(7,16,5) figure rotating every 7.
--   * d5  DANCE BASS: `struct "t(8,16,1)"` = eight even hits a bar, root b1 with an octave pop
--         (b2) on the 3rd and 7th. TIGHT envelope (sustain 0.14 / release 0.1) — a dub sine has
--         long legs, a dance bass is staccato.
--   * d1  KICK: mostly four-on-the-floor, but two bars in eight shift to a stutter —
--         t(3,8,1) (three hits) and t(5,8,2) (a shifted five).
--   * d3  SHAKER on E(13,16,3) (a prime grid, not offbeats) with fast 2/6, stutters, crush.
--   * d12 flash perc: Euclidean density CLIMBING t(3,16) -> t(15,16) over 8 bars ("the wave").
--   * d15 the fill: last quarter of every 8 bars goes fast 8 with a stutWith machine-gun.
--
-- THE GLOBAL MASK + THE WEAVE (the point of this file): the current material — kick, bass, riff,
-- arp, toms — carries `mask "<t t t t f f f f>"`, so it plays four bars and Rests four. d14 is
-- the weave: the humanip vocal fragments (`vxA vxB vxD`, chopped 8, pitched by speed ratios)
-- carrying the COMPLEMENTARY mask `"<f f f f t t t t>"`, thrown into a 0.8-size room and a
-- 0.5-feedback delay. So the drop-outs are not silence — the space gets filled, and because the
-- two masks are exact inverses the hand-off is always clean.
--
-- THE BREAK SET (amen, Funky 6, the {}%16 mashup, the p93drumA cut-up, Funky 3, the 300-breaks
-- and the jungle one-shots) lives in 179-lootin-dub.tidal under "SIDE B — BREAKBEAT". It is not
-- duplicated here so this file stays readable; evaluate those lanes alongside this one.
--
-- NOTE the two traps that bite in this material: a tunepile tab lane is written over a 16-bar
-- cycle and must be stretched (`slow 4` for 4 bars) when the track runs on a one-bar cycle; and
-- a multi-parameter transform must be a composition of SINGLE-# sections
-- (`let blast = (# room 0.92) . (# size 1) . (# dry 0.08)`), because `(# a # b)` cannot parse —
-- and a transform that fails to parse SILENTLY does nothing.
setcps 0.49166666666666664

let swing = (# nudge (fast 8 $ "0 1" * (slow 8 $ range 0 0.09 sine)))
let blast = (# room 0.92) . (# size 1) . (# dry 0.08)
let wash = (# room 0.95) . (# size 1) . (# dry 0.06)
let dubThrow = (# delay 0.65) . (# delayfeedback 0.72) . (# delaytime (3/16)) . (# lock 1)
let shortThrow = (# delay 0.55) . (# delayfeedback 0.68) . (# delaytime (3/16)) . (# lock 1)

d1 $ mask "<t t t t f f f f>" $ swing $ struct "<t(4,4) t(4,4) t(3,8,1) t(4,4) t(4,4) t(5,8,2) t(4,4) t(4,4)>" $ s "k808S" # gain (slow 8 $ range 0.74 0.86 sine) # velocity (slow 7 $ range 0.75 1 perlin) # shape 0.25 # hpf 55 # lpf 4000 # release 0.09 # nudge (slow 11 $ range (-0.006) 0.008 sine)

d2 $ swing $ struct "~ ~ t ~" $ s "s808b" # gain 0.5 # velocity (slow 5 $ range 0.65 0.95 perlin) # hpf 320 # lpf 6500 # release 0.08 # room 0.12 # nudge (slow 13 $ range (-0.004) 0.012 sine)

d3 $ degradeBy 0.12 $ sometimesBy 0.3 (fast 2) $ sometimesBy 0.2 (fast 6) $ every 7 (rotR (1/16)) $ sometimesBy 0.25 (stutWith 3 0.03125 ((|* gain 0.6) . (|* speed 1.5))) $ sometimesBy 0.2 (# crush 10) $ sometimesBy 0.12 blast $ struct "t(13,16,3)" $ s "sh808" # gain (slow 5 $ range 0.2 0.3 sine) # velocity (slow 11 $ range 0.6 1 perlin) # hpf 5000 # lpf 12000 # pan (slow 9 $ range 0.38 0.62 sine) # release 0.03

d4 $ mask "<t t t t f f f f>" $ fast 2 $ sometimesBy 0.2 (|+ note 12) $ every 7 (rotR (1/16)) $ sometimesBy 0.15 (# crush 6) $ note (arp "<up down updown>" (slow 2 "<[b3,d4,fs4,a4,cs5] [b3,d4,fs4,a4,d5] [b3,e4,fs4,b4,cs5] [b3,d4,fs4,a4,cs5]>")) # s "miLead" # gain (slow 7 $ range 0.34 0.44 sine) # amp 0.45 # engine "<3 6 11 5>" # harm (slow 11 $ range 0.35 0.6 sine) # timbre (slow 9 $ range 0.3 0.7 saw) # morph (slow 13 $ range 0.15 0.85 sine) # cutoff 7500 # attack 0.006 # sustain 0.18 # release 0.3 # pan (slow 9 $ range 0.4 0.62 sine) # keyShift 0 # room 0.35 # size 0.65 # dry 0.6 # delay 0.32 # delaytime (3/16) # delayfeedback 0.44 # lock 1

d5 $ mask "<t t t t f f f f>" $ sometimesBy 0.15 (|+ note 12) $ sometimesBy 0.1 (|+ note 5) $ struct "t(8,16,1)" $ note "<b1 b1 b2 b1 b1 b1 b2 b1>" # s "dubsub" # gain 0.52 # amp 0.75 # drive 0.08 # pitchEnv 0.08 # legato 0.9 # sustain 0.14 # release 0.1 # hpf 34 # lpf 540 # dry 1 # nudge (slow 17 $ range (-0.004) 0.006 sine)

d7 $ mask "<t t t t f f f f>" $ sometimesBy 0.2 (fast 2) $ every 5 (within (0.5,1) (rev)) $ sometimesBy 0.15 (|+ note 12) $ note "<b3 b3 b3 fs4 b3 b3 d4 fs4>" # s "hoRhodes" # gain (slow 7 $ range 0.46 0.6 sine) # amp 0.5 # cutoff 3800 # waveMix 0.14 # hpf 400 # lpf 9000 # attack 0.01 # sustain 0.3 # release 0.5 # pan (slow 9 $ range 0.42 0.58 sine) # keyShift 0 # vib 0.05 # vibRate 4.6 # delay 0.3 # delaytime (3/16) # delayfeedback 0.4 # lock 1 # room 0.35 # size 0.65 # dry 0.55

d12 $ sometimesBy 0.3 (stutWith 3 0.03125 ((|* gain 0.55) . (|* speed 1.25))) $ sometimesBy 0.25 (fast 2) $ sometimesBy 0.3 (# crush 12) $ sometimesBy 0.2 (# shape 0.4) $ sometimesBy 0.2 blast $ sometimesBy 0.25 shortThrow $ struct "<t(3,16) t(5,16) t(7,16) t(9,16) t(11,16) t(13,16) t(15,16) t(15,16)>" $ s "{jungle t808H cn808 ebongos}" # gain (slow 7 $ range 0.3 0.44 sine) # hpf 400 # lpf 12000 # pan perlin # release 0.05 # dry 0.7

d14 $ mask "<f f f f t t t t>" $ sometimesBy 0.3 (fast 2) $ sometimesBy 0.25 (stutWith 3 0.0625 (|* gain 0.6)) $ sometimesBy 0.25 blast $ chop 8 $ loopAt 1 $ s "<vxA vxB vxD>" # speed "<1 1 1.19 1.5 1 0.89>" # gain 0.46 # amp 0.9 # hpf 400 # lpf 9000 # pan (slow 9 $ range 0.35 0.65 sine) # room 0.5 # size 0.8 # delay 0.4 # delaytime (3/16) # delayfeedback 0.5 # lock 1 # release 0.2

d15 $ every 8 (within (0.75,1) (fast 8)) $ sometimesBy 0.35 (stutWith 5 0.015625 ((|* gain 0.5) . (|* speed 1.5))) $ sometimesBy 0.3 (# crush 14) $ sometimesBy 0.25 (# shape 0.45) $ sometimesBy 0.3 blast $ struct "t(5,16,3)" $ s "{t808Lo cn808 jamblock}" # gain 0.34 # hpf 300 # lpf 11000 # pan perlin # release 0.04 # dry 0.65

d16 $ mask "<t t t t f f f f>" $ sometimesBy 0.25 (stutWith 3 0.0625 ((|* gain 0.6) . (|* speed 1.25))) $ every 7 (rotR (1/8)) $ sometimesBy 0.2 (fast 2) $ sometimesBy 0.18 (# crush 8) $ struct "t(7,16,5)" $ s "<casiorz1 bossdr220 emusp12 linndrum korgddm110>" # n "<6 7 8 7 8 6 8>" # speed "<1 1.19 1.5 1.12 0.89 1.33 0.75>" # gain (slow 9 $ range 0.34 0.45 sine) # hpf 200 # lpf 6200 # pan (slow 13 $ range 0.35 0.65 sine) # release 0.12 # room 0.22 # dry 0.78
