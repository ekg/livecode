-- 109: MODULATE AND ADD.
-- d6 NEW melody: Pet Shop Boys "It's a Sin" line, transposed C->D, on supermandolin.
--    modulation: octave-up pops 20%, half-speed every 8 bars, jux pan, slow LPF sweep.
-- d11 bell now octave-jumps sometimes 18%.
-- d1 and d4 gain slow filter / pan movement. d9 chords unchanged from 108.
-- The p93arp synth loop is NOT here - that was the "horrible synth".
-- Parent 108.tidal. Needs sc/samples94.scd, sosBell, sc/chords.scd.

let prog107 = slow 8 $ n "<[g4,b4,e5] [a4,b4,d5] [b4,d5,fs5] [a4,cs5,e5] [g4,b4,e5] [a4,b4,ds5] [b4,e5,a5] [b4,e5,g5]>"
let lead109 = slow 2 $ n "d6 f6 d5 a5 d6 e6 d5 f5 a5 d6 d5 a5 d6 e6 d5 g5"

let sd102 = slow 16 $ up "14 ~ ~ ~ 18 ~ ~ ~ 21 ~ ~ 26 ~ ~ ~ ~ 11 ~ 11 ~ 14 13 14 ~ 18 17 18 23 ~ ~ ~ ~ 10 ~ 10 ~ 14 ~ 14 ~ 17 16 17 ~ 22 ~ ~ 21 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 14 ~ ~ ~ 18 ~ ~ ~ 21 ~ ~ 26 ~ ~ ~ ~ 11 ~ 11 ~ 14 13 14 ~ 18 17 18 23 ~ ~ ~ ~ 10 ~ 10 ~ 14 ~ 14 ~ 17 16 17 ~ 22 ~ ~ 21 ~ ~ ~ 21 18 21 ~ ~"
let tffTheme = slow 16 $ n "~ ~ ~ ~ ~ ~ d5 ~ cs4 ~ e4 ~ a4 ~ b3 ~ [e3,a3,d4,g4,b4,e5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ [d4,g4,b4] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ [d4,g4,b4] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ [d4,g4,b4] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
let air103 = slow 4 $ n "c5 c5 fs4 a3 d3 ~ g4 e4 c4 e4 g4 d4 d4 ~ fs3 d4 d4 d3 a4 fs4 b4 ~ a4 d4 e4 b3 a4 b4 b4 ~ c5 d5 d5 ~ fs5 d5 b4 ~ a4 d4 e4 b3 fs4 d4 g3 b3 fs3 d4 d4 d3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
let lpvPerc = loopAt 1 $ s "p93perc"
let lpvMel = loopAt 1 $ s "p93arp"
let lpvStr = loopAt 1 $ s "p93str"

setcps (104/240)

d1 $ struct "t(7,16)" $ loopAt 1 $ s "p93perc" # gain ("0.3 0 0 0 0 0.24 0 0 0 0 0 0.26 0 0 0 0" * slow 8 "<0 0.4 0.7 0.9 1 1 0.8 1>") # hpf 800 # lpf (slow 16 $ range 6000 15000 sine) # cut 8 # pan "<0.25 0.7 0.45 0.6>" # ddSend 0.08 # delaySend 1 # lock 1 # delaytime (7/16) # delayfeedback 0.26 # ddWow 0 # ddCross 1 # verbSend 0.12
d2 $ s "p70kick*4" # gain "0.95 0.8 0.88 0.8" # hpf 50 # lpf 6500 # pan 0.5 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0
d3 $ s "~ ~ ~ ~ p70snare ~ ~ ~ ~ ~ ~ ~ p70snare ~ ~ ~" # gain "0.8 0.7" # hpf 260 # lpf 12000 # pan 0.45 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0.05
d4 $ s "~ p70hat ~ p70hat ~ p70hat ~ p70hat" # gain "0.42 0.34 0.4 0.36" # hpf 1800 # lpf 18000 # pan "<0.62 0.5 0.7 0.45>" # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0
d5 $ silence
d6 $ sometimesBy 0.2 (|+ up 12) $ every 8 (# speed 0.5) $ jux (# pan 0.72) $ lead109 # s "supermandolin" # gain ("0.72 0 0.5 0 0.62 0 0 0.68 0 0.55 0 0 0.66 0 0" * slow 8 "<0 0 0.6 0.85 1 1 1 1>") # legato 0.8 # attack 0.005 # hold 0.04 # release 0.4 # hpf 300 # lpf (slow 32 $ range 7000 14000 sine) # pan 0.6 # ddSend 0.16 # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.32 # ddWow 0 # ddCross 1 # verbSend 0.2
d7 $ silence
d8 $ silence
d9 $ jux rev $ prog107 # s "sweetChords" # amp 0.75 # cutoff (slow 16 $ range 3600 7500 sine) # release 1.7 # detune "<0.01 0.01 0.015 0.007>" # fmIndex "<1.2 1.2 1.7 0.9>" # drive 1.4 # gain ("0.6 0.6 0.6 0.6 0.6 0.6 0.6 0.6" * slow 8 "<0.4 1 1 1 1 1 1 1>") # pan 0.42 # hpf 240 # lpf 11500 # ddSend 0.16 # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.32 # ddWow 0 # ddCross 1 # verbSend 0.24
d10 $ every 11 (hurry 2) $ struct "t(5,16)" $ loopAt 1 $ s "p93perc" # gain ("0.5 0 0 0 0 0.42 0 0 0 0 0 0.46 0 0 0 0" * slow 8 "<0 0 0 0 1 1 1 1>") # hpf 700 # lpf 16000 # cut 8 # pan "<0.3 0.7 0.5 0.65>" # ddSend 0.06 # delaySend 1 # lock 1 # delaytime (7/16) # delayfeedback 0.24 # ddWow 0 # ddCross 1 # verbSend 0.12
d11 $ off 0.25 (|* gain 0.4) $ sometimesBy 0.18 (|+ up 12) $ air103 # s "sosBell" # amp 0.75 # rel 2.8 # gain ("0.62 0 0 0 0.52 0 0 0 0.58 0 0 0 0.48 0 0 0" * slow 8 "<0 0.4 0.7 0.9 1 1 1 1>") # pan 0.7 # hpf 580 # lpf 12000 # ddSend 0.22 # delaySend 1 # lock 1 # delaytime (5/16) # delayfeedback 0.36 # ddWow 0 # ddCross 1 # verbSend 0.32
d12 $ silence
