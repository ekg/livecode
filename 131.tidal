-- 131: TIDAL ESTUARY — TOTAL TIMBRE CYCLE. 112 BPM.
-- Every stream gets a new source or rotating sound family; 130 preserves
-- the beloved sweetChords/808/break-bank version. Same fractured rhythms.
-- Live fracture: independent 5/7/9/11/13-cycle transformations of the
-- sweetChords melody, choir, harmony, bass and tape replies; preserve 128.
-- 125 breakdown -> 126 loops -> 127 one-drop -> 128 full polyrhythmic drop.
-- A->B reharmonization: Bm9 / Em9 / Gmaj9 / F#7b9. The G in the
-- Lovely Nancy melody becomes F#7's b9: sweetness turning to tension.
-- Preserve Scene A in 123.tidal / fa73858; all streams resend after restart.
-- d6 is the singing solo, d8 a two-part sweetChords response choir; do not
-- replace the lead with a busy walking line. d9 is the supporting harmony.
-- Tune Pile sources: Bob Marley, Could You Be Loved, tabs-tidal
-- Marley_Bob_-_Could_You_Be_Loved.gp3-6387644c.tidal: Bm/D/G/A harmony,
-- Spur 2 bass fragments b2-d3-fs3 and g3-e3-d3; and The Glass of Beer
-- (MontrealSession/reels/4:GLASSOFBEER.abc, K:Bm): eight-bar A/B melodic
-- phrases transposed an octave down. Recomposition, not a cover.
-- 124-era overlay: Lovely Nancy (MontrealSession/waltzes/$:LOVELYNANCY.abc,
-- K:Bm, 3/4) contributes F#-G-A and the rising answer, stretched over
-- two dub bars on the same sweetChords instrument as the harmony.
-- Sources: h2o808 kit, p94brkA break, cpluck cp4, cbow cb3s,
-- project dubsub/dubsynth/tapestab + MI Plaits. All autoload at SC boot.
-- Shape: fixed one-drop anchor; independent 5/7/9/11-cycle variation on
-- peripheral voices. Reverb/delay on stabs and fragments, NOT a muddy master.
setcps (112/240)

d1 $ sometimesBy 0.09 (fast 3) $ every 7 (fast 2) $ s "< [p70kick ~ ~ ~ ~ ~ ~ ~ p70kick ~ ~ ~ ~ ~ ~ ~] [p70kick ~ ~ ~ ~ ~ p70kick ~ p70kick ~ ~ ~ ~ ~ ~ ~] [p70kick ~ ~ ~ ~ ~ p70kick ~ p70kick ~ ~ ~ ~ p70kick ~ ~] >" # gain 0.84 # hpf 32 # lpf 7500 # pan 0.5 # ddSend 0 # verbSend 0.03

d2 $ every 11 (fast 2) $ every 9 (iter 4) $ s "<[~ ~ ~ ~ [p70snare,cp] ~ ~ ~ ~ ~ ~ ~ [p70snare,cp] ~ ~ ~] [~ ~ ~ ~ [p70snare,cp] ~ ~ cp ~ ~ ~ ~ [p70snare,cp] ~ cp ~] [~ ~ ~ ~ [p70snare,cp] ~ ~ ~ ~ ~ cp ~ [p70snare,cp] ~ ~ ~]>" # gain 0.78 # hpf 260 # lpf 12000 # pan 0.47 # ddSend 0 # delaySend 0 # lock 1 # delaytime (3/8) # delayfeedback 0.36 # ddWow 0.1 # ddCross 0.65 # verbSend 0.02

d3 $ every 7 (iter 4) $ sometimesBy 0.08 (fast 2) $ s "<p70hat(5,16) h808P(7,16) p70hat(9,16)>" # gain (perlin * 0.26 + 0.42) # speed (perlin * 0.18 + 0.91) # hpf 1300 # lpf (slow 9 $ range 4600 10500 sine) # pan (perlin * 0.42 + 0.29) # ddSend "0 0 0.2 0 0" # delaySend 1 # lock 1 # delaytime (5/16) # delayfeedback 0.26 # verbSend 0.06

d4 $ every 11 (iter 3) $ every 5 (fast 2) $ s "<t808M(5,13) t808Lo(7,19) t808H(3,11)>" # gain (perlin * 0.26 + 0.37) # speed (slow 7 $ range 0.78 1.34 sine) # hpf 370 # lpf (slow 13 $ range 3800 8900 sine) # pan (perlin * 0.5 + 0.25) # ddSend "0 0 0 0.22 0" # delaySend 1 # lock 1 # delaytime (5/16) # delayfeedback 0.34 # ddCross 0.7 # verbSend 0.07

d5 $ sometimesBy 0.08 (fast 3) $ every 13 (rev) $ every 7 (fast 2) $ n "<[b1 ~ ~ fs2 ~ b1 ~ a1] [e2 ~ ~ b1 ~ e2 ~ d2] [g1 ~ ~ d2 ~ g1 ~ fs1] [fs1 ~ ~ cs2 ~ fs1 ~ e2]>" # s "miLead" # engine "<0 16 0 4>" # harm (slow 7 $ range 0.25 0.55 sine) # timbre 0.33 # morph 0.28 # cutoff 2200 # release 0.18 # amp 0.46 # gain 0.56 # pan 0.5 # ddSend "0 0 0.18 0" # delaySend 1 # lock 1 # delaytime (3/8) # delayfeedback 0.3 # verbSend 0.03

d6 $ degradeBy 0.58 $ every 3 (fast 4) $ every 5 (rev) $ n "<[~ fs4 ~ ~ a4 ~] [~ g4 ~ ~ b4 ~] [~ a4 ~ ~ cs5 ~] [~ g4 ~ ~ a4 ~] [~ fs4 ~ ~ a4 ~] [~ g4 ~ b4 ~ d5] [~ cs5 ~ a4 ~ g4] [~ fs4 ~ ~ d4 ~]>" # s "miLead" # engine "<11 4 16 11>" # harm (slow 5 $ range 0.25 0.6 sine) # timbre (perlin * 0.45 + 0.22) # morph 0.36 # cutoff (perlin * 3600 + 2800) # amp 0.42 # attack 0.004 # release 0.18 # legato 0.14 # gain (perlin * 0.22 + 0.4) # hpf 290 # lpf 8500 # pan 0.64 # ddSend 0 # verbSend 0.09

d7 $ sometimesBy 0.12 (fast 3) $ every 11 (rev) $ n "<[~ b3 ~ d4 ~ fs4 ~ ~] [~ e3 ~ g3 ~ b3 ~ ~] [~ g3 ~ b3 ~ d4 ~ ~] [~ fs3 ~ as3 ~ e4 ~ ~]>" # s "superpiano" # amp 0.3 # gain 0.34 # hpf 260 # lpf 7200 # pan 0.68 # ddSend "0 0 0.25 0" # delaySend 1 # lock 1 # delaytime (5/16) # delayfeedback 0.43 # ddWow 0 # ddCross 0.75 # verbSend 0.19

d8 $ every 13 (rev) $ every 9 (fast 2) $ n "<[~ ~ ~ ~ ~ ~ [d4,fs4] ~] [~ ~ ~ ~ ~ ~ [g4,b4] ~] [~ ~ ~ ~ [b4,d5] ~ ~ ~] [~ ~ ~ ~ [as4,cs5] ~ ~ ~]>" # s "miLead" # engine "<11 22 11 16>" # harm 0.3 # timbre (slow 11 $ range 0.22 0.62 sine) # morph 0.31 # cutoff 4700 # amp 0.34 # attack 0.07 # release 1.1 # legato 0.8 # gain (slow 16 $ range 0.25 0.42 sine) # hpf 330 # lpf 7900 # pan 0.32 # ddSend "0 0.12 0 0" # delaySend 1 # lock 1 # delaytime (3/8) # delayfeedback 0.25 # verbSend 0.19

d9 $ every 7 (iter 3) $ sometimesBy 0.1 (fast 2) $ n "<[~ [b3,d4,fs4,cs5] ~ ~ ~ [b3,d4,fs4,cs5] ~ ~] [~ [e3,g3,b3,fs4] ~ ~ ~ [e3,g3,b3,fs4] ~ ~] [~ [g3,b3,d4,a4] ~ ~ ~ [g3,b3,d4,a4] ~ ~] [~ [fs3,as3,e4,g4] ~ ~ ~ [fs3,as3,e4,g4] ~ ~]>" # s "superpiano" # amp 0.48 # attack 0.005 # release 0.22 # legato 0.18 # gain 0.47 # hpf 220 # lpf 10800 # pan 0.48 # ddSend 0 # verbSend 0.07

d10 $ every 7 (iter 3) $ every 9 (jux rev) $ sometimesBy 0.12 (chop 8) $ sometimesBy 0.18 (striate 8) $ slice 16 "<[0 3 7 11 2 6 10 14] [15 12 8 4 13 9 5 1]>" $ loopAt 1 $ s "<p94brkD p70drumA p85drumA>" # gain 0.31 # hpf 340 # lpf (slow 13 $ range 3900 7900 sine) # pan 0.4 # ddSend "0 0 0.1 0" # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.25 # verbSend 0.05

d11 $ every 13 (fast 2) $ every 9 (rev) $ s "<cp(7,19) p70soft(5,13)>" # gain (perlin * 0.26 + 0.35) # speed "<0.9 1 1.12 0.84>" # hpf 1100 # lpf (slow 11 $ range 5500 12000 sine) # pan (perlin * 0.34 + 0.48) # ddSend 0 # delaySend 0 # lock 1 # delaytime (3/16) # delayfeedback 0.28 # verbSend 0.02

d12 $ every 5 (iter 4) $ every 11 (jux rev) $ sometimesBy 0.14 (striate 4) $ slice 8 "<[0 3 5 7] [6 2 4 1]>" $ loopAt 1 $ s "<p70drumB p85drumA p70drumA p70drumB>" # gain 0.3 # hpf 750 # lpf (slow 17 $ range 4800 10000 sine) # pan 0.63 # ddSend "0 0.1 0 0" # delaySend 1 # lock 1 # delaytime (5/16) # delayfeedback 0.24 # verbSend 0.06
