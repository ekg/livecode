let pocket76 = loopAt 1 $ s "p70drumA"


setcps (99/240)

d1 $ (slow 8 $ timeCat [(4, fast 4 pocket76), (2, fast 2 $ slice 8 "<[0 1 2 3 4 5 6 7] [0 1 2 3 4 7 6 5]>" pocket76), (1, slice 16 "0 1 2 3 4 5 7 6 8 9 10 11 12 13 15 14" pocket76), (1, chop 8 pocket76)]) # gain "0.73 0.64 0.7 0.64" # lpf 18000 # hpf 30 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0 # room 0

d2 $ every 4 rev $ struct "<t(5,8) t(7,8) t(3,8) t(5,8,2)>" $ chop 8 $ loopAt 2 $ s "p70drumB" # gain 0.41 # hpf 500 # lpf 18000 # cut 2 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0

d3 $ (human70_0_2 |* gain 0.8) # hpf 1800 # lpf 18000 # pan 0.6 # ddSend 0 # delaySend 0 # delayfeedback 0

d4 $ s "~ cp ~ cp" # gain 0.4 # hpf 650 # lpf 16000 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0 # room 0

d5 $ (slow 4 $ up "0 3 7 10 12 10 7 3 -4 0 3 7 5 3 0 -2 5 -4 0 3 5 3 0 -3 -5 -1 2 5 7 5 2 -1") # s "p76bass" # gain "0.65 0.46 0.58 0.48" # attack 0.003 # hold 0.025 # release 0.14 # hpf 35 # lpf 3500 # pan 0.5 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0 # room 0

d6 $ chop 4 $ loopAt 2 $ s "<p70synthA p70synthA p70synthB p70synthB>" # up 12 # gain ("0.54 0.44" * (slow 8 $ range 0.9 1 sine)) # attack 0.008 # hold 0.07 # release 0.42 # hpf 130 # lpf 18000 # cut 6 # ddSend "<0.1 0.1 0.1 0.26>" # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.3 # ddWow 0 # ddCross 1 # ddDuck 0.55 # verbSend 0.16 # verbT60 4 # verbHp 450

d7 $ silence

d8 $ every 4 rev $ struct "<t f t f f t f f>" $ chop 8 $ loopAt 2 $ s "p70synthB" # gain 0.39 # hpf 500 # lpf 14000 # cut 8 # pan 0.65 # ddSend 0.1 # delaySend 1 # delayfeedback 0.2 # ddWow 0 # ddCross 1 # verbSend 0.12

d9 $ silence

d10 $ slow (5/4) $ struct "t(5,8)" $ chop 8 $ loopAt 1 $ s "p70perc" # gain 0.28 # hpf 800 # lpf 16000 # cut 10 # pan 0.3 # ddSend 0 # delaySend 0 # delayfeedback 0

