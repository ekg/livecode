let glass01 = s "bd ~ ~ ~ bd ~ ~ bd bd ~ ~ ~ bd ~ ~ ~" # gain 0.78

let glass02 = s "~ sn ~ sn" # gain 0.55 # hpf 200 # ddSend 0.08 # lock 1 # delaytime (3/16) # delayfeedback 0.35

let glass03 = s "hh*8" # gain "0.25 0.38 0.28 0.36" # hpf 1800 # pan "0.35 0.65"

let glass04 = s "~ ~ clak ~ ~ clak ~ ~" # gain 0.35 # hpf 900 # ddSend 0.24 # lock 1 # delaytime (3/16) # delayfeedback 0.45

let glass05 = n "<[as2 ~ as3 ~ f3 ~ a2 ~] [a2 ~ a3 ~ e3 ~ c3 ~] [d3 ~ d4 ~ a3 ~ c3 ~] [g2 ~ g3 ~ d3 ~ f3 ~]>" # s "dubsub" # gain 0.64 # legato 0.38 # lpf 650

let glass06 = n "<[as3,f4,a4,c5,d5] [a3,e4,g4,c5,d5] [d4,f4,a4,c5,e5] [g3,d4,f4,a4,b4]>" # s "superpiano" # gain 0.59 # legato 1.25 # lpf 3800 # verbSend 0.16 # verbHp 500 # verbT60 4

let glass07 = slow 2 $ n "d5 ~ ~ f5 ~ ~ d5 ~ ~ ~ f5 ~ a4 c5 ~ ~ d5 ~ ~ f5 ~ ~ d5 ~ ~ ~ f5 ~ ~ g5 ~ ~" # s "supervibe" # gain 0.7 # legato 0.85 # lpf 4400 # ddSend 0.2 # lock 1 # delaytime (3/16) # delayfeedback 0.45 # pan (slow 8 $ range 0.35 0.65 sine)

let glass08 = slow 2 $ n "~ ~ ~ ~ d5 f5 a5 f5 ~ ~ d6 a5 f5 a5 ~ ~" # s "superpiano" # gain 0.49 # legato 0.7 # lpf 3200 # ddSend 0.25 # lock 1 # delaytime (5/16) # delayfeedback 0.43 # pan 0.65

let glass09 = n "~ ~ <a5 c6> ~" # s "supermandolin" # gain 0.34 # legato 0.3 # hpf 700 # ddSend 0.3 # lock 1 # delaytime (7/16) # delayfeedback 0.5 # lpf 2800

let glass10 = n "<[f4,a4,c5] [e4,g4,c5] [f4,a4,c5] [f4,a4,b4]>" # s "supersaw" # gain 0.32 # legato 1.1 # lpf (slow 16 $ range 700 1300 sine) # verbSend 0.22 # verbHp 600

