-- madness layer · stutters, binary blips, drifting delays
-- modulation notes:
--   * stut <n> feedback steptime — n is PATTERN-able: "<2 4 8>" stutters harder
--     every cycle; steptime (1/16) = machine-gun, (1/8) = dub roll
--   * stutWith n t (fn) — each echo gets the transform: (|# speed 1.2) rises in
--     pitch, (|# lpf 800) darkens into dub fog
--   * binary masks: mask "1110111001101010" — 16-bit word as rhythm. Rotate the
--     word itself: mask "<word1 word2 word3>" changes the bit-rhythm each cycle
--   * modulated delay = tape smear: delaytime as a PATTERN, e.g.
--     delaytime (slow 9 $ range (1/12) (1/2) sine) — the echo length breathes
--   * silence the original skeleton (d1/d3) if it fights the binary kick

-- binary kick: the skeleton evolves — 3 rotating 16-bit words, accent via gain
d1 $ swingBy (1/12) 2 $ mask "<1100100010100010 1010001010001010 1101001010001010>" $ s "bd" # gain "0.9 0.6 0.6" # lpf 500

-- shaker stutters: count modulates <2 4 8>, feedback 0.7
d9 $ swingBy (1/12) 2 $ stut "<2 4 8>" 0.7 (1/16) $ whenmod 8 5 (density 1.5) $ struct "t(5,16)" $ s "perc" # gain "0.35 0.55" # hpf 1500

-- stabs pitch-rise into their own echoes
d13 $ swingBy (1/12) 2 $ stutWith 4 (1/12) (\x -> x # speed 1.2) $ struct "t(5,16)" $ s "juno" # note "<c4 g3 e4 a3>" # gain 0.5 # lpf 1200 # delay 0.5 # delaytime (3/8) # delayfeedback 0.65 # pan 0.7 # cut 13

-- binary blips: 3 rotating bit-words, delay length drifting on slow sine
d15 $ mask "<1110111001101010 1011011011101101 1101110010110111>" $ s "bleep" # note "<e6 g6 a6 d6>" # gain 0.25 # pan (slow 3 sine) # room 0.4 # delay 0.5 # delaytime (slow 9 $ range (1/12) (1/2) sine) # delayfeedback 0.8 # cut 15

-- marimba delay goes tape: echo length breathes over 7 cycles
d11 $ swingBy (1/12) 2 $ cat [ s "tok" # note "d5 . a5 . ~ . f5 . ~ a5 . d6 . ~ . c6 .", s "tok" # note "~ . f5 . a5 . c6 . ~ . a5 . g5 . ~ .", s "tok" # note "d5 . g5 . ~ . c6 . ~ a5 . f5 . d5 . ~ .", s "tok" # note "a4 . c5 . e5 . g5 . ~ . a5 . ~ . g5 ." ] # gain 0.65 # lpf 2500 # room 0.75 # size 0.9 # delay 0.55 # delaytime (slow 7 $ range (1/6) (1/2) saw) # delayfeedback 0.8 # cut 11

-- d15 silence
