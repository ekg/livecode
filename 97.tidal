d9 $ tffTheme # s "supermandolin" # gain 0.42 # legato 0.85 # attack 0.006 # hold 0.05 # release 0.6 # hpf 250 # lpf 9000 # pan 0.4 # ddSend 0.1 # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.24 # ddWow 0 # ddCross 1 # verbSend 0.14
