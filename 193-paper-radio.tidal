-- title: 193 PAPER RADIO
-- Ab major, 84 BPM. Lofi instrumental hip-hop. Boom-bap, swung, tape-warmed.
--
-- ALL-NEW PALETTE - nothing shared with 189/190/191/192:
--   chords  mars_synths_DrSample_Rhodes_Chords  (4 LoFi Rhodes chord SAMPLES:
--           Abmaj7 / Am / Bbm7 / Csus4 - played as-is, never transposed)
--   bass    mars_synths_DX100_Bass              Mono Bass C0-C4, n picks octave
--   drums   mars_kits_2600_Kit_2  (BD 2600 04-07, toms 07-12)
--           mars_kits_SDS800_Wonky (Snare SDS800 Tone 01-14, wonky and detuned)
--   guitar  mars_synths_DrSample_Noir           Guitar Noir chops, sparse
--   loop    echobeat                            single loop, tape-warped
--
-- Warmth comes from the TAPE MODULE (tape / tapeHiss / tapeWow), not from gain -
-- this is the first track here to use it, and it is what makes it read as lofi.
--
-- Key note: Ab major is the relative major of 191's F minor, so this still blends
-- (Camelot 4B against 4A), but sits a whole world away in feel.

setcps (84/240)
-- MIXING STANDARD: master 5

-- KICK: 2600 BD, boom-bap placement written as explicit 16th structs (t/f), not
-- euclids and not "~" rests - struct wants booleans, and ~ silently drops.
d1 $ swingBy 0.13 4 $ struct "t f f f f f t f f f t f f f f f" $ s "mars_kits_2600_Kit_2:0" # orbit 8 # gain 1.35 # hpf 32 # lpf 3800 # release 0.22 # tape 0.5 # dry 1

-- CLAP: real claps on two and four (Wendel handclaps cycling with realclaps).
-- NOTE: mars_kits_2600_Kit_2 has NO clap - its indices 4/5 are "Envelope"
-- samples, which sound like blips. Check the folder listing before using an index.
d2 $ swingBy 0.15 4 $ struct "f f f f t f f f f f f f t f f f" $ s "<mars_kits_Wendel_Clean:5 mars_kits_Wendel_Clean:6 realclaps>" # orbit 9 # gain 1.4 # hpf 300 # lpf 7500 # room 0.2 # tape 0.5 # dry 0.92

-- HATS: swung, sparse, dusty. 11-in-16 with a low level.
d3 $ mask "<t t t f t t f t>" $ swingBy 0.16 4 $ s "mars_kits_2600_Kit_2:6(11,16,2)" # orbit 10 # gain 0.42 # hpf 4500 # lpf 12000 # pan (slow 19 $ range 0.35 0.65 sine) # tape 0.7 # dry 0.9

-- TOMS: 2600 toms, very sparse - one hit per bar, answering.
d4 $ swingBy 0.14 4 $ degradeBy 0.15 $ struct "f f t f f f f t f t f f f f t f" $ s "mars_kits_2600_Kit_2:11" # orbit 10 # gain 0.85 # hpf 140 # lpf 5200 # pan (slow 13 $ range 0.35 0.65 sine) # tape 0.6 # room 0.25 # dry 0.9

-- CHORDS: the LoFi Rhodes chord SAMPLES, untransposed. Short release + small room
-- so they do not RING; the space comes from a 3/16 delay instead. n cycles through
-- Abmaj7 (0) / Bbm7 (2) / Csus4 (3) - a ii-III-I vamp that never resolves hard.
d5 $ slow 2 $ sometimesBy 0.1 (|* gain 0.7) $ n "<0 2 3 2>" # s "mars_synths_DrSample_Rhodes_Chords" # orbit 2 # gain 1.05 # hpf 160 # lpf 6500 # room 0.3 # size 0.75 # release 0.5 # tape 0.8 # tapeHiss 0.02 # tapeWow 0.5 # delay 0.4 # delaytime (3/16) # delayfeedback 0.45 # lock 1 # dry 0.6

-- BASS: DX100 mono bass, n per octave. Ab major walk: ab1 / f1 / db2 / eb2.
d6 $ swingBy 0.1 4 $ note "<ab1 ~ ~ ~ eb2 ~ ~ ~> <f1 ~ ~ ~ c2 ~ ~ ~> <db2 ~ ~ ~ ab1 ~ ~ ~> <eb2 ~ ~ ~ bb1 ~ ~ ~>" # n "<1 1 1 1 2 1 1 1>" # s "mars_synths_DX100_Bass" # orbit 1 # gain 1.1 # hpf 45 # lpf 1400 # release 0.3 # tape 0.4 # dry 0.95

-- GUITAR CHOPS: Noir guitar, sparse and backwards sometimes - the lofi "sample
-- flip" gesture. Masked so it appears twice per 8 cycles.
d7 $ mask "<f t f f t f f f>" $ sometimesBy 0.3 (|* speed (-1)) $ sometimesBy 0.2 (|* speed 0.75) $ n "<0 3 5 2 7 1 6 4>" # s "mars_synths_DrSample_Noir" # orbit 3 # gain 0.55 # hpf 250 # lpf 5000 # pan (slow 17 $ range 0.3 0.7 sine) # room 0.6 # size 0.9 # tape 0.7 # dry 0.6

-- LOOP: echobeat, slowed and tape-warped, well under everything.
d8 $ sometimesBy 0.25 (|* speed (-1)) $ every 5 (chunk 4 rev) $ slice 8 "<0 2 5 7 1 4 6 3>" $ loopAt 1 $ s "echobeat" # speed 0.92 # orbit 4 # gain 0.85 # hpf 200 # lpf 6000 # pan 0.58 # tape 0.9 # tapeWow 0.6 # room 0.25 # dry 0.85

-- VINYL-ISH TEXTURE: the 2600 noise samples, very low, gives the surface hiss
-- that makes lofi read as vinyl rather than as a quiet synth.
d9 $ degradeBy 0.5 $ sometimesBy 0.15 (fast 2) $ s "mars_kits_2600_Kit_2:7" # orbit 10 # gain 0.14 # hpf 2000 # lpf 9000 # pan (slow 23 $ range 0.2 0.8 sine) # tapeHiss 0.05 # dry 1

-- ===========================================================================
-- ENERGY + STRUCTURE PASS (live; committed as played)
-- ===========================================================================
-- Polyrhythm: hats 11-in-16, second hat 13-in-16, wonky perc 7-in-16,
-- shaker 5-in-16. None of those divide each other, so the interlock keeps
-- rotating rather than settling.
d10 $ mask "<t t t f t t f t>" $ swingBy 0.1 4 $ s "mars_kits_2600_Kit_2:8(13,16,3)" # orbit 10 # gain 0.32 # hpf 5500 # lpf 13000 # pan (slow 7 $ range 0.2 0.8 sine) # tape 0.7 # dry 0.92

d11 $ mask "<t f t t f t t f>" $ swingBy 0.08 4 $ s "mars_kits_SDS800_Wonky:1(7,16,2)" # orbit 11 # gain 0.3 # hpf 900 # lpf 8000 # pan (slow 11 $ range 0.25 0.75 sine) # tape 0.6 # dry 0.9

-- d12 $ note "<[~ ~ ~ gs5 as5 c6 ~ ~ ~ ~ ~ f6 ~ ~ ~ ~] [~ ~ ~   [DISABLED: MIDI-derived lanes, see notes]

-- 300 BREAKS as the main groove. chop/ NOT loopAt: loopAt re-times the whole
-- file into n cycles (a 20s break squeezed into one bar = chipmunk smear).
-- chop cuts into n chunks at NATURAL speed, and slice picks which lands where.
d13 $ mask "<t t t t t t f t>" $ swingBy 0.12 4 $ sometimesBy 0.15 (|* speed (-1)) $ slice 16 "<0 4 9 2 13 6 11 1 8 14 3 10 5 15 7 12>" $ chop 16 $ s "<pbrk300:28 pbrk300:29 pbrk300:30>" # speed 1 # orbit 5 # gain 1.45 # hpf 50 # lpf 12500 # pan 0.45 # tape 0.65 # dry 0.94

d14 $ mask "<f t t t f t t t>" $ sometimesBy 0.3 (chunk 4 (|* speed (-1))) $ slice 8 "<0 3 6 1 5 2 7 4>" $ chop 8 $ s "<pbrk300:31 pbrk300:32 pbrk300:33>" # speed 1 # orbit 5 # gain 1.15 # hpf 70 # lpf 10000 # pan 0.62 # tape 0.75 # dry 0.92

-- SHARED SAW RAMPS: one slow 8 saw on gain across kick, snare, loops, echobeat,
-- and one slow 16 saw on lpf across the loops. They swell and open TOGETHER -
-- this is the structural device: coordinated, not per-lane.

-- 808 TOM MELODY: 808mt at n 2, gain 1.7. TWO LESSONS HERE:
--   1. a tom needs gain ~1.5+ to compete with breaks at 1.4 - at 1.1 it vanished
--   2. keep the notes in the SAMPLE's octave (ab2-eb3). Asking for ab3-c5 speeds a
--      1s tom up 2-4x, which turns it into a 250ms tick that reads as a click.
d16 $ note "<ab2 ab3 c3 eb3 c3 ab2 ~ ~>" # s "808mt" # n 2 # orbit 7 # gain 1.7 # hpf 50 # lpf 7000 # release 0.3 # pan (slow 15 $ range 0.3 0.7 sine) # room 0.35 # size 0.85 # tape 0.7 # dry 0.75 # delay 0.25 # delaytime (3/16) # delayfeedback 0.35 # lock 1



-- BASS: from the MIDI keyboard (see tools/midi_to_tidal.py). dubsub with fenv 0 -
-- never blip: blip is a sine with a pitch envelope and at bass frequency it
-- reads as a loud blip over the whole mix, not as a bass note.
-- d15 $ swingBy 0.08 4 $ sometimesBy 0.1 (|+ note 12) $ note "  [DISABLED: MIDI-derived lanes, see notes]
