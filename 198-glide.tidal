-- 198 GLIDE — SMOOTH TECHNO. 126 BPM (cps 0.525), A minor, 32-bar form.
--
-- THE IDEA: nothing in this track is allowed to be spiky. Every lane is either a
-- sustained sound with a slow filter, or a hit with a soft attack and room behind
-- it. There is no breakbeat, no stutter, no crush, no shaped distortion. What
-- moves the track is the 32-bar gate arc and a bassline that rolls on 15 of 16
-- sixteenths with the DOWNBEAT LEFT EMPTY, so the kick never fights the bass.
--
-- FORM (8-bar sections, one gate step per section)
--   bars  1-8   kick + closed hats + rolling bass            (intro)
--   bars  9-16  + clap, open hat, shaker                     (lift)
--   bars 17-24  + chord stabs, pad, arp                      (theme)
--   bars 25-32  + texture, arp full, everything open         (peak)
-- Gates are 8 bars because shorter ones read as glitches, not sections (96/99).
--
-- HARMONY: i - VI - III - VII in A minor, held TWO bars each by `slow 2`, so the
-- progression turns over every 8 bars and never squares up with a 4-bar phrase.
--   Am7 [a3 c4 e4 g4]  Fmaj7 [f3 a3 c4 e4]  Cmaj7 [c3 e3 g3 b3]  G6 [g3 b3 d4 e4]
-- The bass walks the roots a1 f1 c2 g1, one per bar, so bass and harmony are the
-- same pitch set and any stab lands on a chord tone.
--
-- VOICES: 909/707 samples for the floor, dubsynth for the rolling bass (saw+sub
-- through a filter envelope = the "roll"), hoRhodes for the stabs (warm, bounded,
-- self-freeing), superfm for the pad, cp4 pluck for the arp, one filtered loop
-- for air. No `amp` anywhere: gain only.
--
-- ORBITS: 0 floor dry (orbit 0 is also the master sidechain detector) | 1 bass dry
--   | 2 stabs into the dub delay | 3 pad + arp into reverb | 4 texture.
--
-- MIXING STANDARD  written for ~masterBootGain = 5. Target master ceiling <= 0.75.
-- @scene {"title":"Glide","cps":0.525,"quantize":4}
-- NO SC BLOCK. The channel mixer therefore keeps its declared defaults and the
-- movement lives entirely in the patterns (the 175 lesson: a modulated channel
-- mixer is where "smooth" turns into "vibrating").

-- Tempo comes from the @scene header (this loader rejects a setcps statement):
-- cps 0.525 = 126 BPM, one Tidal cycle = one 4/4 bar.

-- section gates: one step per 8-cycle section, 4 steps = the 32-bar form.
let gFloor = (slow 16 "<t t t t>") :: Pattern Bool
-- hats and bass belong to the INTRO: the pulse has to be there before anything
let gHat = (slow 16 "<t t t t>") :: Pattern Bool
let gBack = (slow 16 "<f t t t>") :: Pattern Bool
let gBass = (slow 16 "<t t t t>") :: Pattern Bool
let gPerc = (slow 16 "<f t t t>") :: Pattern Bool
let gStab = (slow 16 "<f f t t>") :: Pattern Bool
let gPad = (slow 16 "<f f t t>") :: Pattern Bool
let gArp = (slow 16 "<f f f t>") :: Pattern Bool
let gTex = (slow 16 "<f f f t>") :: Pattern Bool

-- the eight-bar harmony (two bars per chord via slow 2) and the bass roots.
let prog  = "<[a3,c4,e4,g4] [f3,a3,c4,e4] [c3,e3,g3,b3] [g3,b3,d4,e4]>" :: Pattern Note
let roots = "<a4 a4 f4 f4 c5 c5 g4 g4>" :: Pattern Note

-- ORBIT 0: the kick. Steady 909, short release, no send. It is the clock.
d1 $ mask gFloor $ struct "t(4,4)" $ s "mars_kits_909_Clean:0" # orbit 0 # gain 0.72 # hpf 55 # lpf 4200 # release 0.1 # dry 1

-- ORBIT 0: clap on 2 and 4, a touch of room so it sits behind the kick.
d2 $ mask gBack $ s "rolandtr909:4" # orbit 0 # gain (slow 16 $ range 0.5 0.62 sine) # hpf 380 # lpf 7200 # pan 0.5 # release 0.12 # room 0.25 # size 0.6 # dry 0.85

-- ORBIT 0: closed hats on a rotated E(9,16). Nine hits is not four, so the
-- pattern drifts against the kick without ever sounding random.
d3 $ swingBy 0.07 4 $ mask gHat $ s "rolandtr909:2(9,16,4)" # orbit 0 # gain "0.5 0.32 0.4 0.56 0.34 0.42 0.34 0.52 0.32" # hpf 6800 # lpf 13500 # pan (slow 8 $ range 0.44 0.6 sine) # release 0.04 # dry 1

-- ORBIT 0: open hat on the two offbeats, and a second one every third bar.
d4 $ swingBy 0.07 4 $ mask gHat $ every 3 (fast 2) $ struct "~ ~ t ~ ~ ~ t t" $ s "<rolandtr909:3 808oh>" # orbit 0 # gain (slow 8 $ range 0.42 0.55 sine) # hpf 900 # lpf 9500 # sustain 0.14 # release 0.26 # pan 0.56 # dry 0.9 # room 0.2 # size 0.6

-- ORBIT 4: shaker on E(11,16,2), low in the mix — it is glue, not a voice.
d5 $ swingBy 0.07 8 $ mask gPerc $ struct "t(11,16,2)" $ s "sh808" # orbit 4 # gain (slow 13 $ range 0.26 0.34 sine) # hpf 5200 # lpf 14000 # pan (slow 7 $ range 0.35 0.65 sine) # release 0.03 # dry 0.95

-- ORBIT 4: conga cell on E(5,16,3); coprime with the hats' 9 so the two never
-- land together on the same square.
d6 $ swingBy 0.07 8 $ mask gPerc $ sometimesBy 0.2 (fast 2) $ struct "t(5,16,3)" $ s "cn808" # orbit 4 # gain (slow 11 $ range 0.36 0.46 sine) # hpf 320 # lpf 6500 # pan (slow 9 $ range 0.4 0.62 sine) # release 0.09 # room 0.25 # size 0.65 # dry 0.88

-- ORBIT 1: THE ROLL. 15 of 16 sixteenths starting at offset 1 — the downbeat is
-- empty on purpose so the kick's transient is never doubled. Octave pops at 10%,
-- a fifth at 6%, both rare enough to read as playing rather than sequence.
d7 $ mask gBass $ sometimesBy 0.1 (|+ note 12) $ struct "t(15,16,1)" $ note roots # s "dubsynth" # orbit 1 # gain 0.62 # sustain 0.12 # release 0.08 # hpf 40 # dry 1

-- ORBIT 2: chord stabs, held two bars by `slow 2`, on an offset euclid so they
-- fall between the hats. A softer echo copy a quarter cycle later thickens the
-- tail; the delay send carries the rest.
d8 $ swingBy 0.09 4 $ mask gStab $ sometimesBy 0.12 (|+ note 12) $ off 0.25 ((# gain 0.28) . (# lpf 9000)) $ off 0.5 ((# gain 0.12) . (# lpf 2600)) $ struct "t(3,8,2)" $ slow 2 $ note prog # s "hoRhodes" # orbit 2 # gain 0.58 # attack 0.008 # release 1.6 # sustain 0.45 # cutoff (slow 24 $ rangex 1800 4600 saw) # waveMix 0.12 # hpf 260 # pan 0.44 # room 0.5 # size 0.9 # dry 0.6 # delay 0.45 # delaytime (3/16) # delayfeedback 0.45

-- ORBIT 3: pad. Long attack, long release, quiet — it fills the top without
-- competing with the stabs.
d9 $ mask gPad $ slow 2 $ note prog # s "superfm" # orbit 3 # gain (slow 43 $ range 0.12 0.26 sine) # attack 0.7 # release 1.4 # sustain 0.6 # cutoff (slow 32 $ rangex 900 2600 saw) # hpf 200 # lpf 6000 # pan (slow 53 $ range 0.44 0.6 sine) # room 0.6 # size 0.85 # dry 0.4

-- ORBIT 3: the arp. Same chords, arpeggiated up, filtered and delayed, gated to
-- the last section so the theme arrives late and the peak has somewhere to go.
d10 $ mask gArp $ struct "t(7,16,3)" $ note (arp "up" (slow 2 prog)) # s "cp4" # orbit 3 # gain (slow 8 $ range 0.14 0.2 sine) # hpf 700 # lpf (slow 32 $ rangex 2200 6500 saw) # attack 0.002 # release 0.18 # pan (slow 6 $ range 0.4 0.62 sine) # room 0.45 # size 0.85 # dry 0.8 # delay 0.22 # delaytime (3/16) # delayfeedback 0.25

-- ORBIT 4: air. One filtered loop, reordered but never chopped or stuttered —
-- this is the only "texture" and it stays under the drums.
d11 $ mask gTex $ every 5 (chunk 4 (|* speed 1.1)) $ slice 16 "<0 4 9 2 13 6 11 1 8 14 3 10 5 15 7 12>" $ s "lpviz:45" # orbit 4 # gain (slow 37 $ range 0.07 0.16 sine) # speed 0.94 # hpf 400 # lpf (slow 32 $ rangex 1600 5200 saw) # sustain 0.1 # pan (slow 29 $ range 0.45 0.7 sine) # dry 0.85 # room 0.3 # size 0.8
d12 $ swingBy 0.07 4 $ mask gPerc $ every 5 (rotR (1/16)) $ struct "t(3,8,5)" $ s "rolandtr909:5" # orbit 4 # gain (slow 31 $ range 0.14 0.26 sine) # hpf 700 # lpf 8500 # pan (slow 17 $ range 0.62 0.38 sine) # release 0.06 # room 0.25 # size 0.6 # dry 0.88
d13 $ swingBy 0.07 4 $ mask gHat $ every 13 (rotR (1/16)) $ struct "t(7,16,5)" $ s "rolandtr909:2" # orbit 4 # gain (slow 37 $ range 0.08 0.2 sine) # hpf 9500 # lpf 15000 # pan (slow 23 $ range 0.3 0.7 sine) # release 0.03 # dry 0.95
d14 $ swingBy 0.07 8 $ mask gPerc $ sometimesBy 0.25 (fast 2) $ every 7 (rotR (1/16)) $ s "{cn808 t808H}%12" # orbit 4 # gain (slow 29 $ range 0.12 0.24 sine) # hpf 400 # lpf 7000 # pan (slow 19 $ range 0.35 0.65 sine) # release 0.1 # room 0.3 # size 0.7 # dry 0.85
