-- 160 — RAIN ON THE PLATFORM. Companion instrumental, same tempo for A/B mixing.
-- @scene {"title":"Rain on the Platform","cps":0.30833333333333335,"quantize":1}
-- /tidal scene load B 160.tidal, then /tidal scene mix 1 4
{- @sc
scene[\mod].value({ |cycles|
    var breath = (cycles * (2pi / 24)).sin;
    [2100 + (breath * 500), 0.18, 0.16, 0.95];
});
-}

-- A different kick pocket and softer brushed-feeling backbeat.
d1 $ s "p70kick ~ ~ ~ ~ ~ ~ p70kick ~ ~ p70kick ~ ~ ~ ~ ~" # orbit 0 # gain 0.62 # speed 0.9 # lpf 2400 # verbSend 0 # ddSend 0

d2 $ s "~ p70snare ~ p70snare" # orbit 1 # gain 0.38 # speed 0.82 # nudge 0.030 # hpf 220 # lpf 3400 # verbSend 0.07 # room 0.3 # verbT60 0.7 # ddSend 0

d3 $ swingBy 0.19 8 $ s "p70hat ~ p70hat p70hat ~ p70hat p70hat ~" # orbit 2 # gain "0.16 0.09 0.14 0.08 0.15 0.10 0.13 0.08" # speed 0.88 # hpf 2200 # lpf 4800 # pan 0.58 # verbSend 0 # ddSend 0

d4 $ s "~ ~ ~ ~ ~ ~ ~ p70soft" # orbit 3 # gain 0.13 # speed 0.78 # nudge 0.028 # lpf 2800 # verbSend 0 # ddSend 0

d5 $ struct "t ~ ~ ~ ~ t ~ t" $ slow 2 $ n "<a1 f2 d2 e2>" # s "dubsub" # orbit 4 # gain 0.40 # amp 0.75 # drive 0.12 # pitchEnv 0 # sustain 0.25 # release 0.18 # lpf 420 # verbSend 0 # ddSend 0

-- Am9–Fmaj9–Dm9–Em7: a quieter, descending answer to Window Seat.
d6 $ struct "t ~ ~ ~ ~ ~ t ~" $ slow 2 $ n "<[g3,b3,c4,e4] [a3,c4,e4,g4] [f3,a3,c4,e4] [g3,b3,d4,e4]>" # s "hoRhodes" # orbit 5 # gain 0.82 # amp 0.36 # cutoff 2700 # waveMix 0.06 # sustain 1.3 # release 1.8 # pan 0.52 # tape 0.14 # tapeWow 0.10 # tapeHiss 0 # verbSend 0.16 # room 0.4 # verbT60 2.0 # ddSend 0.05 # lock 1 # delaytime 0.125 # delayfeedback 0.2

d7 $ swingBy 0.14 8 $ n "<[~ e5 ~ c5 ~ ~ b4 ~] [~ ~ ~ ~ a4 ~ ~ ~] [~ g5 ~ e5 ~ ~ c5 ~] [~ ~ ~ ~ a4 ~ ~ ~] [~ e5 ~ d5 ~ ~ c5 ~] [~ ~ ~ ~ a4 ~ ~ ~] [~ d5 ~ b4 ~ ~ g4 ~] [~ ~ ~ ~ e4 ~ ~ ~]>" # s "hoRhodes" # orbit 5 # gain 0.65 # cutoff 2500 # waveMix 0.05 # release 0.65 # pan 0.38 # verbSend 0.16 # room 0.4 # verbT60 2.0 # ddSend 0.05 # lock 1 # delaytime 0.125 # delayfeedback 0.2
