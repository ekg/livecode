-- title: 192 NIGHT FERRY
-- C minor, 96 BPM. Half-time hip-hop/funk, not four-on-the-floor.
-- Still blendable from 191 CHAMPION SOUND (F minor 4A): C minor is 5A, one step.
--
-- EVERY VOICE IS A SAMPLE, and every one is multisampled per octave, so `n` picks
-- the sample whose own pitch matches the note and `speed` stays near 1. That is the
-- difference between a sampled instrument and a stretched one.
--
--   drums  mars_kits_SP909_Lo_N_Dirty  (BD B/C/D, SD A08, Rimshot, Clap, CH, OH, Toms)
--   bass   mars_synths_360_Bass        E Bass C0-C4
--   chords mars_synths_DrSample_Upright_Piano  C1-C4
--   lead   mars_synths_360_Trumpet     Muted Trumpet C2-C5
--   perc   bperc / nperc loops
--
-- No blips, no hoRhodes, no superhammond, no dubsub. Two synth voices at most.

setcps (96/240)
-- MIXING STANDARD: master 5

-- KICK: SP909 "BD B". Half-time skeleton - one, and the and-of-three.
d1 $ swingBy 0.09 4 $ s "mars_kits_SP909_Lo_N_Dirty:0(3,8,0)" # orbit 8 # gain 1.25 # hpf 38 # lpf 5500 # release 0.14 # room 0 # dry 1

-- SNARE: SP909 "SD A08" on three - the half-time backbeat. Rimshot answers it.
d2 $ swingBy 0.11 4 $ stack [s "mars_kits_SP909_Lo_N_Dirty:11(2,8,1)" # gain 1.0 # hpf 300 # lpf 7000, struct "t(2,8,7)" $ s "mars_kits_SP909_Lo_N_Dirty:10" # gain 0.35 # pan 0.62] # orbit 9 # gain 1.0 # room 0.18 # dry 0.9

-- HATS: swung 16ths, alternating closed samples, opening on the offbeat.
d3 $ degradeBy 0.06 $ swingBy 0.12 4 $ stack [s "<mars_kits_SP909_Lo_N_Dirty:3 mars_kits_SP909_Lo_N_Dirty:5>(13,16,2)" # gain 0.5, struct "t(2,8,1)" $ s "mars_kits_SP909_Lo_N_Dirty:8" # gain 0.28] # orbit 10 # hpf 5200 # lpf 14000 # pan (slow 17 $ range 0.35 0.65 sine) # dry 0.95 # room 0.1

-- TOMS: SP909 low and mid, sparse, answering the snare.
d4 $ degradeBy 0.2 $ every 5 (rotR (1/8)) $ s "<mars_kits_SP909_Lo_N_Dirty:14 mars_kits_SP909_Lo_N_Dirty:15>" # orbit 10 # gain 0.55 # hpf 150 # lpf 6000 # pan (slow 13 $ range 0.3 0.7 sine) # room 0.25 # dry 0.9

-- BASS: sampled E-Bass, n picks the octave so it is never stretched.
-- C minor walk: c2 / ab1 / eb2 / g1 with passing notes.
d5 $ swingBy 0.08 4 $ sometimesBy 0.15 (|+ note 12) $ note "<c2 ~ eb2 ~ g2 ~ eb2 c2> <ab1 ~ c2 ~ eb2 ~ c2 ab1> <eb2 ~ g2 ~ bb2 ~ g2 eb2> <g1 ~ bb1 ~ d2 ~ bb1 g1>" # n "<2 2 2 2 2 2 2 2>" # s "mars_synths_360_Bass" # orbit 1 # gain 1.1 # hpf 38 # lpf 2400 # release 0.18 # room 0.05 # dry 0.95

-- CHORDS: sampled upright piano. Cm9 / Abmaj7 / Ebmaj7 / Gm7.
-- n 3 for the body of each voicing, 4 for the top note.
d6 $ slow 2 $ sometimesBy 0.08 (|* gain 0.6) $ note "<[c3,eb3,g3,bb3,d4] [ab2,c3,eb3,g3] [eb3,g3,bb3,d4] [g2,bb2,d3,f3]>" # n "<3 3 3 3 4 3 3 3 3 4 3 3 3 4 3 3 3 4>" # s "mars_synths_DrSample_Upright_Piano" # orbit 2 # gain 1.05 # hpf 120 # lpf 7000 # room 0.55 # size 0.9 # dry 0.6

-- LEAD: muted trumpet, phrased in two-bar bursts so it arrives rather than loops.
d7 $ slow 4 $ mask "<t t t f f t t t>" $ sometimesBy 0.15 (|+ note 12) $ note "<c4 ~ eb4 ~ g4 ~ ab4 g4> <eb4 ~ d4 ~ c4 ~ ~ ~>" # n "<4 4 4 4 4 4 5 4 4 4 4 4 4 4 4 4>" # s "mars_synths_360_Trumpet" # orbit 3 # gain 0.95 # hpf 300 # lpf 8000 # pan (slow 19 $ range 0.4 0.6 sine) # room 0.5 # size 0.9 # dry 0.65 # delay 0.3 # delaytime (3/16) # delayfeedback 0.4 # lock 1

-- PERC LOOPS: body percussion and noise perc, sliced fine, low in the mix.
d8 $ degradeBy 0.15 $ every 7 (chunk 4 rev) $ slice 8 "<0 3 5 1 6 2 7 4>" $ loopAt 1 $ s "<bperc nperc>" # speed 0.98 # orbit 4 # gain 0.42 # hpf 700 # lpf 9000 # pan (slow 11 $ range 0.25 0.75 sine) # dry 0.88 # room 0.15

-- CRASH / accent: rare, marks the section turns.
d9 $ mask "<t f f f f f f f f f f f f f f f>" $ s "mars_kits_SP909_Lo_N_Dirty:7" # orbit 10 # gain 0.6 # hpf 400 # lpf 12000 # room 0.5 # dry 0.6

-- ---------------------------------------------------------------------------
-- CHAOS LAYER (added live; committed as-is)
-- ---------------------------------------------------------------------------

-- THIRD BREAK LAYER: pbrk300 25-27, heavily processed. Reversed hits, 1/64
-- stutters, chunk-reverse every 5, crush sweeping 16->12.
d10 $ sometimesBy 0.35 (|* speed (-1)) $ sometimesBy 0.25 (stutWith 3 0.015625 (|* speed 1.5)) $ every 5 (chunk 4 (|* speed (-1))) $ slice 16 "<0 9 4 13 2 11 6 1 8 14 3 10 5 15 7 12>" $ loopAt 1 $ s "<pbrk300:25 pbrk300:26 pbrk300:27>" # speed 0.98 # orbit 11 # gain "<1.1 0.75 1.0 0.68 1.15 0.7 0.95 0.62>" # hpf 120 # lpf 10000 # crush (slow 17 $ range 16 12 saw) # pan (slow 7 $ range 0.2 0.8 sine) # dry 0.9 # room 0.12

-- RIMSHOT GHOSTS: degraded, double-time bursts, rotating.
d11 $ degradeBy 0.3 $ sometimesBy 0.2 (fast 2) $ every 3 (rotR (1/16)) $ s "<mars_kits_SP909_Lo_N_Dirty:10 mars_kits_SP909_Lo_N_Dirty:6>" # orbit 10 # gain 0.4 # hpf 800 # lpf 9000 # pan (slow 11 $ range 0.15 0.85 sine) # room 0.3 # dry 0.85

-- VIBES SPARKLE: triples, backwards every 7, long delay. Top of the track.
d12 $ slow 2 $ sometimesBy 0.25 (ply 3) $ every 7 (rev) $ note "<c5 ~ eb5 ~ g5 ~ bb5 ~>" # n "<4 4 4 4 5 4 5 4>" # s "mars_synths_DX100_Vibes" # orbit 3 # gain 0.55 # hpf 600 # lpf 11000 # release 1.2 # room 0.8 # size 0.95 # dry 0.4 # delay 0.4 # delaytime (3/16) # delayfeedback 0.5 # lock 1

-- PERC LOOP, half speed and backwards, crushed hard.
d13 $ sometimesBy 0.4 (|* speed 0.5) $ every 7 (within (0.5,1) (|* speed (-1))) $ slice 8 "<0 5 2 7 1 6 3 4>" $ loopAt 2 $ s "<bperc nperc>" # speed 0.7 # orbit 4 # gain 0.8 # hpf 400 # lpf 8000 # pan (slow 13 $ range 0.1 0.9 sine) # crush (slow 23 $ range 16 11 saw) # room 0.3 # dry 0.8

-- VOICE STUTTERS: voxdl, 5 slots per 16 cycles, stut 6 at 1/32.
d14 $ mask "<t f f f t f f t f f t f f f t f>" $ sometimesBy 0.3 (stut 6 0.65 (1/32)) $ s "voxdl" # n "<3 11 7 19>" # orbit 12 # gain 1.0 # hpf 300 # lpf 10000 # room 0.45 # delay 0.3 # delaytime (3/16) # delayfeedback 0.4 # lock 1 # dry 0.75

-- SECOND HAT LAYER: 15-in-16, stutters, rotating. Never lines up with the 13.
d15 $ degradeBy 0.1 $ swingBy 0.09 4 $ sometimesBy 0.2 (stutWith 3 0.015625 (|* speed 1.2)) $ every 5 (rotR (1/16)) $ s "mars_kits_SP909_Lo_N_Dirty:4(15,16,3)" # orbit 10 # gain 0.5 # hpf 6000 # lpf 15000 # pan (slow 7 $ range 0.2 0.8 sine) # dry 0.95 # room 0.1

