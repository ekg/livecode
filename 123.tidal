-- 123: TIDAL ESTUARY. 104 BPM; rooted dub with coprime-moving detail.
-- Tune Pile sources: Bob Marley, Could You Be Loved, tabs-tidal
-- Marley_Bob_-_Could_You_Be_Loved.gp3-6387644c.tidal: Bm/D/G/A harmony,
-- Spur 2 bass fragments b2-d3-fs3 and g3-e3-d3; and The Glass of Beer
-- (MontrealSession/reels/4:GLASSOFBEER.abc, K:Bm): eight-bar A/B melodic
-- phrases transposed an octave down. Recomposition, not a cover.
-- Sources: h2o808 kit, p94brkA break, cpluck cp4, cbow cb3s,
-- project dubsub/dubsynth/tapestab + MI Plaits. All autoload at SC boot.
-- Shape: fixed one-drop anchor; independent 5/7/9/11-cycle variation on
-- peripheral voices. Reverb/delay on stabs and fragments, NOT a muddy master.
setcps (104/240)

d1 $ s "< [k808S ~ ~ ~ ~ ~ ~ ~ k808S ~ ~ ~ ~ ~ ~ ~] [k808S ~ ~ ~ ~ ~ k808S ~ k808S ~ ~ ~ ~ ~ ~ ~] >" # gain 0.94 # hpf 32 # lpf 7500 # pan 0.5 # ddSend 0 # verbSend 0.03

d2 $ s "<[~ ~ ~ ~ [s808b,c808] ~ ~ ~ ~ ~ ~ ~ [s808b,c808] ~ ~ ~] [~ ~ ~ ~ [s808b,c808] ~ ~ c808 ~ ~ ~ ~ [s808b,c808] ~ c808 ~] [~ ~ ~ ~ [s808b,c808] ~ ~ ~ ~ ~ c808 ~ [s808b,c808] ~ ~ ~]>" # gain 0.78 # hpf 260 # lpf 12000 # pan 0.47 # ddSend "0 0.45 0 0 0.32 0 0 0" # delaySend 1 # lock 1 # delaytime (3/8) # delayfeedback 0.36 # ddWow 0.1 # ddCross 0.65 # verbSend 0.09

d3 $ every 7 (rev) $ s "sh808(5,16)" # gain "0.18 0.23 0.16 0.2 0.15" # hpf 1300 # lpf 8500 # pan (perlin * 0.28 + 0.36) # ddSend 0.06 # verbSend 0.07

d4 $ every 5 (fast 2) $ s "cn808(3,8)" # gain "0.22 0.3 0.18" # hpf 370 # lpf 7600 # pan "0.28 0.68 0.48" # ddSend 0.18 # delaySend 1 # lock 1 # delaytime (5/16) # delayfeedback 0.33 # ddCross 0.7 # verbSend 0.09

d5 $ n "<[b1 ~ ~ fs2 ~ b1 ~ a1] [b1 ~ ~ fs2 ~ d2 ~ fs2] [g1 ~ ~ d2 ~ g1 ~ fs1] [a1 ~ ~ e2 ~ a1 ~ fs1]>" # s "dubsub" # amp 0.5 # drive 0.29 # pitchEnv 0.22 # gain 0.65 # pan 0.5 # ddSend "0 0 0.18 0" # delaySend 1 # lock 1 # delaytime (3/8) # delayfeedback 0.3 # verbSend 0.03

d6 $ silence

d7 $ every 11 (rev) $ n "<[~ b3 ~ d4 ~ fs4 ~ ~] [~ a3 ~ d4 ~ fs4 ~ ~] [~ g3 ~ b3 ~ d4 ~ ~] [~ a3 ~ cs4 ~ e4 ~ ~]>" # s "tapestab" # amp 0.3 # gain 0.34 # hpf 260 # lpf 7200 # pan 0.68 # ddSend "0 0 0.5 0" # delaySend 1 # lock 1 # delaytime (5/16) # delayfeedback 0.43 # ddWow 0.22 # ddCross 0.75 # verbSend 0.19

d8 $ degradeBy 0.72 $ s "cp4(5,16)" # speed "<1 1.1225 1.4983 1.6818>" # gain 0.24 # hpf 310 # lpf 4900 # pan 0.64 # ddSend 0.22 # delaySend 1 # lock 1 # delaytime (3/8) # delayfeedback 0.33 # ddCross 0.5 # verbSend 0.15

d9 $ n "<[b3,d4,fs4,cs5] [d4,fs4,a4,e5] [g3,b3,d4,a4] [a3,cs4,e4,b4]>" # s "sweetChords" # amp 0.52 # cutoff (slow 13 $ range 2600 5300 sine) # fmIndex 0.3 # release 0.8 # gain 0.52 # hpf 170 # lpf 10800 # pan 0.48 # ddSend "0 0 0.28 0" # delaySend 1 # lock 1 # delaytime (3/8) # delayfeedback 0.27 # verbSend 0.17

d10 $ silence

d11 $ every 7 (rev) $ s "c808(5,16)" # gain "0.26 0.34 0.2 0.3 0.23" # hpf 1100 # lpf 11500 # pan 0.68 # ddSend "0 0 0 0.45 0" # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.28 # verbSend 0.06

d12 $ silence
