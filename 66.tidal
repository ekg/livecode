-- 66: PRISM CHOIR. Brighter 102-BPM pop-house lift; standalone scene.
-- Like A Prayer's vocal fragment meets the Tears for Fears figure (+3 semitones).
-- Fmaj9 / Cadd9 / Dm9 / Bbmaj9; new bass and dance production.

setcps (102/240)

d1 $ s "bd*4" # gain 0.8

d2 $ s "~ sn ~ sn" # gain 0.57 # hpf 200 # ddSend 0.08 # lock 1 # delaytime (3/16) # delayfeedback 0.4

d3 $ s "[hh hh hh [hh hh]]*2" # gain "0.26 0.4 0.3 0.42" # hpf 2200 # pan "0.3 0.7"

d4 $ s "~ cp ~ cp" # gain 0.39 # hpf 1000 # ddSend 0.23 # lock 1 # delaytime (3/16) # delayfeedback 0.44

d5 $ n "<[f3 ~ c4 f3 ~ a3 c4 ~] [c3 ~ g3 c3 ~ e3 g3 ~] [d3 ~ a3 d3 ~ f3 a3 ~] [as2 ~ f3 as2 ~ d3 f3 ~]>" # s "dubsub" # gain 0.66 # legato 0.32 # lpf 850

d6 $ n "<[f4,a4,c5,e5,g5] [e4,g4,c5,d5] [f4,a4,c5,e5] [f4,a4,as4,d5]>" # s "superpiano" # gain 0.57 # legato 0.95 # lpf 4700 # verbSend 0.16 # verbHp 600

d7 $ slow 2 $ n "f5 ~ f5 f5 e5 ~ ~ f5 g5 ~ e5 ~ f5 e5 ~ ~" # s "supersaw" # gain 0.51 # legato 0.7 # lpf (slow 8 $ range 2200 4700 sine) # ddSend 0.17 # lock 1 # delaytime (3/16) # delayfeedback 0.42 # verbSend 0.12

d8 $ slow 2 $ n "~ ~ a5 ~ c6 ~ a5 ~ d6 ~ a5 ~ c6 ~ a5 c6" # s "supervibe" # gain 0.48 # legato 0.65 # hpf 600 # lpf 4100 # pan 0.65 # ddSend 0.28 # lock 1 # delaytime (5/16) # delayfeedback 0.45

d9 $ n "<[f5 a5 c6 a5] [e5 g5 c6 g5] [f5 a5 d6 a5] [f5 as5 d6 as5]>" # s "supermandolin" # gain 0.38 # legato 0.3 # lpf 3800 # pan 0.3 # ddSend 0.17 # lock 1 # delaytime (7/16) # delayfeedback 0.48

d10 $ n "<[a4,c5,e5] [g4,c5,d5] [a4,c5,e5] [a4,as4,d5]>" # s "superhammond" # gain 0.29 # legato 0.9 # lpf 1900 # hpf 400 # verbSend 0.2

d11 $ every 8 (fast 2) $ s "clak(3,8)" # gain 0.27 # pan "0.25 0.75" # hpf 1600 # ddSend 0.26 # lock 1 # delaytime (3/16) # delayfeedback 0.45

d12 $ silence
