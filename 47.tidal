-- gospel glitch · 96bpm · BWV 101.7 (d-minor chorale) over a spaced-out glitch beat
-- the pattern: the chorale unfolds SLOW (16 bars over 8 cycles, slow 8) while the
-- beat is sparse quarter-note kicks with Tidal-modulated glitch stutters.
-- glitch sources (all Tidal modulations): stut cascades on the hats, bitcrushed
-- euclid percussion with rotating offsets, 32nd-note stutter cascades on click,
-- and the TENOR voice glitched (stut + crush) inside the choir itself.
-- modulation notes:
--   * d3 sometimesBy 0.3 (stut 12 0.35 (1/32)) = the hat stutter — raise rate for panic
--   * d15 struct "t(<3 5>,16,<0 4>)" — the euclid grid alternates 3/16 and 5/16 and
--     rotates its offset: the glitch rhythm never repeats the same way twice
--   * d12 is Bach's tenor, glitched (stut 8 + crush 6) — the choir breaking up
--   * slow 8 on all voices keeps SATB locked together; change all four at once
--   * d1: one kick per bar. add a second kick ("bd ~ ~ ~ ~ ~ ~ bd") to tighten
do
  hush
  setcps (96/60/8)
  d1 $ s "bd ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~" # gain 0.95 # lpf 900
  d3 $ sometimesBy 0.3 (stut 12 0.35 (1/32)) $ s "hh ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ hh ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~" # gain 0.6 # hpf 3000
  d15 $ struct "t(<3 5>,16,<0 4>)" $ s "perc" # gain 0.5 # crush 5 # hpf 2000 # cut 15
  d16 $ sometimesBy 0.12 (stut 16 0.35 (1/32)) $ s "click" # gain 0.45 # hpf 5000 # cut 16
  d10 $ slow 8 $ n "69 ~ ~ ~ 69 ~ ~ ~ 65 ~ ~ ~ 67 ~ ~ ~ 69 ~ ~ ~ 65 ~ ~ ~ 64 ~ ~ ~ 62 ~ ~ ~ 69 ~ ~ ~ 69 ~ ~ ~ 67 ~ ~ ~ 72 ~ ~ ~ 69 ~ ~ ~ 65 ~ ~ ~ 67 ~ ~ ~ 69 ~ ~ ~ 69 ~ ~ ~ 72 ~ ~ ~ 74 ~ 76 ~ 77 ~ ~ ~ 76 ~ ~ ~ 74 ~ ~ ~ 73 ~ ~ ~ 74 ~ ~ ~ 74 ~ ~ ~ 76 ~ ~ ~ 74 ~ ~ ~ 72 ~ ~ ~ 71 ~ ~ ~ 69 ~ ~ ~ 71 ~ ~ ~ 69 ~ ~ ~ 74 ~ ~ ~ 72 ~ ~ ~ 71 ~ ~ ~ 72 ~ ~ ~ 69 ~ ~ ~ 69 ~ ~ ~ 67 ~ ~ ~ 65 ~ ~ ~ 69 ~ ~ ~ 70 ~ ~ ~ 69 ~ 67 ~ 65 ~ ~ ~ 67 ~ ~ ~ 65 ~ ~ ~ 64 ~ ~ ~ 62 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~" # s "superpiano" # gain 0.8 # room 0.85 # size 0.95 # cut 10
  d11 $ slow 8 $ n "65 ~ ~ ~ 64 ~ ~ ~ 62 ~ ~ ~ 62 ~ ~ ~ 62 ~ ~ ~ 62 ~ ~ ~ 61 ~ ~ ~ 57 ~ ~ ~ 65 ~ ~ ~ 65 ~ ~ ~ 67 ~ 65 ~ 64 ~ ~ ~ 65 ~ ~ ~ 62 ~ ~ ~ 62 ~ ~ ~ 61 ~ ~ ~ 62 ~ ~ ~ 64 ~ ~ ~ 67 ~ ~ ~ 69 ~ ~ ~ 67 ~ ~ ~ 65 ~ 67 ~ 69 ~ ~ ~ 69 ~ ~ ~ 67 ~ ~ ~ 67 ~ ~ ~ 66 ~ 68 ~ 69 ~ ~ ~ 64 ~ ~ ~ 64 ~ 69 ~ 69 ~ 68 ~ 64 ~ ~ ~ 62 ~ ~ ~ 64 ~ ~ ~ 65 ~ ~ ~ 67 ~ ~ ~ 65 ~ ~ ~ 65 ~ ~ ~ 64 ~ ~ ~ 60 ~ ~ ~ 62 ~ ~ ~ 62 ~ ~ ~ 61 ~ ~ ~ 62 ~ ~ ~ 64 ~ ~ ~ 61 ~ 62 ~ ~ ~ 61 ~ 57 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~" # s "superpiano" # gain 0.65 # room 0.6 # cut 11
  d12 $ slow 8 $ sometimesBy 0.12 (stut 8 0.4 (1/32)) $ n "62 ~ ~ ~ 57 ~ ~ ~ 57 ~ ~ ~ 58 ~ ~ ~ 57 ~ ~ ~ 58 ~ ~ ~ 52 ~ ~ ~ 53 ~ ~ ~ 62 ~ ~ ~ 60 ~ ~ ~ 60 ~ ~ ~ 60 ~ ~ ~ 60 ~ ~ ~ 58 ~ ~ ~ 50 ~ ~ ~ 52 ~ ~ ~ 53 ~ ~ ~ 57 ~ ~ ~ 58 ~ ~ ~ 60 ~ ~ ~ 58 ~ 60 ~ 62 ~ ~ ~ 64 ~ ~ ~ 65 ~ ~ ~ 59 ~ ~ ~ 60 ~ 59 ~ 57 ~ ~ ~ 62 ~ ~ ~ 62 ~ ~ ~ 60 ~ ~ ~ 62 ~ ~ ~ 60 ~ ~ ~ 55 ~ ~ ~ 55 ~ ~ ~ 62 ~ ~ ~ 60 ~ ~ ~ 60 ~ ~ ~ 62 ~ ~ ~ 55 ~ ~ ~ 57 ~ ~ ~ 57 ~ ~ ~ 55 ~ 53 ~ 52 ~ ~ ~ 58 ~ ~ ~ 58 ~ ~ ~ ~ ~ 57 ~ 55 ~ 57 ~ 54 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~" # s "superpiano" # gain 0.65 # crush 6 # cut 12
  d13 $ slow 8 $ n "50 ~ ~ ~ 49 ~ ~ ~ 50 ~ ~ ~ 58 ~ ~ ~ 53 ~ ~ ~ 55 ~ ~ ~ 57 ~ ~ ~ 50 ~ ~ ~ 50 ~ 52 ~ 53 ~ ~ ~ 52 ~ ~ ~ 57 ~ ~ ~ 53 ~ ~ ~ 58 ~ ~ ~ 46 ~ ~ ~ 45 ~ ~ ~ 50 ~ ~ ~ 57 ~ ~ ~ 55 ~ ~ ~ 53 ~ ~ ~ 55 ~ 57 ~ 58 ~ ~ ~ 57 ~ ~ ~ 50 ~ ~ ~ 55 ~ ~ ~ 48 ~ ~ ~ 50 ~ 52 ~ 54 ~ ~ ~ 56 ~ ~ ~ 57 ~ ~ ~ 52 ~ ~ ~ 45 ~ ~ ~ 47 ~ ~ ~ 48 ~ ~ ~ 50 ~ ~ ~ 52 ~ ~ ~ 53 ~ ~ ~ 46 ~ ~ ~ 48 ~ ~ ~ 41 ~ ~ ~ 42 ~ ~ ~ 43 ~ ~ ~ 45 ~ ~ ~ 46 ~ ~ ~ 45 ~ 43 ~ 45 ~ ~ ~ 45 ~ ~ ~ 50 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~" # s "superpiano" # gain 0.85 # room 0.4 # cut 13
  -- d1 silence
  -- d3 silence
  -- d10 silence
  -- d11 silence
  -- d12 silence
  -- d13 silence
  -- d15 silence
  -- d16 silence
