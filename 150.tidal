-- 150: THE DRIVING ONE — dub house in D MINOR, cps 0.54 (~130 BPM).
-- 4/4 foundation where EVERY layer is a genuine Euclidean pattern; kick, bass
-- and melody each take a different (p,k) and the layers are rotated against each
-- other, so the pulse is built by the ensemble rather than one wall of hits.
--   d1  kick       E(4,8) 4-on-the-floor       + ghost E(7,16) at low gain
--   d2  snare      E(2,4,1)  -> backbeat on 2 & 4 (E(2,4) rotated by 1)
--   d8  clap       E(2,4)    -> on 1 & 3, so it leans against the snare
--   d3  hats       E(11,16) family, rotation alternating each bar
--   d4  bass       E(5,8,2)  -> off-grid against the kick, D minor walk
--   d6  melody     E(7,16)   -> carved into the bass's gaps (see below)
--   d7  cabasa/tamb E(7,16,3)/E(3,8,2)
--   d11 perc       E(3,8)
--   d13 sub        E(4,8,1)  -> fires on the offbeats
-- KEY / VOICES: D natural minor (d e f g a bb c).  [REPLACED: no voices in this set - plucked/bowed strings instead]
--   BASS (d4) is `dubsynth` kept in bass-guitar register (d2-a2, not d1) with a
--   short envelope (sustain 0.16 / release 0.14) — the low detuned-saw + sine-sub
--   at d1 is the "fart bass" (see 146/147). The real low end is the sub.
--   SUB (d13) is `dubsub`, a sine voice: it takes a real freq via `note`, so it  [REPLACED: no voices in this set - plucked/bowed strings instead]
--   carries the actual d1/f1/g1/a1 roots with no sample-rate trap.
--   MELODY (d6) is `hoRhodes` HOCKETED against the bass: the E(7,16) rhythm is
--   sampled through a 16-step note lane whose rests sit ON the bass onsets
--   (bass E(5,8,2) hits 16ths 0/2/6/8/12; the lane is silent there), so the
--   melody only speaks in the bass's gaps. `struct` supplies the rhythm and
--   samples the lane for pitch, so the line moves per hit.
-- SPACE comes from REMOVING hits, not reverb: kit is DRY (no verbSend/ddSend),
--   only pad and melody get a little verb. Voices (d14) are gated to 1 bar in 4.  [REPLACED: no voices in this set - plucked/bowed strings instead]
-- MASTER: a slow DUCKING swell (mDuck) plus a moving lowpass (mCut) ride the
--   kick events, so the values lag and glide; mGain pinned at 0.93.
setcps 0.54

let swing = (# nudge (fast 8 $ "0 1" * (slow 16 $ range 0 0.06 sine)))

-- d1 KICK: E(4,8) four on the floor (straight, nudge=0 on the grid) + a low-gain
-- ghost E(7,16). Carries the master modulation (ducking swell + moving lowpass).
d1 $ swing $ stack [s "808bd(4,8)" # gain 0.9 # shape 0.6 # hpf 46 # release 0.09, s "808bd(7,16)" # gain 0.28 # shape 0.4 # hpf 70 # release 0.05] # mGain 0.93 # mDuck (slow 8 $ range 0.25 0.55 saw) # mCut (slow 24 $ range 4500 10000 sine) # verbSend 0 # ddSend 0

-- d2 SNARE: E(2,4,1) - euclid 2-in-4 rotated by 1 -> lands on beats 2 & 4.
d2 $ swing $ s "drumtraks:9(2,4,1)" # gain 0.75 # hpf 420 # shape 0.2 # release 0.08 # verbSend 0 # ddSend 0

-- d3 HATS: 11-in-16 with the rotation flipped each bar, so the accents creep.
d3 $ swing $ s "<drumtraks:4(11,16) drumtraks:4(11,16,5) drumtraks:4(13,16,3) drumtraks:4(9,16,7)>" # gain "<0.3 0.24>" # hpf 2000 # lpf 9000 # pan 0.6 # verbSend 0 # ddSend 0

-- d4 BASS: dubsynth on E(5,8,2) - off the kick grid; D minor walk, bass-guitar register.
d4 $ swing $ struct "t(5,8,2)" $ note "<[d2 f2 g2 a2] [d2 f2 a2 g2] [d2 g2 f2 a2] [d2 f2 g2 a2]>" # s "dubsynth" # waveMix 0.18 # cutoff 420 # fenv 2.2 # drive 0.35 # sustain 0.16 # release 0.14 # lpf 1800 # gain 0.6 # verbSend 0 # ddSend 0

-- d5 PAD: hoRhodes, slow 2, Dm - Gm - Am - F. Space is a held chord, not reverb.
d5 $ swing $ slow 2 $ note "<[d3,f3,a3] [g3,bb3,d4] [a3,c4,e4] [f3,a3,c4]>" # s "hoRhodes" # gain 0.55 # cutoff 3800 # release 1.4 # verbSend 0.25 # room 0.5 # size 0.55 # ddSend 0

-- d6 MELODY: hoRhodes on E(7,16), hocketed - the 16-step lane rests where the
-- bass fires (16ths 0/2/6/8/12), so melody answers in the gaps. Two lanes alternate.
d6 $ swing $ struct "t(7,16)" $ note "<[~ ~ ~ a4 ~ d5 ~ f4 ~ ~ e5 ~ ~ ~ c5 ~] [~ ~ ~ e5 ~ g5 ~ d5 ~ ~ f5 ~ ~ ~ d5 ~]>" # s "hoRhodes" # gain 0.68 # cutoff 4200 # release 1.0 # verbSend 0.22 # room 0.5 # size 0.55 # ddSend 0

-- d7 CABASA / TAMBOURINE: E(7,16,3) cabasa alternating with E(3,8,2) tambourine.
d7 $ swing $ s "<drumtraks:0(7,16,3) drumtraks:0(3,8,2) drumtraks:10(7,16,3) drumtraks:0(5,16,1)>" # gain 0.24 # hpf 2400 # lpf 10000 # pan 0.45 # verbSend 0 # ddSend 0

-- d8 CLAP: E(2,4) on beats 1 & 3, leaning against the snare's 2 & 4. Dry.
d8 $ swing $ s "drumtraks:1(2,4)" # gain 0.5 # hpf 750 # lpf 7200 # release 0.09 # verbSend 0 # ddSend 0

d9 $ silence

-- d10 DX100 VIBES counter-line: E(3,8,2), sparse top thread over the bass.
d10 $ swing $ s "mars_synths_DX100_Vibes(3,8,2)" # n 0 # note "<a4 d5 f5 e5 c5 a4 g4 f4>" # gain 0.5 # hpf 300 # lpf 5000 # verbSend 0.2 # ddSend 0.15 # lock 1 # delaytime (3/16) # delayfeedback 0.2

-- d11 PERC: ghatam E(3,8). Dry.
d11 $ swing $ s "p93perc(3,8)" # gain 0.32 # hpf 500 # lpf 6500 # pan 0.42 # release 0.2 # verbSend 0 # ddSend 0

-- d12 DX100 SINE: E(5,16,3) high thread, doubled every 4th pass.
d12 $ swing $ every 4 (fast 2) $ s "mars_synths_DX100_Sine(5,16,3)" # n 0 # note "<d5 f5 a5 g5 e5 d5 c5 a4>" # gain 0.42 # hpf 400 # lpf 6000 # verbSend 0.3 # room 0.5 # size 0.6 # ddSend 0.25 # lock 1 # delaytime (3/16) # delayfeedback 0.3

-- d13 SUB: dubsub on E(4,8,1) - fires on the offbeats, real freqs on the roots.
d13 $ swing $ s "dubsub(4,8,1)" # note "d1 f1 g1 a1" # drive 0.6 # pitchEnv 0.5 # legato 1.6 # sustain 0.28 # release 0.25 # amp 0.85 # gain 0.6 # hpf 26 # lpf 210 # verbSend 0 # ddSend 0

-- d14 VOICES: NO VOICES - string line the lpviz loop (slice 16), n 169-200 lane, open 1 bar in 4.  [REPLACED: no voices in this set - plucked/bowed strings instead]
d14 $ swing $ euclidOff 7 16 3 $ note "<d4 f4 a4 g4 f4 d4 c4 d4>" # s "cb4" # gain 0.42 # hpf 250 # lpf 4800 # pan 0.55 # verbSend 0.25 # room 0.5 # size 0.55 # ddSend 0.15 # lock 1 # delaytime (3/16) # delayfeedback 0.25

d15 $ silence

d16 $ silence

-- END 150.tidal
