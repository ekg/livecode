-- jazz house · 122bpm · house + funk kit + hoover weirdness + real jazz head
-- the lead is a REAL jazz tune pulled from the tab corpus, not composed by hand:
--   "Affirmation" (George Benson), key D major, 4/4 — converted with
--   tunepile/tools/gp_to_tidal.py <tab> --bars 8 --part 0
--   same key as the house (D-G-A-D loop), so it drops straight in with no transposition.
-- structure:
--   cycle = 2 bars at setcps (122/60/8) = 0.254
--   d1-d5  house floor + the funk performance's snare/hats (human velocity), DRY
--   d6     offbeat moog bass on d/g (bars 1-2 of the D-G-A-D loop)
--   d7     chords, pulled to 0.45 so the jazz line sits on top
--   d8     hoover stabs on t(3,16) — the weird
--   d9     harmonium ostinato as the rhythmic drive (cpluck, 0.4)
--   d10    THE MELODY: Affirmation head, 8 bars over 4 cycles (slow 4), swung
-- modulation notes:
--   * d10 swingBy (1/12) 2 is the jazz feel. drop swingBy for straight house
--   * d10 slow 4 = 8 bars of tune over 4 cycles. slow 2 tightens to 4 bars,
--     slow 8 stretches to 16 bars; the phrase length is the main expressive knob
--   * swap the tune: any converted tab works, e.g. Kenny Burrell "Soul Lament"
--     (E minor — transpose with |+ note 2 for D), via --bars 8 --part 0
--   * to let the melody lead harder: d10 gain 0.65 -> 0.8, d7 chords -> 0.35
do
  hush
  setcps (122/60/8)
  d1 $ s "bd*8" # gain 0.85 # lpf 900
  d2 $ s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ sn sn sn sn sn ~ ~ ~ ~ sn ~ ~ sn ~ sn ~ sn sn ~ ~ sn" # gain "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 0.34 0.36 0.61 0.57 0.56 ~ ~ ~ ~ 0.59 ~ ~ 0.57 ~ 0.47 ~ 0.40 0.60 ~ ~ 0.60"
  d3 $ s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ hh ~ ~ hh hh hh hh hh hh hh hh hh hh hh hh hh hh hh" # gain "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 0.66 ~ ~ 0.44 0.61 0.42 0.53 0.52 0.56 0.63 0.55 0.53 0.55 0.50 0.55 0.51 0.61 0.64" # hpf 1200
  d4 $ s "~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~ ~ ~ 808oh ~" # gain 0.55 # hpf 400
  d5 $ sometimesBy 0.3 (# speed 1.5) $ s "~ ~ ~ ~ cp ~ ~ ~ ~ ~ ~ ~ cp ~ ~ ~ ~ ~ ~ ~ cp ~ ~ ~ ~ ~ ~ ~ cp ~ ~ ~" # gain 0.7
  d6 $ s "moog" # note "~ ~ d1 ~ ~ ~ d1 ~ ~ ~ d1 ~ ~ ~ d1 ~ ~ ~ g0 ~ ~ ~ g0 ~ ~ ~ g0 ~ ~ ~ g0 ~" # gain 0.85 # lpf 260 # room 0.2 # cut 6
  d7 $ fast 2 $ cat [s "superpiano" # note "38 50 54 57 61 64", s "superpiano" # note "43 55 59 62 66 69", s "superpiano" # note "45 57 61 64 67 71", s "superpiano" # note "38 50 54 57 61 64"] # gain 0.45 # lpf 1400 # room 0.6 # size 0.9 # cut 7
  d8 $ sometimesBy 0.4 rev $ struct "t(3,16)" $ s "hoover" # note "<d3 a2>" # gain 0.45 # lpf 1800 # room 0.6 # size 0.85 # delay 0.45 # delaytime (1/3) # delayfeedback 0.6 # cut 8
  d9 $ slow 4 $ n "66 ~ 62 ~ 67 ~ 62 ~ 66 ~ 62 ~ 62 ~ 62 ~ 66 ~ 62 ~ 67 ~ 62 ~ 66 ~ 62 ~ 62 ~ 62 ~ 66 ~ 62 ~ 67 ~ 62 ~ 66 ~ 62 ~ 62 ~ 62 ~ 64 ~ 62 ~ 61 ~ 62 ~ 66 ~ 62 ~ 62 ~ 62 ~ 64 ~ 62 ~ 61 ~ 62 ~ 64 ~ 62 ~ 61 ~ 62 ~ 66 ~ 62 ~ 60 ~ 62 ~ 66 ~ 62 ~ 60 ~ 62 ~ 67 ~ 62 ~ 64 ~ 62 ~ 61 ~ 62 ~ 67 ~ 62 ~ 66 ~ 62 ~ 62 ~ 62 ~ 62 ~ ~ ~ ~ ~ ~ ~" # s "cpluck" # gain 0.4 # room 0.6 # size 0.85 # delay 0.3 # delaytime (1/4) # delayfeedback 0.45 # cut 9
  d10 $ swingBy (1/12) 2 $ slow 4 $ n "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 57 59 61 62 64 64 66 ~ 66 ~ 64 69 ~ 69 ~ 71 ~ 66 67 ~ ~ 64 66 ~ 66 ~ 64 69 ~ 69 71 67 69 66 67 64 66 64 ~ ~ 64 64 ~ 62 ~ 62 ~ ~ ~ ~ 54 57 59 [61,64] ~ ~ [61,64] [61,64] ~ [59,62] ~ [49,50] 54 [57,61] 57 59 57 54 [47,50] 40 ~ ~ 66 66 64 69 ~ 69 ~ 67 ~ 66 64 ~ ~ 64 66 ~ 66 ~ 64 69 ~ 69 ~ 67 ~ 66 64 ~ ~ 64 ~ ~ 64 64 ~ 62 ~ 64 ~ ~ ~ ~ 54 57 59" # s "superpiano" # gain 0.65 # room 0.7 # size 0.9 # delay 0.3 # delaytime (1/4) # delayfeedback 0.4 # cut 10
  -- d1 silence
  -- d2 silence
  -- d3 silence
  -- d4 silence
  -- d5 silence
  -- d6 silence
  -- d7 silence
  -- d8 silence
  -- d9 silence
  -- d10 silence
