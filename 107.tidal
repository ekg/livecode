-- 107: NEW CHORDS + LOUDER EUCLIDEAN DRUMS.
-- d9 chords are now the Daft Punk "Something About Us" progression, 8 distinct chords
-- transposed C->D: G-B-E / A-B-D / B-D-F# / A-C#-E / G-B-E / A-B-D# / B-E-A / B-E-G.
-- One chord per bar, 8-bar cycle.
-- Euclidean drum gates opened and gains raised ~35% - they were building from silence.
-- Parent 106.tidal. Needs sc/samples94.scd, sosBell, sc/chords.scd.

let prog107 = slow 8 $ n "<[g4,b4,e5] [a4,b4,d5] [b4,d5,fs5] [a4,cs5,e5] [g4,b4,e5] [a4,b4,ds5] [b4,e5,a5] [b4,e5,g5]>"

let sd102 = slow 16 $ up "14 ~ ~ ~ 18 ~ ~ ~ 21 ~ ~ 26 ~ ~ ~ ~ 11 ~ 11 ~ 14 13 14 ~ 18 17 18 23 ~ ~ ~ ~ 10 ~ 10 ~ 14 ~ 14 ~ 17 16 17 ~ 22 ~ ~ 21 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 14 ~ ~ ~ 18 ~ ~ ~ 21 ~ ~ 26 ~ ~ ~ ~ 11 ~ 11 ~ 14 13 14 ~ 18 17 18 23 ~ ~ ~ ~ 10 ~ 10 ~ 14 ~ 14 ~ 17 16 17 ~ 22 ~ ~ 21 ~ ~ ~ 21 18 21 ~ ~"
let tffTheme = slow 16 $ n "~ ~ ~ ~ ~ ~ d5 ~ cs4 ~ e4 ~ a4 ~ b3 ~ [e3,a3,d4,g4,b4,e5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ [d4,g4,b4] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ [d4,g4,b4] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ [d4,g4,b4] ~ ~ ~ ~ ~ ~ ~ [d4,a4,cs5] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
let air103 = slow 4 $ n "c5 c5 fs4 a3 d3 ~ g4 e4 c4 e4 g4 d4 d4 ~ fs3 d4 d4 d3 a4 fs4 b4 ~ a4 d4 e4 b3 a4 b4 b4 ~ c5 d5 d5 ~ fs5 d5 b4 ~ a4 d4 e4 b3 fs4 d4 g3 b3 fs3 d4 d4 d3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
let lpvPerc = loopAt 1 $ s "p93perc"
let lpvMel = loopAt 1 $ s "p93arp"
let lpvStr = loopAt 1 $ s "p93str"

setcps (104/240)

d1 $ sometimesBy 0.25 (striate 3) $ struct "t(7,16)" $ loopAt 1 $ s "p93perc" # gain ("0.34 0 0 0 0 0.28 0 0 0 0 0 0.3 0 0 0 0" * slow 8 "<0 0.4 0.7 0.9 1 1 0.8 1>") # hpf 800 # lpf 15000 # cut 8 # pan "<0.25 0.7 0.45 0.6>" # ddSend 0.08 # delaySend 1 # lock 1 # delaytime (7/16) # delayfeedback 0.26 # ddWow 0 # ddCross 1 # verbSend 0.12
d2 $ struct "<t(3,8) t(5,8) t(7,16) t(5,8,2)>" $ s "p70kick" # gain ("1.0 0.85" * slow 8 "<0.75 0.9 1 1 1 1 1 1>") # hpf 55 # lpf (slow 16 $ range 2500 6000 sine) # pan 0.5 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0
d3 $ sometimesBy 0.2 (|+ up 12) $ struct "<t(5,16) t(7,16) t(9,16) t(11,16)>" $ s "p93perc" # gain ("0.6 0 0 0.48" * slow 8 "<0.6 0.8 1 1 1 1 1 1>") # hpf 750 # lpf 15000 # cut 8 # pan "<0.3 0.65 0.5 0.7>" # ddSend 0.08 # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.26 # ddWow 0 # ddCross 1 # verbSend 0.12
d4 $ every 4 (# pan "<0.6 0.45 0.7 0.5>") $ struct "<t(7,8) t(11,16) t(13,16) t(15,16)>" $ s "p70hat" # gain ("0.58 0.4" * slow 8 "<0.7 0.9 1 1 1 1 1 1>") # hpf 1700 # lpf 18000 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0
d5 $ sometimesBy 0.12 (|+ up 12) $ sd102 # s "p76bass" # gain "0.78 0.55 0.68 0.5" # attack 0.003 # hold 0.03 # release 0.15 # hpf 45 # lpf (slow 16 $ range 1800 3600 sine) # pan 0.5 # ddSend 0 # delaySend 0 # delayfeedback 0 # verbSend 0
d6 $ jux (# pan 0.75) $ lpvMel # gain ("0 0 0 0 0.6 0 0 0 0 0.54 0 0 0 0 0.58 0" * slow 8 "<0 0 0 0 0 0.6 0.85 1>") # attack 0.006 # hold 0.04 # release 0.18 # hpf 250 # lpf (slow 32 $ range 6000 14000 sine) # cut 6 # ddSend 0.1 # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.26 # ddWow 0 # ddCross 1 # verbSend 0.14
d7 $ silence
d8 $ silence
d9 $ jux rev $ prog107 # s "sweetChords" # amp 0.63 # cutoff (slow 16 $ range 3200 7000 sine) # release 1.6 # detune "<0.01 0.01 0.015 0.007>" # fmIndex "<1.2 1.2 1.7 0.9>" # drive 1.4 # gain (0.5 * slow 8 "<0 1 1 1 1 1 1 1>") # pan 0.42 # hpf 240 # lpf 11000 # ddSend 0.14 # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.3 # ddWow 0 # ddCross 1 # verbSend 0.22
d10 $ every 11 (hurry 2) $ every 3 (|+ speed 1.4) $ struct "t(5,16)" lpvPerc # gain ("0.5 0 0 0 0 0.42 0 0 0 0 0 0.46 0 0 0 0" * slow 8 "<0 0 0 0 1 1 1 1>") # hpf 700 # lpf 16000 # cut 8 # pan "<0.3 0.7 0.5 0.65>" # ddSend 0.06 # delaySend 1 # lock 1 # delaytime (7/16) # delayfeedback 0.24 # ddWow 0 # ddCross 1 # verbSend 0.12
d11 $ off 0.25 (|* gain 0.4) $ air103 # s "sosBell" # amp 0.42 # rel 2.4 # gain ("0.42 0 0 0 0.34 0 0 0 0.38 0 0 0 0.3 0 0 0" * slow 8 "<0 0 0 0 0 0 1 1>") # pan 0.7 # hpf 620 # lpf 11000 # ddSend 0.2 # delaySend 1 # lock 1 # delaytime (5/16) # delayfeedback 0.34 # ddWow 0 # ddCross 1 # verbSend 0.3
d12 $ silence
