-- 185 — ROLLING RAVE. 84 BPM, A minor. Live state saved. Stock Tidal (orbit delay/room only).
-- A/B/C form: d1 Blue Monday bass (bars 1-4), d2 mandolin lead (5-8), d3 da Day Dawn air (9-12),
-- plus d4 a superfm pad under all of it. Floor: hard tech-house (kick 4/4 + clap 2&4 + offbeat
-- open hats), rolling 16th hats + 16th shaker, offbeat sub pulse, conga hook, and two sewn
-- 300-breaks lanes at loopAt 4. Everything shares one swing.
setcps (84/240)
let swing = (# nudge (fast 8 $ "0 1" * (slow 8 $ range 0 0.05 sine)))

d1 $ mask "<t t t t f f f f f f f f>" $ slow 4 $ sometimesBy 0.2 (fast 2) $ note "f3 ~ f4 f4 f3 ~ f4 f4 c3 ~ c4 c4 c3 ~ c4 c4 d3 ~ d4 d4 d3 ~ d4 d4 d3 ~ d4 d4 d3 ~ d4 d4 g3 ~ g4 g4 g3 ~ g4 g4 c3 ~ c4 c4 c3 ~ c4 c4 d3 ~ d4 d4 d3 ~ d4 d4 d3 ~ d4 d4 d3 ~ d4 d4" # s "dubsynth" # gain (slow 11 $ range 0.5 0.62 sine) # amp 0.8 # waveMix 0.16 # subMix 0.4 # cutoff (slow 13 $ rangex 600 1400 saw) # fenv 1.8 # drive (slow 15 $ range 0.15 0.4 saw) # sustain 0.3 # release 0.4 # legato 1.2 # hpf 40 # dry 1

d2 $ mask "<f f f f t t t t f f f f>" $ slow 8 $ sometimesBy 0.3 (chop 4) $ sometimesBy 0.3 (# shape (slow 13 $ range 0.15 0.5 saw)) $ sometimesBy 0.25 (# crush (slow 17 $ range 4 12 saw)) $ sometimesBy 0.2 (# vowel "<a e o u>") $ sometimesBy 0.2 (stutWith 3 0.0625 (|* gain 0.6)) $ (|+ note 12) $ note "f4 ~ f4 ~ f4 ~ g4 ~ c4 ~ c4 ~ c4 ~ d4 ~ d4 ~ ~ ~ d4 ~ d4 ~ ~ ~ d4 ~ d4 ~ ~ ~ f4 ~ f4 ~ f4 ~ g4 ~ c4 ~ c4 ~ c4 ~ d4 ~ d4 ~ ~ ~ d4 ~ d4 ~ ~ ~ d4 ~ d4 ~ ~ ~" # s "supermandolin" # gain (slow 7 $ range 0.4 0.5 sine) # hpf 600 # lpf (slow 17 $ rangex 2000 6500 saw) # res (slow 11 $ range 0.2 0.7 saw) # detune (slow 19 $ range 0.005 0.03 saw) # release 0.35 # sustain 0.15 # pan (slow 9 $ range 0.38 0.62 sine) # room 0.5 # size 0.8 # dry 0.5 # delay 0.4 # delaytime (3/16) # delayfeedback 0.5 # lock 1

d3 $ mask "<f f f f f f f f t t t t>" $ slow 4 $ degradeBy 0.08 $ sometimesBy 0.2 (|+ note 12) $ sometimesBy 0.15 (off 0.125 (|+ note 7)) $ sometimesBy 0.15 (# crush 6) $ note "b4 c5 b4 c5 b4 a4 a4 g4 d5 a4 d5 b4 e5 a4 d5 b4 c5 d5 b4 ~ a4 ~ d4 e4 b4 a4 d5 c5 e5 ~ a4 ~ e5 ~ b4 ~ a4 ~ e5 ~ e5 ~ a4 ~ e5 ~ b4 a4 a4 ~ d4 e4 b4 a4 d5 c5 e5 ~" # s "hoRhodes" # gain (slow 9 $ range 0.36 0.48 sine) # amp 0.5 # cutoff (slow 21 $ rangex 1000 3800 saw) # waveMix 0.16 # attack 0.05 # sustain 0.45 # release 1.4 # legato 1.3 # vib 0.12 # vibRate 5.2 # hpf 300 # pan (slow 7 $ range 0.42 0.58 sine) # room 0.75 # size 0.95 # dry 0.35 # delay 0.4 # delaytime (3/8) # delayfeedback 0.52 # lock 1

d4 $ slow 2 $ sometimesBy 0.15 (|+ note 12) $ note "<[a3,c4,e4,g4,b4] [f3,a3,c4,e4,g4] [c3,e3,g3,b3] [g3,b3,d4,f4]>" # s "superfm" # gain (slow 9 $ range 0.24 0.34 sine) # amp 0.4 # attack 0.6 # release 2.5 # sustain 0.7 # cutoff (slow 17 $ rangex 1200 3800 saw) # hpf 180 # lpf 7000 # pan 0.5 # room 0.8 # size 0.95 # dry 0.3

d5 $ sometimesBy 0.25 (fast 2) $ struct "t(4,4)" $ swing $ s "superkick" # gain 0.72 # shape (slow 11 $ range 0.3 0.55 saw) # release 0.22 # hpf 46

d6 $ sometimesBy 0.2 (fast 2) $ struct "f t f t" $ swing $ s "superclap" # gain 0.5 # hpf 400 # res (slow 9 $ range 0.3 0.7 saw) # release 0.12 # room 0.25 # size 0.6 # dry 0.8 # pan 0.5

d7 $ struct "~ t ~ t ~ t ~ t" $ swing $ s "superhat" # gain (slow 9 $ range 0.18 0.26 sine) # hpf 4000 # lpf (slow 5 $ rangex 7000 14000 saw) # res (slow 7 $ range 0.3 0.7 saw) # release 0.14 # pan 0.6 # dry 0.9

d10 $ struct "t(16,16)" $ swing $ s "superhat" # gain "0.16 0.09 0.12 0.09 0.14 0.09 0.11 0.09 0.16 0.09 0.12 0.09 0.14 0.09 0.11 0.09" # hpf 7000 # lpf 13000 # release 0.03 # pan 0.58 # dry 0.9

d11 $ sometimesBy 0.2 (fast 2) $ every 7 (rotR (1/16)) $ struct "t(16,16)" $ swing $ s "sh808" # gain (slow 6 $ range 0.07 0.12 sine) # hpf 6000 # lpf 14000 # pan perlin # release 0.02 # dry 0.95

d12 $ sometimesBy 0.3 (fast 2) $ struct "~ t ~ t ~ t ~ t" $ swing $ note "<a1 a1 a1 c2>" # s "dubsub" # gain 0.46 # amp 0.8 # drive 0.1 # legato 0.8 # sustain 0.18 # release 0.12 # hpf 32 # lpf 480 # dry 1

d13 $ sometimesBy 0.25 (fast 2) $ every 5 (rotR (1/16)) $ struct "t(5,16,3)" $ s "cn808" # gain (slow 7 $ range 0.2 0.3 sine) # hpf 300 # lpf 7000 # pan (slow 9 $ range 0.4 0.6 sine) # release 0.08 # room 0.2 # dry 0.85

d8 $ sometimesBy 0.2 (striate 4) $ loopAt 4 $ s "{pbrk01 pbrk02 pbrk03 pbrk04}%16" # gain (slow 7 $ range 0.62 0.74 sine) # hpf 60 # lpf (slow 11 $ rangex 1600 6000 saw) # pan 0.5 # release 0.08 # room 0 # dry 1

d9 $ sometimesBy 0.2 (chunk 4 rev) $ loopAt 4 $ s "{pbrk05 pbrk06 pbrk07 pbrk08}%16" # gain (slow 9 $ range 0.5 0.6 sine) # hpf 70 # lpf 5500 # pan 0.55 # release 0.08 # room 0 # dry 1
