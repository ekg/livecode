-- title: 190 new breaks deep
-- E minor, 124 BPM. Breaks + mars kicks + hats + claps + sub bass + chords.
-- MIXING STANDARD: master 2.

setcps (124/240)

d1 $ degradeBy 0.04 $ swingBy 0.06 4 $ sometimesBy 0.15 (fast 1.5) $ slice 16 "<0 4 9 2 13 6 11 1 8 14 3 10 5 15 7 12>" $ loopAt 1 $ s "<pbrk300:0 pbrk300:1 pbrk300:2 pbrk300:3>" # orbit 0 # gain 1.15 # hpf 35 # lpf 16000 # dry 0.92 # room 0.1

d2 $ degradeBy 0.06 $ sometimesBy 0.12 (fast 1.5) $ every 5 (chunk 8 rev) $ slice 8 "<0 3 6 1 5 2 7 4>" $ loopAt 2 $ s "pbrk300:4" # speed 0.55 # orbit 0 # gain 0.68 # hpf 45 # lpf 14000 # pan 0.58 # dry 0.92 # room 0.1

d4 $ s "mars_kits_505_SP_Thud(4,16,0)" # orbit 7 # gain 1.25 # hpf 35 # lpf 6000 # dry 1

d5 $ degradeBy 0.08 $ swingBy 0.08 4 $ sometimesBy 0.2 (stutWith 3 0.03125 (|* speed 0.9)) $ sometimesBy 0.15 (fast 2) $ every 5 (rotR (1/8)) $ every 7 (chunk 3 (|* speed 1.2)) $ stack [s "hh(7,16,2)" # gain 0.62, s "mars_kits_505_Clean:3(5,16,2)" # gain 0.32 # shape 0.12] # orbit 7 # hpf 4000 # lpf 14000 # pan (slow 13 $ range 0.2 0.8 sine) # crush (slow 19 $ range 16 11 saw) # dry 0.95 # room 0.12 # delay 0.15 # delaytime (3/16) # delayfeedback 0.35 # lock 1

d6 $ degradeBy 0.08 $ swingBy 0.06 4 $ s "<rolandtr909:4 rolandtr909:5 mars_kits_505_Clean:4 mars_kits_606_Tite:1>" # orbit 7 # gain 1.15 # hpf 350 # lpf 7000 # pan (slow 13 $ range 0.3 0.7 sine)  # room (slow 17 $ range 0.08 0.2 sine) # dry 0.95 # release 0.12

d7 $ note "<e2 ~ e2 g2 ~ a2 ~ g2> <c2 ~ c2 e2 ~ g2 ~ e2> <g1 ~ g1 b1 ~ d2 ~ b1> <d2 ~ d2 fs2 ~ a2 ~ d2>" # s "dubsub" # orbit 1 # gain 1.1 # drive 0.0 # waveMix 0.0 # subMix 0.32 # cutoff 900 # hpf 35 # dry 0.95

d8 $ slow 2 $ note "<[e3,g3,b3,d4] [c3,e3,g3,b3] [g3,b3,d4,fs4] [d3,fs3,a3,c4]>" # s "hoRhodes" # orbit 2 # gain 1.05 # attack 0.5 # release 2.0 # sustain 0.65 # cutoff 7000 # hpf 100 # room 0.45 # size 0.88 # dry 0.7

-- HAT LAYERS: driving feel - fast feel via multiple pulsating hat grids.
d9 $ degradeBy 0.1 $ swingBy 0.06 4 $ s "hh(11,16,3)" # orbit 7 # gain 0.38 # hpf 6000 # lpf 13000 # pan (slow 11 $ range 0.25 0.75 sine) # dry 0.95 # room 0.1

d10 $ degradeBy 0.08 $ swingBy 0.06 4 $ s "mars_kits_606_Tite:2(9,16,2)" # orbit 7 # gain 0.32 # hpf 2000 # lpf 8000 # pan (slow 15 $ range 0.3 0.7 sine) # crush (slow 23 $ range 16 10 saw) # dry 0.9

d11 $ sometimesBy 0.3 (|* speed 1.5) $ every 3 (chunk 3 (|* speed 1.5)) $ slice 12 "<0 5 9 2 7 11 3 8 1 10 4 6>" $ loopAt 1 $ s "pbrk300:8" # orbit 0 # gain 0.28 # hpf 150 # lpf 7000 # pan (slow 17 $ range 0.3 0.7 sine) # dry 0.85 # room 0.15

d12 $ slow 2 $ slice 16 "<2 6 10 0 4 8 12 14>" $ loopAt 1 $ s "lpmr" # speed 1 # orbit 4 # gain 0.18 # hpf 200 # lpf 9000 # pan 0.6 # dry 0.8 # room 0.2
