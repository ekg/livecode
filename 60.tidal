-- 60.tidal — lo-fi hiphop: `up` for sample pitch, short legato, kit up, pads down
-- 80 bpm, 1 cycle = 1 bar. For SAMPLES: up = semitones (canonical), n = which file.
-- gain^4 applies to samples, so percussive voices need higher numbers than sustained ones.

setcps (80/60/4)

-- kit: gain^4 means these need real numbers (hh 0.7 = 0.24 amp)
d1 $ s "bd ~ ~ bd ~ ~ bd ~ ~ ~ bd ~ ~ ~ ~ ~" # gain 0.8
d2 $ s "~ ~ ~ ~ sn ~ ~ ~ ~ ~ ~ ~ sn ~ ~ ~ ~" # gain 0.7
d3 $ sometimesBy 0.3 (stut 4 0.4 (1/32)) $ s "hh(5,8)" # gain 0.55 # hpf 900
d4 $ s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ cp ~" # gain 0.6 # room 0.3

-- bass: up = semitones from the sample's own pitch; cut keeps hits discrete
d5 $ s "moog" # up "0 ~ ~ ~ -2 ~ ~ -5 ~ ~ -3 ~ ~ 0 ~ ~" # amp 0.42 # legato 0.35 # cut 5 # lpf 600

-- chords: simultaneous offsets with up, short, cut so they breathe
d6 $ slow 2 $ s "jrhodes" # up "[0,3,7,10] [-2,2,5,9] [-4,0,3,7] [-5,-1,2,6]" # amp 0.22 # legato 0.4 # cut 6 # room 0.5 # size 0.85 # delay 0.25 # delaytime (3/8) # delayfeedback 0.4

-- melody: stepped, so you can hear it move
d7 $ s "sprvibe" # up "0 ~ 3 ~ 7 ~ 10 ~ 7 ~ 3 ~ 0 ~ -5 ~" # amp 0.3 # legato 0.3 # cut 7 # room 0.4 # delay 0.3 # delaytime (3/8) # delayfeedback 0.45

d8 $ s "noise" # gain 0.07 # lpf 3200 # hpf 300
