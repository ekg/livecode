-- 140: NIGHT WINDOW — DRY/OPEN PATCH MIX. 118 BPM.
-- After 139's over-wet group routing sounded underwater, retained its
-- intentional source gains but cut group delay/verb/shimmer sends hard.
-- 137's inharmonic pulse Rhodes was too harsh; this uses a sine-based,
-- bounded adaptation of Nathan Ho's SCLOrk FMRhodes1 (sc/horhodes.scd).
-- Replaces the offending p80a D-major sample (and its companion pitched
-- decks) with 16-bar F#m-D-A-E bass movement + four-bar Rhodes chord spans.
-- Requires sc/horhodes.scd, loaded at boot via sc/init.scd.
-- Sources: h2o808 kit, dubsub, hoRhodes, humanip vxA/B/D fragments,
-- p70perc + p85drumA percussion decks. The pitched LPViz loops are GONE.
-- Drum anchor with independent 5/9/11/13-cycle peripheral variations.
-- Vocal is chopped into vowels/feelings, not understandable words.
-- Harmony: Tune Pile chords/progressions.txt vi-IV-I-V [a] (F#m/D/A/E),
-- recast as four-bar hoRhodes voicings over a 16-bar moving bass phrase.
-- Mix recall: after SC boot, execute sc/house140-master.scd in sclang.
-- Per-stream gain/amp is deliberate; master UNITY, light compression,
-- limiter is safety only. m* Tidal bridge inert.
-- Verification after applying preset: hardware-bus RMS 0.122, envelope peak
-- 0.388 over 10s; master peak 0.576 vs ceiling 0.79 (no clip).
setcps (118/240)

d1 $ s "k808S*4" # gain "1.9 1.75 1.82 1.78" # hpf 32 # lpf 5800 # pan 0.5 # ddSend 0 # verbSend 0.025

d2 $ s "~ c808 ~ c808" # gain "1.15 1.35" # hpf 650 # lpf 8900 # pan 0.53 # ddSend "0 0.13 0 0" # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.22 # verbSend 0.06

d3 $ sometimesBy 0.16 (fast 2) $ s "~ h808C ~ h808C ~ h808C ~ h808C" # gain "0.8 0.63 0.72 0.57" # hpf 2600 # lpf 10500 # pan 0.6 # ddSend 0 # verbSend 0.03

d4 $ every 9 (iter 3) $ every 5 (fast 2) $ s "sh808(7,16)" # gain (perlin * 0.26 + 0.47) # hpf 1900 # lpf 7800 # pan (perlin * 0.3 + 0.38) # ddSend 0 # verbSend 0.04

d5 $ sometimesBy 0.1 (fast 2) $ n "<[fs2 ~ ~ cs3 ~ e2 ~ cs3] [fs2 ~ a2 ~ cs3 ~ e2 ~] [fs2 ~ ~ cs3 ~ fs2 ~ e2] [fs2 ~ e2 ~ cs2 ~ b1 ~] [d2 ~ ~ a2 ~ fs2 ~ a2] [d2 ~ fs2 ~ a2 ~ cs3 ~] [d2 ~ ~ a2 ~ d2 ~ cs2] [d2 ~ a1 ~ cs2 ~ e2 ~] [a1 ~ ~ e2 ~ cs2 ~ e2] [a1 ~ cs2 ~ e2 ~ gs2 ~] [a1 ~ ~ e2 ~ a1 ~ gs1] [a1 ~ gs1 ~ e2 ~ cs2 ~] [e2 ~ ~ b1 ~ gs1 ~ b1] [e2 ~ gs1 ~ b1 ~ ds2 ~] [e2 ~ ~ b1 ~ e2 ~ ds2] [e2 ~ b1 ~ cs2 ~ ds2 ~]>" # s "dubsub" # amp 0.68 # drive 0.18 # pitchEnv 0.12 # gain 0.78 # hpf 32 # lpf 2700 # pan 0.5 # ddSend 0 # verbSend 0.03

d6 $ off 2 (|* gain 0.55) $ slow 4 $ n "<[a3,cs4,e4,gs4] [a3,cs4,d4,fs4] [gs3,b3,cs4,e4] [gs3,b3,d4,fs4]>" # s "hoRhodes" # amp 0.64 # waveMix (slow 11 $ range 0.06 0.17 sine) # cutoff (slow 17 $ range 1800 3900 sine) # attack 0.018 # release 0.62 # gain 0.8 # hpf 195 # lpf 9000 # pan (slow 19 $ range 0.36 0.62 sine) # ddSend "0 0.1 0 0" # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.21 # verbSend 0.14

d7 $ silence

d8 $ silence

d9 $ silence

d10 $ every 7 (rev) $ slice 8 "<0 2 4 6 1 3 5 7> <2 0 6 4 3 1 7 5>" $ loopAt 1 $ s "<vxA vxB vxD>" # speed "<0.84 1 1.12 0.94>" # gain ("0.9 0 0 0 0.7 0 0 0" * "<1 0 0.6 0 0.8 0 0 0.4 0>") # hpf 420 # lpf 6200 # pan "<0.4 0.62 0.53>" # cut 10 # ddSend "0 0 0 0.24 0 0 0 0" # delaySend 1 # lock 1 # delaytime (3/16) # delayfeedback 0.28 # verbSend 0.18

d11 $ every 11 (iter 3) $ loopAt 1 $ s "p70perc" # gain "<0.7 0 0.84 0.62 0 0.75 0 0.7 0 0.62 0>" # hpf 930 # lpf 6800 # pan 0.42 # ddSend 0 # verbSend 0.07

d12 $ every 13 (rev) $ slice 4 "<0 1 2 3> <2 0 3 1>" $ loopAt 1 $ s "p85drumA" # gain "<0 0 0.58 0 0.74 0 0.6 0 0 0.66 0 0.58 0>" # hpf 450 # lpf 5200 # pan 0.6 # ddSend 0 # verbSend 0.05
