-- 182 — RAVE ANCHOR. 175 BPM. The algorave track as it stands, saved off the live REPL.
--
-- STOCK TIDAL: orbits -> hardware through the minimal master (hpf -> gain -> soft knee ->
-- limiter); orbit FX = SuperCollider's own dirt_delay -> dirt_reverb -> dirt_monitor. LEVELS:
-- ~masterVol.value(n) is the one volume knob.
--
-- THE RAVE VOICES are the ones in the SuperDirt voice list that had never been used in this
-- session: superkick, superclap, superhat, supernoise, superhoover, supersaw. The hoover is the
-- bass; the saw is the stab; that pairing is what makes it read as rave rather than techno.
--
-- ANCHORING (four interleaved lines, no gaps, one swing):
--     kick  ● ● ● ●      superkick for the CLICK and k808L for the BOOM, split by frequency
--                        (the k808S layer was removed: three kicks on one grid buried the boom)
--     bass  ─●─●─●─●      every offbeat — the house anchor: kick owns the downs, bass the ups
--     hat   ─●─●─●─●      offbeats, crisp (release 0.05) so it pushes rather than washes
--     clap  ──●───●─      beats 2 and 4
--
-- MODULATED FX (the point): every FX parameter carries its OWN LFO on its OWN coprime period, so
-- the timbre is always mid-morph somewhere and nothing peaks together — shape 11, pitchEnv 13,
-- res 7/9/11, lpf 5, crush 15 (kick), cutoff 7/9/4, trem 3/5, tremRate 17/19, detune 21, drive 15.
-- No reverb and no delay are used anywhere in this file: reverb and delay on every lane is the
-- boring default, and these are the alternatives — tremolo, formant vowel, resonant filter
-- sweeps and pitch envelopes.
--
-- RHYTHM comes from EUCLID and BINARY figures: t(4,4) / t(5,16,3) / t(7,16,3) / t(13,16,5) /
-- t(16,16) and written-out slots, with `every N (rotR ...)` rotations so the figures walk.
-- NB an euclid group spans the CYCLE, so `t(5,8) t t f` is not a euclid plus extra hits — write
-- either the euclid or the slots, never both in one string.
--
-- THE MELODIC BASS: `slow 2` over an offbeat figure, so its four hits take two bars, carrying an
-- eight-note contour — a1 c2 e2 a2 | g2 e2 d2 c2 (A-minor arpeggio up, stepwise descent back to
-- the root). legato 1.6 / sustain 0.45 / release 0.6 so the notes overlap into each other: that
-- is the breathing.
--
-- ALONGSIDE THIS: lanes d9-d13 of 181-hyper-drums.tidal (the {}%16 mashup, jungle one-shots, the
-- DMX kit, the tom melody and the 13-grid door) were never silenced when this section took over,
-- so they are still playing underneath at 175 BPM. Evaluate them from 181, or silence them.
--
-- TRAPS (five, all hit for real today; four of the five were SILENT failures rather than noise):
--   1. `(# a # b)` is not a section (# is infixl 9) — a multi-parameter transform needs a
--      composition of single-# sections: `let blast = (# room 0.92) . (# size 1)`.
--   2. transforms go BEFORE the `#` chain: `degradeBy 0.1 $ ... # gain x`, never `# degradeBy 0.1`.
--   3. a mini-notation string used as a number needs an annotation; for `n` on a sample it is
--      `:: Pattern Note`, not `:: Pattern Int`.
--   4. an euclid suffix on a |-alternation belongs on `s`, not on `struct` (struct wants Bool).
--   5. braces need a step count: `{a b}%16` parses, `{a}` does not.
setcps (175/60/4)

let swing = (# nudge (fast 8 $ "0 1" * (slow 8 $ range 0 0.06 sine)))

d1 $ struct "t(4,4)" $ swing $ s "superkick" # gain 0.62 # shape (slow 11 $ range 0.3 0.6 saw) # pitchEnv (slow 13 $ range 0.08 0.25 sine) # release 0.16 # hpf 50

d2 $ struct "~ t ~ t ~ t ~ t" $ swing $ s "superhat" # gain 0.3 # res (slow 7 $ range 0.3 0.7 saw) # lpf (slow 5 $ rangex 6000 14000 saw) # release 0.05 # pan 0.5

d3 $ sometimesBy 0.25 (# vowel "<a e i o u>") $ every 7 (rotR (1/8)) $ slice 16 "<0 4 9 2 13 6 11 1 8 14 3 10 5 15 7 12>" $ loopAt 1 $ s "amencutup" # gain 0.52 # res (slow 9 $ range 0.3 0.7 saw) # cutoff (slow 7 $ rangex 900 9000 saw) # release 0.06 # hpf 90

d4 $ struct "t(16,16)" $ s "supernoise" # gain (slow 5 $ range 0.05 0.12 sine) # trem (slow 3 $ range 0.3 1 sine) # tremRate (slow 17 $ range 4 12 saw) # vowel "<a e o>" # hpf 3000 # lpf 12000 # pan perlin # release 0.04

d5 $ slow 2 $ struct "~ t ~ t ~ t ~ t" $ swing $ note "<a1 c2 e2 a2 g2 e2 d2 c2>" # s "superhoover" # gain 0.52 # amp 0.8 # legato 1.6 # sustain 0.45 # release 0.6 # cutoff (slow 9 $ rangex 600 2600 saw) # res (slow 11 $ range 0.2 0.6 saw) # drive (slow 15 $ range 0.15 0.45 saw) # trem (slow 5 $ range 0.5 1 sine) # hpf 40 # dry 1

d6 $ sometimesBy 0.2 (fast 2) $ every 5 (rotR (1/8)) $ struct "t(7,16,3)" $ swing $ note "<[a3,c4,e4] [a3,c4,e4] [g3,b3,d4] [f3,a3,c4]>" # s "supersaw" # gain 0.4 # amp 0.4 # legato 1.1 # sustain 0.18 # release 0.35 # cutoff (slow 4 $ rangex 800 5200 saw) # res (slow 7 $ range 0.2 0.7 saw) # shape (slow 13 $ range 0.15 0.4 saw) # detune (slow 21 $ range 0.005 0.025 saw) # attack 0.004 # pan 0.5 # dry 0.9

d7 $ struct "f t f t" $ swing $ s "superclap" # gain 0.5 # hpf 400 # res (slow 9 $ range 0.3 0.7 saw) # release 0.12 # pan 0.5

-- THE BOOM: k808L on 4/4, speed 0.85 (down a step and a half, where an 808 gets its weight),
-- hpf 30 so the sub survives, lpf 600-1200 so it contributes ONLY the band the superkick does not
-- occupy, and release 0.55 — long enough to boom and ring past its own beat, short enough that at
-- four hits a bar it clears before the next transient.
d8 $ struct "t(4,4)" $ swing $ s "k808L" # gain 0.7 # hpf 30 # lpf (slow 13 $ range 600 1200 saw) # speed 0.85 # release 0.55 # pan 0.5
