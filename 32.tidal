-- punk rock crossover · from amapiano jam 31 via pianos-first bridge
--
-- bridge (executed live over 31.tidal, in order):
--   step 1: pianos come OUT — d5/d7 flat hot gains (0.9), filters open to 3500
--   step 2: 138 bpm, punk snare backbeat (d3), distorted gtr chugs (d4)
--   step 3: 156 bpm, d1 -> full punk beat (kick 1&3, snare 2&4), crash accents
--   step 4: 170 bpm full send, everything hotter
--
-- state below = step 4 full send (take history in git)

setcps (170/60/4)

-- amapiano kick still rolling underneath (crossfade in progress)
d1 $ s "bd*4" # gain 1.2

-- punk snare backbeat, 2 & 4
d3 $ s "~ sn ~ sn" # gain 1.2 # speed 1.15

-- distorted guitar chugs, straight 8ths
d4 $ s "gtr*8" # n (irand 7) # gain 1.25 # distort 0.7 # lpf 8000 # sustain 0.15 # release 0.08

-- pianos silenced at user request (bring back for the breakdown):
-- d5 $ n "<a3'min9 f3'maj9 c4'maj9 g3'9>" # s "superpiano" # gain 0.9 # room 0.7 # sz 0.8 # lpf 3500
-- d7 $ arp "up" $ s "superpiano" # n "<a4'min9 f4'maj9 c5'maj9 g4'9>" # gain 0.9 # room 0.5 # lpf 3500
d5 $ silence
d7 $ silence

-- amapiano glue kept: shakers, log drum (root-tracking), airy hats
d8 $ s "psr*8" # n (irand 30) # gain "0.45 0.6"
d9 $ s "tumba [~ tumba] ~ tumba [~ tumba] ~ tumba ~" # n "0 0 3 0 2 0" # speed (0.85 * "<1 0.79 1.19 0.89>") # cut 3 # gain 1.15
d10 $ s "~ oh ~ oh" # gain 0.7 # room 0.3

-- rhodes dub keys still echoing
d11 $ s "jrhodes ~ ~ ~ ~ ~ jrhodes ~" # n "<0 4 2 7>" # delay 0.5 # delaytime 0.25 # delayfeedback 0.75 # gain 0.65 # room 0.4 # lpf 2000

-- crash accents, once per 4 bars
d12 $ s "808cy/4" # gain 0.9 # speed 1.1

-- silenced
d2 $ silence
d6 $ silence
