d16 $ s "808bd:0*32" # orbit 5 # gain 0 # begin 0 # end 0.01 # sustain 0.001 # ddSend 0 # verbSend 0 # room 0 # lock 1 # delaytime "<0.1875 0.1875 0.1875 0.375 0.1875 0.125 0.1875 0.1875>" # delayfeedback "<0.5 0.5 0.5 0.6 0.5 0.45 0.5 0.6>" # ddWow 0.35 # ddLp (slow 8 $ range 1500 5000 saw) # ddHp (slow 8 $ range 200 900 sine) # ddDrive 0.35 # ddCross 0.6 # size 0.9 # verbT60 8 # verbTone 4000
